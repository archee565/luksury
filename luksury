def install_self(dry_run: bool = False) -> None:
    src = Path(sys.argv[0])
    try:
        src = src.resolve()
    except OSError:
        pass
    if not src.is_file():
        log.warning("Cannot determine the luksury script path; not installing to %s", INSTALLED_BIN)
        return
    if src == INSTALLED_BIN:
        return
    data = src.read_bytes()
    if not dry_run and INSTALLED_BIN.exists() and sha256_file(INSTALLED_BIN) != hashlib.sha256(data).hexdigest():
        backup_file(INSTALLED_BIN, dry_run=dry_run)
    atomic_write(INSTALLED_BIN, data, 0o755, dry_run)
    if not dry_run:
        try:
            os.chown(INSTALLED_BIN, 0, 0)
        except OSError:
            pass
    log.info("%s %s", "Would install" if dry_run else "Installed", INSTALLED_BIN)


def make_dracut_hook(cfg: Config) -> str:
    uuid = shlex.quote(cfg.credential_uuid or cfg.boot_uuid)
    fstype = shlex.quote(cfg.credential_fstype or cfg.boot_fstype or "")
    fstype_opt = f" -t {fstype}" if fstype else ""

    return (
        "#!/bin/sh\n"
        "# Generated by luksury.  Make systemd-pcrlock's boot credential\n"
        "# available before systemd-cryptsetup unlocks the root volume.  This\n"
        "# runs as ExecStartPre= of systemd-cryptsetup@.service, so it must\n"
        "# either install the credential or exhaust its retry budget.\n"
        "set -u\n"
        "CRED_DIR=/run/credentials/@encrypted\n"
        "MNT=/run/luksury\n"
        f"UUID={uuid}\n"
        'say() { echo "luksury: $*" > /dev/kmsg 2>/dev/null || true; }\n'
        'if [ -d "$CRED_DIR" ]; then\n'
        '    for f in "$CRED_DIR"/pcrlock.*; do\n'
        '        [ -e "$f" ] && exit 0\n'
        "    done\n"
        "fi\n"
        'mkdir -p "$CRED_DIR" "$MNT"\n'
        'chmod 0700 "$CRED_DIR" 2>/dev/null || true\n'
        "trap 'umount \"$MNT\" 2>/dev/null || true' 0\n"
        "modprobe -a -q vfat ext4 >/dev/null 2>&1 || true\n"
        "i=0\n"
        'while [ "$i" -lt 10 ]; do\n'
        "    if mountpoint -q \"$MNT\" 2>/dev/null || \\\n"
        f'        mount{fstype_opt} -o ro UUID="$UUID" "$MNT" 2>/dev/null; then\n'
        "        copied=0\n"
        '        for f in "$MNT"/loader/credentials/pcrlock.*.cred; do\n'
        '            [ -f "$f" ] || continue\n'
        '            base=${f##*/}\n'
        '            name=${base%.cred}\n'
        '            tmp="$CRED_DIR/.$name.tmp"\n'
        '            if cp -f "$f" "$tmp" 2>/dev/null && mv -f "$tmp" "$CRED_DIR/$name"; then\n'
        "                copied=1\n"
        "            else\n"
        '                rm -f "$tmp" 2>/dev/null || true\n'
        "            fi\n"
        "        done\n"
        '        umount "$MNT" 2>/dev/null || true\n'
        '        if [ "$copied" -eq 1 ]; then\n'
        '            say "installed pcrlock credential from boot partition UUID=$UUID"\n'
        "            exit 0\n"
        "        fi\n"
        "    fi\n"
        "    i=$((i + 1))\n"
        "    sleep 1\n"
        "done\n"
        'umount "$MNT" 2>/dev/null || true\n'
        'say "pcrlock credential not found on boot partition UUID=$UUID; falling back to passphrase"\n'
        "exit 1\n"
    )


def install_dracut_module(cfg: Config, dry_run: bool = False) -> None:
    if not dracut_bin() and not DRACUT_MODULE_DIR.parent.exists():
        log.info("dracut not found; skipping its initramfs module")
        return
    if not (cfg.credential_uuid or cfg.boot_uuid):
        log.warning(
            "boot partition UUID is unknown; the initramfs will not be able to read "
            "systemd-pcrlock's boot credential"
        )

    module_setup = (
        "#!/bin/bash\n"
        "check() { return 0; }\n"
        "depends() { return 0; }\n"
        "install() {\n"
        "    inst_multiple mount umount mountpoint mkdir cp mv rm chmod sleep modprobe\n"
        "    instmods vfat ext4 nls_cp437 nls_iso8859-1\n"
        '    inst_simple "$moddir/luksury_pcrlock.sh" /usr/lib/luksury/luksury_pcrlock.sh\n'
        '    inst_simple "$moddir/luksury-cryptsetup.conf" /usr/lib/systemd/system/systemd-cryptsetup@.service.d/99-luksury.conf\n'
        "}\n"
    )
    hook = make_dracut_hook(cfg)
    # Run the policy fetch inside the cryptsetup unit itself.  A separate
    # ordered service can return success while the policy is still missing;
    # ExecStartPre= cannot race with the TPM unseal that follows it.
    dropin = (
        "[Service]\n"
        "ExecStartPre=-/usr/lib/luksury/luksury_pcrlock.sh\n"
    )

    # Preserve the old luksury module *before* overwriting it.
    old_retrieve = DRACUT_MODULE_DIR / "luksury_retrieve.sh"
    if old_retrieve.exists():
        stamp = _dt.datetime.now().strftime("%Y%m%d-%H%M%S")
        backup_dir = STATE_DIR / f"old-dracut-89luksury-{stamp}"
        if dry_run:
            log.info("[dry-run] would back up %s to %s", DRACUT_MODULE_DIR, backup_dir)
        else:
            try:
                shutil.copytree(DRACUT_MODULE_DIR, backup_dir)
                log.info("Backed up old dracut module to %s", backup_dir)
            except OSError as exc:
                log.warning("Could not back up old dracut module: %s", exc)

    atomic_write(DRACUT_MODULE_DIR / "module-setup.sh", module_setup, 0o755, dry_run)
    atomic_write(DRACUT_MODULE_DIR / "luksury_pcrlock.sh", hook, 0o755, dry_run)
    atomic_write(DRACUT_MODULE_DIR / "luksury-cryptsetup.conf", dropin, 0o644, dry_run)
    if old_retrieve.exists():
        remove_file(old_retrieve, dry_run)
    # Remove pieces installed by older versions; module-setup.sh no longer
    # installs them, but stale files in the module directory are confusing.
    for old_name in ("luksury_pcrlock_hook.sh", "luksury-pcrlock.service"):
        remove_file(DRACUT_MODULE_DIR / old_name, dry_run)

    dracut_conf = (
        "# Generated by luksury\n"
        'add_dracutmodules+=" luksury systemd-cryptsetup tpm2-tss "\n'
    )
    if DRACUT_CONF.exists():
        backup_file(DRACUT_CONF, dry_run)
    atomic_write(DRACUT_CONF, dracut_conf, 0o644, dry_run)

    old_conf = Path("/usr/lib/dracut/dracut.conf.d/80-luksury.conf")
    if old_conf.exists():
        backup_file(old_conf, dry_run)
        log.info("%s old luksury dracut configuration: %s", "Would remove" if dry_run else "Removing", old_conf)
        remove_file(old_conf, dry_run)

    log.info("%s dracut module in %s", "Would install" if dry_run else "Installed", DRACUT_MODULE_DIR)


def refresh_boot_update_dropin(dry_run: bool = False) -> None:
    """Make an existing boot-update drop-in propagate refresh failures."""
    try:
        content = BOOT_UPDATE_DROPIN.read_text(encoding="utf-8")
    except OSError:
        return
    if "ExecStartPost=-" not in content:
        return
    content = content.replace("ExecStartPost=-", "ExecStartPost=", 1)
    backup_file(BOOT_UPDATE_DROPIN, dry_run)
    atomic_write(BOOT_UPDATE_DROPIN, content, 0o644, dry_run)
    daemon_reload(dry_run)
    log.info("%s boot-update drop-in to fail on PCR 4 prediction errors", "Would update" if dry_run else "Updated")


def daemon_reload(dry_run: bool = False) -> None:
    if not Path("/run/systemd/system").is_dir():
        return
    run(["systemctl", "daemon-reload"], check=False, dry_run=dry_run)


def install_update_hooks(dry_run: bool = False) -> list[str]:
    installed: list[str] = []
    luksury = str(INSTALLED_BIN)

    kernel_install = kernel_install_bin()
    if kernel_install or Path("/etc/kernel/install.d").exists():
        content = (
            "#!/usr/bin/bash\n"
            "# Generated by luksury.  Refresh the pcrlock policy after a kernel/initrd build.\n"
            "set -euo pipefail\n"
            '[ "${1:-}" = add ] || exit 0\n'
            'version="${2:-}"\n'
            'staging="${KERNEL_INSTALL_STAGING_AREA:-}"\n'
            "initrd=\"\"\n"
            "for f in \"$staging/initrd\" \"$staging/initrd.img\" \"/boot/initrd.img-$version\"; do\n"
            "    if [ -f \"$f\" ]; then initrd=\"$f\"; break; fi\n"
            "done\n"
            "cmdline=\"\"\n"
            "for f in \"$staging/cmdline\" \"/etc/kernel/cmdline\"; do\n"
            "    if [ -f \"$f\" ]; then cmdline=\"$f\"; break; fi\n"
            "done\n"
            "extra=()\n"
            "if [ -n \"$cmdline\" ]; then extra+=(--cmdline \"$cmdline\"); fi\n"
            "if [ -n \"$version\" ]; then\n"
            "    if [ -n \"$initrd\" ]; then\n"
            f"        {shlex.quote(luksury)} update --kernel \"$version\" --initrd \"$initrd\" \"${{extra[@]}}\" || true\n"
            "    else\n"
            f"        {shlex.quote(luksury)} update --kernel \"$version\" \"${{extra[@]}}\" || true\n"
            "    fi\n"
            "elif [ -n \"$initrd\" ]; then\n"
            f"    {shlex.quote(luksury)} update --initrd \"$initrd\" \"${{extra[@]}}\" || true\n"
            "else\n"
            "    exit 0\n"
            "fi\n"
        )
        backup_file(KERNEL_INSTALL_HOOK, dry_run)
        atomic_write(KERNEL_INSTALL_HOOK, content, 0o755, dry_run)
        installed.append(str(KERNEL_INSTALL_HOOK))

    if update_initramfs_bin() or Path("/etc/initramfs/post-update.d").exists():
        content = (
            "#!/bin/sh\n"
            "# Generated by luksury.\n"
            "if [ -n \"${1:-}\" ]; then\n"
            f"    {shlex.quote(luksury)} update --kernel \"$1\" || true\n"
            "else\n"
            f"    {shlex.quote(luksury)} update || true\n"
            "fi\n"
        )
        backup_file(INITRAMFS_HOOK, dry_run)
        atomic_write(INITRAMFS_HOOK, content, 0o755, dry_run)
        installed.append(str(INITRAMFS_HOOK))

    if Path("/etc/pacman.d").exists() or shutil.which("pacman"):
        content = (
            "[Trigger]\n"
            "Operation = Install\n"
            "Operation = Upgrade\n"
            "Type = Package\n"
            "Target = linux\n"
            "Target = linux-lts\n"
            "Target = linux-zen\n"
            "Target = linux-hardened\n"
            "Target = systemd\n"
            "Target = mkinitcpio\n"
            "\n"
            "[Action]\n"
            "Description = Refreshing luksury TPM pcrlock policy\n"
            "When = PostTransaction\n"
            f"Exec = {luksury} update\n"
        )
        backup_file(PACMAN_HOOK, dry_run)
        atomic_write(PACMAN_HOOK, content, 0o644, dry_run)
        installed.append(str(PACMAN_HOOK))

    # systemd-boot-update.service runs bootctl update early at boot, after root
    # is unlocked.  Re-lock the newly written boot loader immediately so PCR 4
    # still matches on the next boot.
    boot_update_unit = Path("/usr/lib/systemd/system/systemd-boot-update.service")
    if not boot_update_unit.exists():
        boot_update_unit = Path("/lib/systemd/system/systemd-boot-update.service")
    if boot_update_unit.exists():
        content = (
            "[Service]\n"
            f"ExecStartPost={luksury} refresh-bootloader\n"
        )
        backup_file(BOOT_UPDATE_DROPIN, dry_run)
        atomic_write(BOOT_UPDATE_DROPIN, content, 0o644, dry_run)
        installed.append(str(BOOT_UPDATE_DROPIN))
        daemon_reload(dry_run)

    if not installed:
        log.warning(
            "No update hook could be installed. After a kernel/initrd update run "
            f"`{PROG} update` manually."
        )
    else:
        log.info("%s update hooks: %s", "Would install" if dry_run else "Installed", ", ".join(installed))
    return installed


def regenerate_initramfs(
    image: Optional[Path] = None,
    version: Optional[str] = None,
    dry_run: bool = False,
) -> None:
    dracut = dracut_bin()
    if dracut:
        # Write to the exact image the bootloader loads.  On systemd-boot
        # systems this is often on the ESP, not /boot.
        if image is not None and Path(image).exists():
            run([dracut, "-f", str(image), version or os.uname().release], dry_run=dry_run)
        else:
            run([dracut, "-f"], dry_run=dry_run)
        return
    ui = update_initramfs_bin()
    if ui:
        run([ui, "-u", "-k", "all"], dry_run=dry_run)
        return
    mk = mkinitcpio_bin()
    if mk:
        run([mk, "-P"], dry_run=dry_run)
        return
    die("no supported initramfs generator found (dracut, update-initramfs, mkinitcpio)")


def verify_enrollment(dev: Path, dry_run: bool = False) -> bool:
    if dry_run:
        log.info("[dry-run] would verify TPM unlock with systemd-cryptsetup")
        return True
    if not luks_has_token(dev, "systemd-tpm2"):
        log.error("No systemd-tpm2 token was found in the LUKS2 header")
        return False
    name = "luksury-selftest"
    scs = cryptsetup_setup_bin()
    # Prefer the runtime path used by the initrd; fall back to /var when /run
    # is not writable.  The headless flag prevents a passphrase prompt, and
    # the explicit path makes sure this tests the policy we just built rather
    # than a stale file.
    policy = PCRLOCK_RUNTIME if PCRLOCK_RUNTIME.exists() else PCRLOCK_JSON
    options = (
        "tpm2-device=auto,"
        f"tpm2-pcrlock={policy},"
        "headless"
    )
    cp = run(
        [scs, "attach", name, str(dev), "none", options],
        capture=True,
        check=False,
        timeout=30,
        stdin_devnull=True,
    )
    if cp.returncode != 0:
        detail = (cp.stderr or cp.stdout).strip()
        if "already exists" in detail.lower() or "busy" in detail.lower():
            log.warning("TPM unlock self-test was inconclusive (device already active): %s", detail)
            return True
        log.error(
            "TPM unlock self-test failed (exit %s): %s",
            cp.returncode,
            detail or "no error output",
        )
        log.error(
            "The passphrase/recovery key still works. Run `systemd-cryptsetup attach` "
            "with SYSTEMD_LOG_LEVEL=debug for details, or check the LUKS2 token with "
            "`cryptsetup luksDump`."
        )
        return False
    run([scs, "detach", name], check=False, stdin_devnull=True)
    log.info("TPM unlock self-test succeeded")
    return True


