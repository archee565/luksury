    patched = False
    count = 0
    for line in lines:
        origline = line
        line = decomment(line)
        line = line.replace(b",keyscript=/bin/cat",b"");	        
        line = line.replace(b"keyscript=/bin/cat,",b"");	        
        line = line.replace(b"keyscript=/bin/cat",b"");	        
        cols = line.split(b' ')
	        
        if len(cols)>=4:
