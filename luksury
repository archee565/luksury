def pcrlock_supported() -> bool:
    binary = pcrlock_bin()
    if not binary:
        return False
    cp = run([binary, "is-supported"], capture=True, check=False)
    if cp.returncode != 0:
        log.info("systemd-pcrlock is not supported: %s", (cp.stdout or cp.stderr).strip())
        return False
    return cp.stdout.strip().lower() in ("yes", "true", "1")


def pcrlock_component_dir(component: str) -> Path:
    return PCRLOCK_COMPONENT_DIR / f"{component}.pcrlock.d"


_VARIANT_FILE_RE = re.compile(r"^(?:initrd|cmdline)-[0-9a-f]{16}\.pcrlock$")


def _write_pcrlock_variant(component: str, source: Path, dry_run: bool) -> Path:
    """Generate one pcrlock component variant and install it atomically."""
    binary = pcrlock_bin()
    if not binary:
        die("systemd-pcrlock was not found (install systemd >= 256)")

    prefix = "initrd" if component == PCRLOCK_INITRD_COMPONENT else "cmdline"
    verb = "lock-kernel-initrd" if prefix == "initrd" else "lock-kernel-cmdline"
    if not source.exists():
        die(f"{prefix} input not found: {source}")

    if prefix == "initrd":
        digest = sha256_file(source)
    else:
        text = source.read_text(encoding="utf-8", errors="replace").rstrip("\n")
        digest = hashlib.sha256(text.encode()).hexdigest()

    dest = pcrlock_component_dir(component) / f"{prefix}-{digest[:16]}.pcrlock"
    if dry_run:
        log.info("[dry-run] would write pcrlock %s variant %s from %s", prefix, dest, source)
        return dest
    if dest.exists():
        return dest

    d = dest.parent
    d.mkdir(parents=True, exist_ok=True)
    fd, tmpname = tempfile.mkstemp(prefix=f".{dest.name}.", dir=str(d))
    os.close(fd)
    tmp = Path(tmpname)
    try:
        run([binary, verb, f"--pcrlock={tmp}", str(source)])
        os.chmod(tmp, 0o644)
        os.replace(tmp, dest)
        os.sync()
    finally:
        tmp.unlink(missing_ok=True)

    log.info("Wrote pcrlock %s variant %s", prefix, dest)
    return dest


_BOOTLOADER_VARIANT_RE = re.compile(r"^pe-[0-9a-f]{16}\.pcrlock$")


def _efi_architecture() -> str:
    bc = bootctl_bin()
    if bc:
        cp = run([bc, "--print-efi-architecture"], capture=True, check=False)
        if cp.returncode == 0 and cp.stdout.strip():
            return cp.stdout.strip()
    return "x64"


def _current_efi_boot_pe(boot: BootPartition) -> Optional[Path]:
    """Best-effort path of the PE binary firmware loaded for this boot."""
    eb = efibootmgr_bin()
    if not eb:
        return None
    cp = run([eb, "-v"], capture=True, check=False)
    if cp.returncode != 0:
        return None

    current: Optional[str] = None
    entries: dict[str, str] = {}
    for line in cp.stdout.splitlines():
        match = re.match(r"^BootCurrent:\s*([0-9A-Fa-f]{4})", line)
        if match:
            current = match.group(1).upper()
            continue
        match = re.match(r"^Boot([0-9A-Fa-f]{4})\*?\s+(.*)$", line)
        if match:
            entries[match.group(1).upper()] = match.group(2)
    if not current or current not in entries:
        return None

    match = re.search(r"(/\\[^\s]+?\.efi)", entries[current], re.IGNORECASE)
    if not match:
        return None
    rel = match.group(1).replace("\\", "/").lstrip("/")
    candidate = boot.mount / rel
    return candidate if candidate.is_file() else None


def find_bootloader_pe_paths(cfg: Config) -> list[Path]:
    """Return the PE binaries whose measurements PCR 4 should cover."""
    boot = BootPartition(
        mount=Path(cfg.boot_mount),
        uuid=cfg.boot_uuid,
        fstype=cfg.boot_fstype,
        device=cfg.boot_device,
    )
    candidates: list[Path] = []

    bc = bootctl_bin()
    if bc:
        cp = run([bc, "--print-loader-path"], capture=True, check=False)
        if cp.returncode == 0 and cp.stdout.strip():
            candidates.append(Path(cp.stdout.strip()))

    current = _current_efi_boot_pe(boot)
    if current is not None:
        candidates.append(current)

    arch = _efi_architecture()
    for rel in (
        f"EFI/systemd/systemd-boot{arch}.efi",
        f"EFI/systemd/systemd-boot-fallback{arch}.efi",
        f"EFI/BOOT/BOOT{arch.upper()}.EFI",
    ):
        candidate = boot.mount / rel
        if candidate.is_file():
            candidates.append(candidate)

    for raw in cfg.bootloader_pes:
        candidate = Path(raw)
        if candidate.is_file():
            candidates.append(candidate)
        else:
            log.warning("configured boot loader PE not found: %s", candidate)

    result: list[Path] = []
    seen_hashes: set[str] = set()
    for candidate in candidates:
        try:
            resolved = candidate.resolve()
        except OSError:
            resolved = candidate
        if not resolved.is_file():
            continue
        try:
            digest = sha256_file(resolved)
        except OSError as exc:
            log.warning("cannot read boot loader PE %s: %s", resolved, exc)
            continue
        if digest in seen_hashes:
            continue
        seen_hashes.add(digest)
        result.append(resolved)

    if not result:
        log.warning(
            "no boot loader PE files found; PCR 4 will not be included in the policy"
        )
    return result


def pe_variant_path(pe: Path) -> Path:
    digest = sha256_file(pe)
    return pcrlock_component_dir(PCRLOCK_BOOTLOADER_COMPONENT) / f"pe-{digest[:16]}.pcrlock"


def _write_pe_variant(pe: Path, dry_run: bool) -> Path:
    """Generate one PCR 4 boot loader variant and install it atomically."""
    binary = pcrlock_bin()
    if not binary:
        die("systemd-pcrlock was not found (install systemd >= 256)")
    if not pe.is_file():
        die(f"boot loader PE not found: {pe}")

    dest = pe_variant_path(pe)
    if dry_run:
        log.info("[dry-run] would write pcrlock boot loader variant %s from %s", dest, pe)
        return dest
    if dest.exists():
        return dest

    d = dest.parent
    d.mkdir(parents=True, exist_ok=True)
    fd, tmpname = tempfile.mkstemp(prefix=f".{dest.name}.", dir=str(d))
    os.close(fd)
    tmp = Path(tmpname)
    try:
        run([binary, "lock-pe", "--pcr=4", f"--pcrlock={tmp}", str(pe)])
        os.chmod(tmp, 0o644)
        os.replace(tmp, dest)
        os.sync()
    finally:
        tmp.unlink(missing_ok=True)

    log.info("Wrote pcrlock boot loader variant %s", dest)
    return dest


def _pcrlock_digest_map(record: dict[str, Any]) -> dict[str, str]:
    """Return {hash algorithm: lower-case hex digest} for a CEL/.pcrlock record."""
    digests: dict[str, str] = {}
    for item in record.get("digests", []):
        if not isinstance(item, dict):
            continue
        alg = item.get("hashAlg")
        digest = item.get("digest")
        if isinstance(alg, str) and isinstance(digest, str):
            digests[alg.lower()] = digest.lower()
    return digests


def _pcrlock_record_list(path: Path) -> Optional[list[dict[str, Any]]]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    records = data.get("records")
    if not isinstance(records, list):
        return None
    return [r for r in records if isinstance(r, dict)]


def _pcrlock_cel_records(binary: str) -> Optional[list[dict[str, Any]]]:
    """Read the combined TPM event log as TCG CEL-JSON.

    `systemd-pcrlock cel` reads the firmware event log and the userspace log
    without requiring a valid component set, which is exactly what we need to
    build components for PCR 4.
    """
    cp = run([binary, "cel", "--json=short"], capture=True, check=False)
    if cp.returncode != 0:
        detail = (cp.stderr or cp.stdout or "").strip()
        log.warning("systemd-pcrlock cel failed: %s", detail or f"exit status {cp.returncode}")
        return None
    try:
        data = json.loads(cp.stdout)
    except ValueError as exc:
        log.warning("cannot parse systemd-pcrlock cel output: %s", exc)
        return None
    if not isinstance(data, list):
        log.warning("systemd-pcrlock cel did not return a JSON array")
        return None
    return [r for r in data if isinstance(r, dict)]


def _tpm_pcr_value(pcr: int, algorithm: str = "sha256") -> Optional[str]:
    for path in (
        Path(f"/sys/class/tpm/tpm0/pcr-{algorithm}/{pcr}"),
        Path(f"/sys/class/tpm/tpm0/pcr-{algorithm.upper()}/{pcr}"),
    ):
        try:
            value = path.read_text(encoding="ascii").strip().lower()
        except OSError:
            continue
        if re.fullmatch(r"[0-9a-f]+", value):
            return value
    return None


def _pcr4_extend(records: list[dict[str, Any]], algorithm: str = "sha256") -> Optional[str]:
    """Replay the PCR 4 records exactly as the TPM would, returning hex."""
    try:
        size = hashlib.new(algorithm).digest_size
    except ValueError:
        return None
    value = b"\0" * size
    for record in records:
        digest = _pcrlock_digest_map(record).get(algorithm)
        if digest is None:
            return None
        try:
            raw = bytes.fromhex(digest)
        except ValueError:
            return None
        if len(raw) != size:
            return None
        value = hashlib.new(algorithm, value + raw).digest()
    return value.hex()


def _pcr4_records(cel: list[dict[str, Any]]) -> list[dict[str, Any]]:
    return [record for record in cel if record.get("pcr") == 4]


def _pcr4_loader_indices(records: list[dict[str, Any]]) -> list[int]:
    """Indices of EV_EFI_BOOT_SERVICES_APPLICATION records in the PCR 4 list."""
    indices: list[int] = []
    for index, record in enumerate(records):
        if record.get("content_type") != "pcclient_std":
            continue
        content = record.get("content")
        if not isinstance(content, dict):
            continue
        event_type = content.get("event_type")
        if isinstance(event_type, str) and event_type.upper() == "EV_EFI_BOOT_SERVICES_APPLICATION":
            indices.append(index)
    return indices


def _bootloader_digest_variants() -> list[dict[str, str]]:
    """Distinct lock-pe digest maps from the installed 630-bootloader variants."""
    result: list[dict[str, str]] = []
    seen: set[tuple[tuple[str, str], ...]] = set()
    directory = pcrlock_component_dir(PCRLOCK_BOOTLOADER_COMPONENT)
    if not directory.is_dir():
        return result
    for path in sorted(directory.glob("*.pcrlock")):
        if not _BOOTLOADER_VARIANT_RE.fullmatch(path.name):
            continue
        records = _pcrlock_record_list(path)
        if not records:
            continue
        pcr4 = [record for record in records if record.get("pcr") == 4]
        if len(pcr4) != 1:
            continue
        digests = _pcrlock_digest_map(pcr4[0])
        if "sha256" not in digests:
            continue
        key = tuple(sorted(digests.items()))
        if key in seen:
            continue
        seen.add(key)
        result.append(digests)
    return result


def _slim_pcr4_records(records: list[dict[str, Any]]) -> list[dict[str, Any]]:
    """Keep only the fields that pcrlock component files actually use."""
    return [
        {
            "pcr": 4,
            "digests": [
                {"hashAlg": item["hashAlg"], "digest": item["digest"]}
                for item in record.get("digests", [])
                if isinstance(item, dict)
                and isinstance(item.get("hashAlg"), str)
                and isinstance(item.get("digest"), str)
            ],
        }
        for record in records
    ]


def _replace_pcr4_record(
    records: list[dict[str, Any]], index: Optional[int], digests: dict[str, str]
) -> list[dict[str, Any]]:
    copied = [
        {**record, "digests": [dict(item) for item in record.get("digests", []) if isinstance(item, dict)]}
        for record in records
    ]
    if index is not None:
        copied[index]["digests"] = [
            {"hashAlg": algorithm, "digest": digest}
            for algorithm, digest in sorted(digests.items())
        ]
    return copied


def _pcr4_variants(
    records: list[dict[str, Any]],
    bootloader_digests: Sequence[dict[str, str]],
) -> list[tuple[str, list[dict[str, Any]]]]:
    """Build the running-boot variant plus one variant per known boot loader.

    The firmware is responsible for measuring PCR 4.  We take the actual record
    sequence from the event log (validated against the TPM below) and only
    substitute the EV_EFI_BOOT_SERVICES_APPLICATION record when predicting a
    different boot loader PE.  This keeps firmware-specific extra records, which
    lock-pe cannot describe, intact.
    """
    slim = _slim_pcr4_records(records)
    variants: list[tuple[str, list[dict[str, Any]]]] = [("running", slim)]
    loader_indices = _pcr4_loader_indices(records)
    if len(loader_indices) != 1:
        if len(loader_indices) > 1:
            log.warning(
                "PCR 4 contains %d EV_EFI_BOOT_SERVICES_APPLICATION records; "
                "only the running boot can be predicted",
                len(loader_indices),
            )
        return variants

    index = loader_indices[0]
    for digests in bootloader_digests:
        name = f"pe-{digests['sha256'][:16]}"
        variants.append((name, _replace_pcr4_record(slim, index, digests)))
    return variants


def _filter_pcr4_records(records: list[dict[str, Any]]) -> list[dict[str, Any]]:
    return [record for record in records if record.get("pcr") != 4]


def _copy_prediction_components(dest_root: Path) -> None:
    """Copy all non-PCR4 components into the private component tree.

    Components that touch PCR 4 are replaced by the event-log-derived
    component.  Components that touch PCR 4 *and* other PCRs (for example the
    separator) are kept with their PCR 4 records removed.
    """
    for base in reversed(PCRLOCK_COMPONENT_SEARCH_DIRS):
        root = Path(base)
        if not root.is_dir():
            continue
        for source in sorted(root.rglob("*.pcrlock")):
            if not source.is_file():
                continue
            records = _pcrlock_record_list(source)
            if records is None:
                continue
            filtered = _filter_pcr4_records(records)
            if not filtered:
                continue
            destination = dest_root / source.relative_to(root)
            destination.parent.mkdir(parents=True, exist_ok=True)
            destination.write_text(
                json.dumps({"records": filtered}, separators=(",", ":")) + "\n",
                encoding="utf-8",
            )
            os.chmod(destination, 0o644)


def _install_prediction_components(staging: Path) -> Path:
    final = PCRLOCK_PRIVATE_COMPONENTS
    previous = STATE_DIR / "pcrlock.d.old"
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if previous.exists():
        shutil.rmtree(previous)
    if final.exists():
        os.replace(final, previous)
    try:
        os.replace(staging, final)
    except OSError:
        if previous.exists() and not final.exists():
            os.replace(previous, final)
        raise
    if previous.exists():
        shutil.rmtree(previous)
    os.chmod(final, 0o755)
    return final


def prepare_pcrlock_components(cfg: Config, dry_run: bool = False) -> Optional[Path]:
    """Build the private component set used to predict PCR 4.

    The PCR 4 prediction is derived from the current boot's validated event log
    rather than from `lock-pe` alone.  This is necessary because firmware often
    records extra measurements in PCR 4 (drivers, boot option actions, or a
    non-standard PE hash) that `lock-pe` does not describe.  The event log is
    checked against the live TPM value before it is trusted.
    """
    if 4 not in cfg.pcrs:
        return None
    if dry_run:
        log.info("[dry-run] would build PCR 4 prediction components from the TPM event log")
        return None

    binary = pcrlock_bin()
    if not binary:
        die("systemd-pcrlock was not found (install systemd >= 256)")

    cel = _pcrlock_cel_records(binary)
    if cel is None:
        die(
            "cannot read the TPM event log, so PCR 4 (boot loader) cannot be predicted. "
            "Refusing to update the policy. Check that /sys/kernel/security/tpm0/"
            "binary_bios_measurements is readable and see `systemd-pcrlock log`."
        )

    records = _pcr4_records(cel)
    if not records:
        die(
            "the TPM event log contains no PCR 4 measurements, so the boot loader "
            "cannot be bound. Refusing to update the policy."
        )

    calculated = _pcr4_extend(records)
    if calculated is None:
        die(
            "the PCR 4 event log contains a record without a usable SHA-256 digest; "
            "refusing to build a policy from an incomplete prediction"
        )
    current = _tpm_pcr_value(4)
    if current is None:
        log.warning("cannot read the current PCR 4 value from the TPM; relying on systemd-pcrlock validation")
    elif calculated != current:
        die(
            "the PCR 4 event log does not match the current TPM value "
            f"(event log {calculated}, TPM {current}); refusing to build a policy. "
            "See `systemd-pcrlock log`."
        )

    variants = _pcr4_variants(records, _bootloader_digest_variants())

    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        staging = Path(tempfile.mkdtemp(prefix=".pcrlock.d.", dir=str(STATE_DIR)))
    except OSError as exc:
        die(f"cannot create the PCR 4 prediction component directory: {exc}")

    try:
        _copy_prediction_components(staging)
        component_dir = staging / f"{PCRLOCK_PCR4_COMPONENT}.pcrlock.d"
        component_dir.mkdir(parents=True, exist_ok=True)
        seen: set[str] = set()
        written = 0
        for name, variant_records in variants:
            key = json.dumps(variant_records, sort_keys=True)
            if key in seen:
                continue
            seen.add(key)
            destination = component_dir / f"{name}.pcrlock"
            destination.write_text(
                json.dumps({"records": variant_records}, indent=2) + "\n",
                encoding="utf-8",
            )
            os.chmod(destination, 0o644)
            written += 1
        if written == 0:
            die("could not build any PCR 4 prediction variant")
        _install_prediction_components(staging)
    except OSError as exc:
        shutil.rmtree(staging, ignore_errors=True)
        die(f"cannot build the PCR 4 prediction components: {exc}")
    except BaseException:
        shutil.rmtree(staging, ignore_errors=True)
        raise

    log.info(
        "Prepared %d PCR 4 prediction variant(s) from the event log in %s",
        written,
        PCRLOCK_PRIVATE_COMPONENTS,
    )
    return PCRLOCK_PRIVATE_COMPONENTS


def pcrlock_components_args(cfg: Config, *, dry_run: bool = False) -> list[str]:
    if 4 not in cfg.pcrs:
        return []
    if not PCRLOCK_PRIVATE_COMPONENTS.is_dir():
        if dry_run:
            return [f"--components={PCRLOCK_PRIVATE_COMPONENTS}"]
        die(
            "internal error: PCR 4 prediction components are missing. "
            f"Expected {PCRLOCK_PRIVATE_COMPONENTS}; run `{PROG} update` again."
        )
    return [f"--components={PCRLOCK_PRIVATE_COMPONENTS}"]


def prune_bootloader_variants(
    keep: set[Path], max_old: int = 3, dry_run: bool = False
) -> None:
    """Keep current PE variants plus a few old ones for the running boot.

    A systemd-boot update replaces the PE on the ESP before the next boot.  The
    running (old) boot's event log still refers to the previous measurement, so
    dropping all old variants would make pcrlock drop PCR 4.  Keeping a few
    recent variants covers the transition without retaining every boot loader
    ever installed.
    """
    d = pcrlock_component_dir(PCRLOCK_BOOTLOADER_COMPONENT)
    if not d.is_dir():
        return
    keep_resolved = {p.resolve() for p in keep}
    old: list[Path] = []
    for path in d.glob("*.pcrlock"):
        if not _BOOTLOADER_VARIANT_RE.fullmatch(path.name):
            continue
        try:
            if path.resolve() in keep_resolved:
                continue
        except OSError:
            pass
        old.append(path)
    def mtime(path: Path) -> float:
        try:
            return path.stat().st_mtime
        except OSError:
            return 0.0

    old.sort(key=mtime, reverse=True)
    for path in old[max_old:]:
        remove_file(path, dry_run)


def prune_pcrlock_variants(component: str, keep: set[Path], dry_run: bool = False) -> None:
    """Remove variants luksury created previously, retaining the given ones."""
    d = pcrlock_component_dir(component)
    if not d.is_dir():
        return
    keep_resolved = {p.resolve() for p in keep}
    for path in sorted(d.glob("*.pcrlock")):
        try:
            resolved = path.resolve()
        except OSError:
            resolved = path
        if resolved in keep_resolved:
            continue
        if path.name == "generated.pcrlock" or _VARIANT_FILE_RE.fullmatch(path.name):
            remove_file(path, dry_run)


def run_pcrlock_locks(
    target_initrd: Path,
    target_cmdline: Path,
    cfg: Config,
    *,
    running_initrd: Optional[Path] = None,
    running_cmdline: Optional[Path] = None,
    dry_run: bool = False,
) -> tuple[set[Path], set[Path], set[Path], bool]:
    """Write pcrlock variants for initrd/cmdline and the boot loader PE.

    Returns (initrd variants, cmdline variants, boot loader variants,
    can_prune).  The caller must only prune after make-policy has succeeded, so
    a failed prediction leaves the previous component set intact.
    """
    binary = pcrlock_bin()
    if not binary:
        die("systemd-pcrlock was not found (install systemd >= 256)")
    if not pcrlock_supported():
        die(
            "this TPM does not support systemd-pcrlock (PolicyAuthorizeNV, TPM 2.0 rev 1.38+). "
            "Use --mode=literal with manual re-enrollment, or use UKIs with a signed PCR policy."
        )

    if not target_cmdline.exists():
        die(f"cmdline file not found: {target_cmdline}")

    keep_initrd: set[Path] = set()
    keep_cmdline: set[Path] = set()
    keep_bootloader: set[Path] = set()

    # The running image must remain covered while the event log still refers
    # to it.  The target image is what the next boot will use.
    if running_initrd is not None:
        keep_initrd.add(_write_pcrlock_variant(PCRLOCK_INITRD_COMPONENT, running_initrd, dry_run))
    keep_initrd.add(_write_pcrlock_variant(PCRLOCK_INITRD_COMPONENT, target_initrd, dry_run))

    if running_cmdline is not None:
        keep_cmdline.add(_write_pcrlock_variant(PCRLOCK_CMDLINE_COMPONENT, running_cmdline, dry_run))
    keep_cmdline.add(_write_pcrlock_variant(PCRLOCK_CMDLINE_COMPONENT, target_cmdline, dry_run))

    if 4 in cfg.pcrs:
        for pe in find_bootloader_pe_paths(cfg):
            keep_bootloader.add(_write_pe_variant(pe, dry_run))

    if cfg.lock_gpt:
        run([binary, "lock-gpt"], dry_run=dry_run)

    if 7 in cfg.pcrs:
        # PCR 7 is the Secure Boot policy.  Generate the component definitions
        # from the current EFI variables/event log so make-policy can predict it.
        for verb in ("lock-secureboot-policy", "lock-secureboot-authority"):
            cp = run([binary, verb], capture=True, check=False, dry_run=dry_run)
            if cp.returncode != 0:
                log.warning(
                    "systemd-pcrlock %s failed; PCR 7 may be omitted from the policy: %s",
                    verb,
                    (cp.stderr or cp.stdout or "").strip(),
                )

    # Only allow pruning when we actually know the running variants; otherwise
    # an old variant may be the only one that still matches the current event log.
    can_prune = running_initrd is not None and running_cmdline is not None
    return keep_initrd, keep_cmdline, keep_bootloader, can_prune


def prune_variants_after_success(
    keep_initrd: set[Path],
    keep_cmdline: set[Path],
    keep_bootloader: set[Path],
    can_prune: bool,
    dry_run: bool = False,
) -> None:
    if not can_prune or dry_run:
        return
    prune_pcrlock_variants(PCRLOCK_INITRD_COMPONENT, keep_initrd)
    prune_pcrlock_variants(PCRLOCK_CMDLINE_COMPONENT, keep_cmdline)
    prune_bootloader_variants(keep_bootloader)


def pcrlock_predict_values(
    cfg: Config, dry_run: bool = False
) -> Optional[dict[int, list[str]]]:
    """Run `systemd-pcrlock predict` and return predicted values per PCR."""
    binary = pcrlock_bin()
    if not binary:
        die("systemd-pcrlock was not found")
    if dry_run:
        log.info("[dry-run] would run systemd-pcrlock predict")
        return None

    cmd = [binary, "predict"]
    for pcr in cfg.pcrs:
        cmd.append(f"--pcr={pcr}")
    if cfg.pcrlock_location:
        cmd.append(f"--location={cfg.pcrlock_location}")
    cmd.extend(pcrlock_components_args(cfg))

    cp = run(cmd + ["--json=short"], capture=True, check=False)
    if cp.returncode == 0:
        try:
            data = json.loads(cp.stdout)
        except ValueError:
            data = None
        if isinstance(data, dict):
            # The policy uses the SHA-256 bank.  Prefer it over any other bank
            # the TPM may expose, so values of different lengths are not mixed.
            sha256_bank = data.get("sha256")
            if isinstance(sha256_bank, list):
                banks = [sha256_bank]
            else:
                banks = [bank for bank in data.values() if isinstance(bank, list)]
            values: dict[int, list[str]] = {}
            for bank in banks:
                for item in bank:
                    if not isinstance(item, dict) or not isinstance(item.get("pcr"), int):
                        continue
                    pcr = item["pcr"]
                    raw_values = item.get("values")
                    if not isinstance(raw_values, list):
                        continue
                    bucket = values.setdefault(pcr, [])
                    for value in raw_values:
                        if isinstance(value, str):
                            bucket.append(value.lower())
            return values

    # Older systemd versions may not support --json; fall back to text output.
    cp = run(cmd, capture=True, check=False)
    if cp.returncode != 0:
        detail = (cp.stderr or cp.stdout or "").strip()
        die(f"systemd-pcrlock predict failed: {detail or f'exit status {cp.returncode}'}")
    values = {}
    current: Optional[int] = None
    for line in cp.stdout.splitlines():
        match = re.search(r"Results for PCR (\d+)", line)
        if match:
            current = int(match.group(1))
            values.setdefault(current, [])
            continue
        match = re.search(r"sha256:\s*([0-9a-fA-F]{16,})", line)
        if match and current is not None:
            values[current].append(match.group(1).lower())
    return values


def _verify_current_pcr_values(
    cfg: Config, values_by_pcr: dict[int, list[str]], source: str
) -> None:
    """Ensure the current TPM values are among the predicted/policy values."""
    for pcr in cfg.pcrs:
        candidates = values_by_pcr.get(pcr)
        if not candidates:
            continue
        current = _tpm_pcr_value(pcr)
        if current is None:
            continue
        if current not in candidates:
            die(
                f"{source} for PCR {pcr} does not contain the current TPM value "
                f"({current}). Refusing to install a policy that cannot unlock this boot. "
                "See `systemd-pcrlock log`."
            )


def verify_pcrlock_prediction(cfg: Config, dry_run: bool = False) -> None:
    """Check the prediction BEFORE make-policy touches the NV index.

    PCR 9 (initrd/cmdline) and PCR 4 (boot loader, when configured) are
    mandatory.  PCR 4 is generated from the validated event log because some
    firmware records measurements that `lock-pe` cannot describe.
    """
    if dry_run:
        log.info("[dry-run] would verify the pcrlock prediction covers PCR 4 and PCR 9")
        return
    if 4 in cfg.pcrs:
        prepare_pcrlock_components(cfg)
    values = pcrlock_predict_values(cfg)
    if values is None:
        return
    pcrs = set(values)
    log.info("pcrlock prediction covers PCRs: %s", ", ".join(map(str, sorted(pcrs))))
    if 9 not in pcrs:
        die(
            "the pcrlock prediction does not cover PCR 9 (initrd/kernel cmdline). "
            "Refusing to update the TPM policy and enroll. This usually means the "
            "initrd/cmdline you are locking is not the one in the current boot's event "
            "log (reboot with the recovery key/passphrase and re-run), or that "
            f"--pcrlock-location={cfg.pcrlock_location} includes components that are "
            "only measured on measured-OS/UKI boots (use 740 for classic boot). "
            "See `systemd-pcrlock log`."
        )
    if 4 in cfg.pcrs and 4 not in pcrs:
        names = ", ".join(str(p) for p in find_bootloader_pe_paths(cfg)) or "none found"
        die(
            "PCR 4 (boot loader) is configured but cannot be predicted. "
            "Refusing to update the TPM policy. The PCR 4 event log could not be "
            "reproduced from the running boot's measurements and the known boot "
            f"loader PEs ({names}). Check `systemd-pcrlock log` and "
            f"{PCRLOCK_PRIVATE_COMPONENTS}."
        )
    if 4 in cfg.pcrs:
        _verify_current_pcr_values(
            cfg, {4: values.get(4, [])}, "the PCR 4 prediction"
        )
    if 7 in cfg.pcrs and 7 not in pcrs:
        log.warning(
            "PCR 7 was requested but cannot be covered (Secure Boot disabled or policy changed); "
            "the policy will bind PCR 9 and any other covered PCRs only"
        )


def run_pcrlock_make_policy(
    cfg: Config, dry_run: bool = False, *, force: bool = False
) -> None:
    binary = pcrlock_bin()
    if not binary:
        die("systemd-pcrlock was not found")
    if 12 in cfg.pcrs:
        die(
            "PCR 12 cannot be used with pcrlock: the pcrlock policy itself is measured "
            "into PCR 12, which would create a circular policy. Use PCR 9 for the "
            "kernel cmdline, or use a signed PCR policy with UKIs."
        )
    cmd = [binary, "make-policy"]
    for pcr in cfg.pcrs:
        cmd.append(f"--pcr={pcr}")
    if cfg.pcrlock_location:
        cmd.append(f"--location={cfg.pcrlock_location}")
    cmd.extend(pcrlock_components_args(cfg, dry_run=dry_run))
    if force:
        cmd.append("--force")
    run(cmd, dry_run=dry_run)
    if not dry_run and not PCRLOCK_JSON.exists():
        die(f"{PCRLOCK_JSON} was not created by systemd-pcrlock")


def pcrlock_policy_values() -> Optional[dict[int, list[str]]]:
    try:
        data = json.loads(PCRLOCK_JSON.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    values = data.get("pcrValues")
    if not isinstance(values, list):
        return None
    result: dict[int, list[str]] = {}
    for item in values:
        if not isinstance(item, dict) or not isinstance(item.get("pcr"), int):
            continue
        raw_values = item.get("values")
        if not isinstance(raw_values, list):
            continue
        bucket = result.setdefault(item["pcr"], [])
        for value in raw_values:
            if isinstance(value, str):
                bucket.append(value.lower())
    return result


def pcrlock_policy_pcrs() -> Optional[list[int]]:
    values = pcrlock_policy_values()
    if values is None:
        return None
    return sorted(values)


def verify_pcrlock_policy(cfg: Config) -> None:
    values_by_pcr = pcrlock_policy_values()
    if values_by_pcr is None:
        die(f"cannot parse {PCRLOCK_JSON}; refusing to enroll an unverifiable policy")
    pcrs = set(values_by_pcr)
    log.info("pcrlock policy covers PCRs: %s", ", ".join(map(str, sorted(pcrs))))
    if 9 not in pcrs:
        die(
            "the generated pcrlock policy does not cover PCR 9 (initrd/kernel cmdline). "
            "Refusing to enroll: automatic unlock would not be bound to the initrd. "
            "Check `systemd-pcrlock log`, the running/target initrd variants, and "
            f"whether --pcrlock-location={cfg.pcrlock_location} includes components "
            "only measured on measured-OS/UKI boots (use 740 for classic boot)."
        )
    if 4 in cfg.pcrs and 4 not in pcrs:
        die(
            "the generated pcrlock policy does not cover PCR 4 (boot loader) even though "
            "it was requested. Refusing to enroll an unbound boot loader. "
            "See `systemd-pcrlock log` and "
            f"{PCRLOCK_PRIVATE_COMPONENTS}."
        )
    _verify_current_pcr_values(
        cfg, {4: values_by_pcr.get(4, [])}, "the generated pcrlock policy"
    )
    if 7 in cfg.pcrs and 7 not in pcrs:
        log.warning("PCR 7 was requested but is not in the pcrlock policy; Secure Boot state is not bound")


def verify_boot_credential(
    cfg: Config, dry_run: bool = False, *, verify_content: bool = True
) -> None:
    """Make sure the initrd can find systemd-pcrlock's boot credential.

    Classic systemd-boot does not pass /loader/credentials to the initrd, so the
    initrd hook copies it into /run/credentials/@encrypted itself.  The
    credential must exist and contain the policy we just generated.
    """
    if dry_run:
        log.info("[dry-run] would verify systemd-pcrlock's loader/credentials/pcrlock.*.cred")
        return

    paths = boot_credential_paths(cfg)
    if not paths:
        log.warning(
            "systemd-pcrlock did not write a boot credential; retrying make-policy with --force"
        )
        run_pcrlock_make_policy(cfg, force=True)
        paths = boot_credential_paths(cfg)
        verify_content = True
    if not paths:
        die(
            "systemd-pcrlock did not write loader/credentials/pcrlock.*.cred. "
            "Classic systemd-boot needs this credential to unlock root. "
            "systemd >= 256 is required; upgrade systemd and re-run."
        )

    if not verify_content:
        log.info(
            "Pcrlock boot credential present: %s (policy unchanged; content not re-checked)",
            ", ".join(str(p) for p in paths),
        )
        return

    sc = systemd_creds_bin()
    if not sc:
        log.info(
            "Pcrlock boot credential present: %s (systemd-creds not found; not content-checked)",
            ", ".join(str(p) for p in paths),
        )
        return

    for attempt in (0, 1):
        expected = PCRLOCK_JSON.read_text(encoding="utf-8").strip()
        verified: Optional[Path] = None
        for path in paths:
            name = path.name[: -len(".cred")] if path.name.endswith(".cred") else path.name
            cp = run(
                [sc, "decrypt", "--allow-null", f"--name={name}", str(path), "-"],
                capture=True,
                check=False,
            )
            if cp.returncode == 0 and cp.stdout.strip() == expected:
                verified = path
                break
        if verified is not None:
            log.info("Verified pcrlock boot credential %s", verified)
            return
        if attempt == 0:
            log.warning(
                "the pcrlock boot credential does not match the current policy; "
                "retrying make-policy with --force"
            )
            run_pcrlock_make_policy(cfg, force=True)
            paths = boot_credential_paths(cfg)
            if not paths:
                break

    die(
        "the pcrlock boot credential does not contain the current policy "
        f"({', '.join(str(p) for p in paths)}); refusing to leave the next boot "
        "with an unusable credential"
    )


def legacy_boot_policy_path(cfg: Config) -> Optional[Path]:
    if not cfg.boot_mount:
        return None
    return Path(cfg.boot_mount) / LEGACY_BOOT_POLICY_SUBDIR / LEGACY_BOOT_POLICY_NAME


def refresh_legacy_boot_policy(cfg: Config, dry_run: bool = False) -> None:
    """Keep a 2.0-style ESP copy fresh until setup migrates the initrd.

    A 2.0 initrd reads /boot/<...>/luksury/pcrlock.json.  If the tool was
    upgraded and `update` runs before `setup` has rebuilt the initrd, leaving
    that file stale would break the next boot.
    """
    dest = legacy_boot_policy_path(cfg)
    if dest is None or not dest.exists():
        return
    if dry_run:
        log.info("[dry-run] would refresh legacy ESP policy copy %s", dest)
        return
    if not PCRLOCK_JSON.exists():
        die(f"{PCRLOCK_JSON} does not exist")
    dest.parent.mkdir(parents=True, exist_ok=True)
    fd, tmpname = tempfile.mkstemp(prefix=f".{dest.name}.", dir=str(dest.parent))
    tmp = Path(tmpname)
    try:
        with os.fdopen(fd, "wb") as out, PCRLOCK_JSON.open("rb") as src:
            shutil.copyfileobj(src, out)
        os.chmod(tmp, 0o644)
        os.replace(tmp, dest)
        os.sync()
    finally:
        tmp.unlink(missing_ok=True)
    if sha256_file(dest) != sha256_file(PCRLOCK_JSON):
        die(f"copy verification failed for {dest}")
    log.warning(
        "refreshed legacy ESP policy copy %s; run `%s setup` to migrate the "
        "initrd to systemd-pcrlock's credential",
        dest,
        PROG,
    )


def remove_legacy_boot_policy(cfg: Config, dry_run: bool = False) -> None:
    dest = legacy_boot_policy_path(cfg)
    if dest is None or not dest.exists():
        return
    remove_file(dest, dry_run)
    if not dry_run and dest.parent.exists():
        try:
            dest.parent.rmdir()
        except OSError:
            pass


def install_runtime_policy(dry_run: bool = False) -> None:
    """Install the policy where the running system's self-test looks for it.

    The initrd obtains the same data from systemd-pcrlock's boot credential via
    /run/credentials/@encrypted, which is not available on the running host.
    """
    if not PCRLOCK_JSON.exists():
        die(f"{PCRLOCK_JSON} does not exist")
    if dry_run:
        log.info("[dry-run] would copy %s to %s", PCRLOCK_JSON, PCRLOCK_RUNTIME)
        return
    atomic_write(PCRLOCK_RUNTIME, PCRLOCK_JSON.read_bytes(), 0o644)
    log.info("Installed runtime pcrlock policy at %s", PCRLOCK_RUNTIME)


def enroll_tpm(
    dev: Path,
    cfg: Config,
    *,
    unlock_key_file: Optional[Path],
    unlock_tpm2_device: Optional[str],
    wipe: bool,
    dry_run: bool,
) -> None:
    sce = cryptenroll_bin()
    cmd = [sce, "--tpm2-device=auto"]

    if cfg.mode == "pcrlock":
        cmd.append(f"--tpm2-pcrlock={PCRLOCK_JSON}")
    elif cfg.mode == "literal":
        cmd.append("--tpm2-pcrs=" + "+".join(str(p) for p in cfg.pcrs))
    else:
        die(f"unknown mode: {cfg.mode}")

    if unlock_key_file:
        cmd.append(f"--unlock-key-file={unlock_key_file}")
    if unlock_tpm2_device:
        cmd.append(f"--unlock-tpm2-device={unlock_tpm2_device}")
    if wipe:
        cmd.append("--wipe-slot=tpm2")
    cmd.append(str(dev))

    run(cmd, dry_run=dry_run)


