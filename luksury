# CLI
# ---------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=PROG,
        description=(
            "TPM2 auto-unlock for classic systemd-boot LUKS2 roots using "
            "systemd-cryptenroll and systemd-pcrlock."
        ),
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    parser.add_argument("--version", action="version", version=f"{PROG} {VERSION}")
    parser.add_argument("-v", "--verbose", action="store_true", help="verbose logging")
    parser.add_argument("-n", "--dry-run", action="store_true", help="show what would be done")
    parser.add_argument("-y", "--yes", action="store_true", help="do not ask for confirmation")
    parser.add_argument(
        "--unlock-key-file",
        type=Path,
        help="existing key file used to unlock the volume during setup",
    )
    parser.add_argument(
        "--unlock-tpm2-device",
        metavar="PATH|auto",
        help="existing TPM2 device/token used to unlock during setup",
    )

    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("setup", help="configure TPM2 auto-unlock and the update hook")
    p.add_argument(
        "--mode",
        choices=("auto", "pcrlock", "literal"),
        default="auto",
        help="pcrlock is update-safe; literal is a fallback for old TPMs",
    )
    p.add_argument(
        "--pcrs",
        help="comma/plus-separated PCR list (default: 4,7,9 for pcrlock; 4,7,9,12 for literal)",
    )
    p.add_argument(
        "--pcrlock-location",
        default=DEFAULT_PCRLOCK_LOCATION,
        help="systemd-pcrlock make-policy --location (default 740 for classic boot)",
    )
    p.add_argument("--lock-gpt", action="store_true", help="also lock the GPT (PCR 5)")
    p.add_argument(
        "--bootloader-pe",
        action="append",
        default=[],
        metavar="PATH",
        help="additional boot loader PE to lock to PCR 4 (may be repeated)",
    )
    p.set_defaults(func=cmd_setup)

    p = sub.add_parser("update", help="refresh the pcrlock policy after an initrd/kernel update")
    p.add_argument("--initrd", type=Path, help="new initrd image")
    p.add_argument("--cmdline", type=Path, help="file containing the new kernel command line")
    p.add_argument("--kernel", help="kernel version (find /boot/initrd.img-VERSION)")
    p.set_defaults(func=cmd_update)

    p = sub.add_parser(
        "refresh-bootloader",
        help="re-lock a newly installed boot loader for PCR 4 (used by the boot-update hook)",
    )
    p.set_defaults(func=cmd_refresh_bootloader)

    p = sub.add_parser("status", help="show the current configuration")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("remove", help="remove the TPM2 token and hooks")
    p.add_argument("--remove-pcrlock", action="store_true", help="also deallocate the pcrlock NV index")
    p.add_argument("--keep-binary", action="store_true", help="keep /usr/local/sbin/luksury")
    p.add_argument(
        "--rebuild-initramfs",
        action="store_true",
        help="rebuild the initrd now (can invalidate a concurrent setup; prefer a later rebuild)",
    )
    p.set_defaults(func=cmd_remove)

    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    setup_logging(args.verbose, log_to_file=(os.geteuid() == 0))

    try:
        if args.command in ("setup", "update", "refresh-bootloader", "remove"):
            with FileLock():
                return int(args.func(args))
        return int(args.func(args))
    except LuksuryError as exc:
        eprint(f"{PROG}: {exc}")
        if args.verbose:
            log.exception("luksury failed")
        return 1
    except KeyboardInterrupt:
        eprint(f"{PROG}: interrupted")
        return 130
    except Exception as exc:  # noqa: BLE001 - top-level guard for a root CLI
        eprint(f"{PROG}: unexpected error: {exc}")
        if args.verbose:
            log.exception("unexpected error")
        return 1


if __name__ == "__main__":
    sys.exit(main())
