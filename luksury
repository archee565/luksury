def setup_logging(verbose: bool = False, log_to_file: bool = True) -> None:
    log.setLevel(logging.DEBUG if verbose else logging.INFO)
    log.handlers.clear()
    fmt = logging.Formatter("%(asctime)s %(levelname)s: %(message)s", "%Y-%m-%d %H:%M:%S")

    console = logging.StreamHandler()
    console.setFormatter(fmt)
    console.setLevel(logging.DEBUG if verbose else logging.INFO)
    log.addHandler(console)

    if log_to_file:
        try:
            LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
            fh = logging.FileHandler(LOG_FILE, encoding="utf-8")
            fh.setFormatter(fmt)
            fh.setLevel(logging.DEBUG)
            log.addHandler(fh)
            try:
                os.chmod(LOG_FILE, 0o600)
            except OSError:
                pass
        except OSError as exc:
            log.debug("Cannot open %s for logging: %s", LOG_FILE, exc)
    log.propagate = False


def _cleanup_legacy_lock() -> None:
    """Remove a stale /run/lock lock left by an older or unprivileged run."""
    if os.geteuid() != 0:
        return
    try:
        fd = os.open(LEGACY_LOCK_FILE, os.O_RDONLY | os.O_CLOEXEC)
    except OSError:
        return
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return
        try:
            LEGACY_LOCK_FILE.unlink()
            log.info("Removed stale legacy lock file %s", LEGACY_LOCK_FILE)
        except OSError as exc:
            log.debug("Cannot remove legacy lock file %s: %s", LEGACY_LOCK_FILE, exc)
    finally:
        os.close(fd)


class FileLock:
    def __init__(self, path: Path = LOCK_FILE):
        self.path = path
        self.fd: Optional[int] = None

    def __enter__(self) -> "FileLock":
        _cleanup_legacy_lock()
        try:
            self.path.parent.mkdir(parents=True, exist_ok=True)
            self.fd = os.open(self.path, os.O_CREAT | os.O_RDWR, 0o600)
        except OSError as exc:
            die(
                f"cannot open lock file {self.path}: {exc.strerror or exc}. "
                "Run this command as root; if the file is stale, remove it."
            )
        try:
            fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            os.close(self.fd)
            self.fd = None
            die(f"another {PROG} operation is already running ({self.path})")
        return self

    def __exit__(self, exc_type: Any, exc: Any, tb: Any) -> None:
        if self.fd is not None:
            fcntl.flock(self.fd, fcntl.LOCK_UN)
            os.close(self.fd)
            self.fd = None


