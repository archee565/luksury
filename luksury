def cmd_setup(args: argparse.Namespace) -> int:
    require_root()
    if not dracut_bin():
        die(
            "dracut is required: the boot-time pcrlock hook is a dracut module. "
            "Install dracut (Ubuntu 25.10+ uses it by default) and retry."
        )
    if not systemd_boot_active():
        die(
            "systemd-boot is not the current boot loader. This tool relies on "
            "systemd-boot's classic linux+initrd handling and cannot configure GRUB."
        )
    install_self(args.dry_run)

    for old_bin in (Path("/usr/bin/luksury"), Path("/usr/local/bin/luksury")):
        if old_bin.exists():
            log.warning(
                "An old luksury binary exists at %s. The new tool is installed at %s; "
                "remove the old binary after verifying the new auto-unlock.",
                old_bin,
                INSTALLED_BIN,
            )

    old_keyfile = STATE_DIR / "root_keyfile.bin"
    old_handle = STATE_DIR / "persistent_handle.bin"
    if old_keyfile.exists() or old_handle.exists():
        log.warning(
            "Found files from the old luksury (%s%s). This tool does not use them. "
            "After verifying the new auto-unlock, remove the old LUKS keyslot and TPM "
            "object separately (or run the old `luksury remove`).",
            old_keyfile if old_keyfile.exists() else "",
            f", {old_handle}" if old_handle.exists() else "",
        )

    cfg = Config()
    cfg.mode = args.mode
    cfg.pcrlock_location = args.pcrlock_location
    cfg.lock_gpt = args.lock_gpt
    for raw in getattr(args, "bootloader_pe", []):
        path = Path(raw)
        if not path.is_file():
            die(f"boot loader PE not found: {path}")
        cfg.bootloader_pes.append(str(path.resolve()))
    if (
        cfg.mode in ("auto", "pcrlock")
        and not ("720-kernel-initrd" < cfg.pcrlock_location < "750")
    ):
        log.warning(
            "pcrlock location %s may include components that are only measured on "
            "measured-OS/UKI boots; 740 is recommended for classic systemd-boot",
            cfg.pcrlock_location,
        )

    if cfg.mode == "auto":
        cfg.mode = "pcrlock" if pcrlock_supported() else "literal"
        log.info("Selected mode: %s", cfg.mode)
    elif cfg.mode == "pcrlock" and not pcrlock_supported():
        die("systemd-pcrlock is not supported on this system/TPM; use --mode=literal")
    elif cfg.mode == "literal":
        log.warning(
            "literal PCR mode does not survive initrd/kernel updates. "
            "You will have to re-enroll after each update."
        )

    if args.pcrs:
        cfg.pcrs = parse_pcr_list(args.pcrs)
    else:
        cfg.pcrs = list(DEFAULT_PCRLOCK_PCRS if cfg.mode == "pcrlock" else DEFAULT_LITERAL_PCRS)

    if args.lock_gpt and 5 not in cfg.pcrs:
        cfg.pcrs.append(5)

    if cfg.mode == "pcrlock" and 12 in cfg.pcrs:
        die(
            "PCR 12 is not usable with pcrlock (circular policy measurement). "
            "PCR 9 covers the kernel cmdline/initrd; remove 12."
        )

    if (
        cfg.mode == "pcrlock"
        and 4 in cfg.pcrs
        and cfg.pcrlock_location < PCRLOCK_BOOTLOADER_COMPONENT
    ):
        log.warning(
            "pcrlock location %s excludes %s; PCR 4 will not be covered",
            cfg.pcrlock_location,
            PCRLOCK_BOOTLOADER_COMPONENT,
        )

    dev, name = find_root_luks()
    check_luks2(dev)
    cfg.luks_device = str(dev)
    cfg.luks_name = name
    cfg.luks_uuid = luks_uuid(dev)
    log.info("Root LUKS2 device: %s (%s)", dev, name)

    boot = find_boot_partition()
    if not boot.uuid:
        die(
            f"cannot determine the UUID of the boot partition ({boot.mount}); "
            "the initramfs would not be able to read the pcrlock policy"
        )
    cfg.boot_mount = str(boot.mount)
    cfg.boot_uuid = boot.uuid
    cfg.boot_fstype = boot.fstype
    cfg.boot_device = boot.device
    log.info(
        "Boot partition: %s (UUID=%s, fstype=%s, device=%s)",
        boot.mount,
        boot.uuid,
        boot.fstype or "?",
        boot.device or "?",
    )

    credential = find_credential_partition()
    if credential is None or not credential.uuid:
        log.warning(
            "cannot determine the $BOOT credential partition UUID; falling back to the "
            "boot-entry partition %s",
            boot.mount,
        )
        credential = boot
    cfg.credential_mount = str(credential.mount)
    cfg.credential_uuid = credential.uuid
    cfg.credential_fstype = credential.fstype
    log.info(
        "Credential partition: %s (UUID=%s)",
        credential.mount,
        credential.uuid,
    )

    entry = find_default_entry(boot)
    if entry.is_uki:
        die("UKI entries are not supported; this tool is for classic linux+initrd entries")
    if not entry.initrds:
        die(f"no initrd found for {entry.path}")
    # Store a stable path, not an ephemeral combined image.
    cfg.initrd = str(entry.initrds[0])
    if len(entry.initrds) > 1:
        log.info("Multiple initrds found; combining them for the pcrlock measurement")
    running_release = os.uname().release
    cfg.kernel_version = entry.version or running_release
    if entry.version and entry.version != running_release:
        log.warning(
            "The default boot entry is for kernel %s, but the running kernel is %s. "
            "The pcrlock policy will be built for the default entry (the next boot).",
            entry.version,
            running_release,
        )

    # Snapshot the initrd of the *running* boot before setup rebuilds the
    # target image.  pcrlock needs a component that matches the current
    # boot's event log, otherwise it drops PCR 9.
    running_initrd, running_temp = find_running_initrd(boot)
    snapshot_needed = False
    if running_initrd is not None and not running_temp:
        try:
            if running_initrd.resolve() == entry.initrds[0].resolve():
                snapshot_needed = True
        except OSError:
            pass
    running_cmdline_text = read_running_cmdline()
    if not running_cmdline_text:
        running_cmdline_text = build_kernel_cmdline(entry)

    # The target cmdline comes from the target boot entry, not from the
    # currently running /proc/cmdline.  Keep the initrd= prefix only if the
    # running loader used one (otherwise it uses the LoadFile2 protocol).
    cmdline_text = build_kernel_cmdline(
        entry, include_initrd=cmdline_has_initrd(running_cmdline_text)
    )
    if not cmdline_text:
        die(f"cannot determine the kernel command line for {entry.path}")
    cfg.cmdline = cmdline_text
    log.info("Initrd: %s", cfg.initrd)
    log.info("Cmdline: %s", cmdline_text)
    log.info("Running initrd: %s", running_initrd or "unknown")

    if luks_has_token(dev, "systemd-tpm2"):
        if not args.dry_run and not confirm(
            "Replace the existing TPM2 enrollment on this device?", args.yes
        ):
            die("aborted before replacing the existing TPM2 enrollment")
        wipe = True
    else:
        wipe = False

    if not args.dry_run:
        backup = Path(f"/root/luks-header-{_dt.datetime.now():%Y%m%d-%H%M%S}.img")
        run([cryptsetup_bin(), "luksHeaderBackup", str(dev), "--header-backup-file", str(backup)])
        os.chmod(backup, 0o600)
        log.info("LUKS header backup: %s", backup)

    if not luks_has_token(dev, "systemd-recovery"):
        log.info("No recovery key token found; adding one now. Store it offline!")
        enroll_cmd = [cryptenroll_bin(), "--recovery-key"]
        if args.unlock_key_file:
            enroll_cmd.append(f"--unlock-key-file={args.unlock_key_file}")
        if args.unlock_tpm2_device:
            enroll_cmd.append(f"--unlock-tpm2-device={args.unlock_tpm2_device}")
        enroll_cmd.append(str(dev))
        if args.dry_run:
            log.info("[dry-run] %s", shlex.join(enroll_cmd))
        else:
            run(enroll_cmd)
            log.info("Recovery key enrolled. Keep it offline; it is not stored by luksury.")
    else:
        log.info("A recovery key token already exists; leaving it untouched")

    if snapshot_needed and running_initrd is not None:
        running_initrd = snapshot_file(running_initrd)
        running_temp = True
    running_cmdline_file = write_temp_text(running_cmdline_text)
    cmdline_file = write_temp_text(cmdline_text)

    target_initrd: Optional[Path] = None
    target_temp = False
    if cfg.mode == "pcrlock":
        # The dracut module must be installed and the initrd rebuilt BEFORE the
        # policy is generated, otherwise the policy locks an image that is
        # about to be replaced.
        install_dracut_module(cfg, args.dry_run)
        image = Path(cfg.initrd)
        regenerate_initramfs(
            image if cfg.initrd else None,
            cfg.kernel_version or running_release,
            args.dry_run,
        )
        if not args.dry_run and initrd_has_luksury_hook(image) is False:
            die(
                f"the regenerated initrd {image} does not contain the luksury hook; "
                "check the dracut module installation and dracut configuration"
            )
        target_initrd, target_temp = make_combined_initrd(
            entry.initrds, dry_run=args.dry_run
        )
    else:
        log.info(
            "literal PCR mode: not installing the pcrlock hook or rebuilding the initrd"
        )

    try:
        if cfg.mode == "pcrlock":
            assert target_initrd is not None
            keep_initrd, keep_cmdline, keep_bootloader, can_prune = run_pcrlock_locks(
                target_initrd,
                cmdline_file,
                cfg,
                running_initrd=running_initrd,
                running_cmdline=running_cmdline_file,
                dry_run=args.dry_run,
            )
            verify_pcrlock_prediction(cfg, dry_run=args.dry_run)
            run_pcrlock_make_policy(cfg, dry_run=args.dry_run)
            if not args.dry_run:
                verify_pcrlock_policy(cfg)
                verify_boot_credential(cfg)
            prune_variants_after_success(
                keep_initrd,
                keep_cmdline,
                keep_bootloader,
                can_prune,
                dry_run=args.dry_run,
            )
        elif cfg.mode == "literal":
            log.warning(
                "literal PCR mode: the TPM seal will not survive future initrd/cmdline "
                "changes. Re-run `%s setup --mode=literal` after such an update.",
                PROG,
            )

        enroll_tpm(
            dev,
            cfg,
            unlock_key_file=args.unlock_key_file,
            unlock_tpm2_device=args.unlock_tpm2_device,
            wipe=wipe,
            dry_run=args.dry_run,
        )
    finally:
        if target_temp:
            target_initrd.unlink(missing_ok=True)
        if running_temp and running_initrd is not None:
            running_initrd.unlink(missing_ok=True)
        running_cmdline_file.unlink(missing_ok=True)
        cmdline_file.unlink(missing_ok=True)

    install_update_hooks(args.dry_run)
    set_crypttab_tpm(dev, cfg, remove=False, dry_run=args.dry_run)

    if cfg.mode == "pcrlock":
        install_runtime_policy(args.dry_run)
        # The rebuilt initrd consumes systemd-pcrlock's credential now, so the
        # 2.0-style ESP copy is no longer needed.
        remove_legacy_boot_policy(cfg, args.dry_run)

    save_config(cfg, args.dry_run)

    if not args.dry_run:
        if entry.version and entry.version != running_release:
            log.warning(
                "Skipping the TPM unlock self-test: the default entry boots kernel %s, "
                "but the running kernel is %s. Reboot with the recovery key available.",
                entry.version,
                running_release,
            )
        elif not verify_enrollment(dev):
            eprint(
                "\nAuto-unlock was configured, but the self-test failed.\n"
                "The LUKS passphrase and recovery key still work.\n"
                f"Check `{PROG} status`, `systemd-pcrlock log`, and re-run `{PROG} setup`."
            )
            return 1
        else:
            log.info(
                "The self-test validates the current boot only; reboot with the recovery "
                "key available to verify the next boot."
            )
        print()
        print(f"{PROG} setup complete.")
        print(f"  Mode:       {cfg.mode}")
        print(f"  PCRs:       {', '.join(map(str, cfg.pcrs))}")
        print(f"  LUKS:       {dev}")
        print(f"  Boot:       {boot.mount}")
        print(f"  Initrd:     {cfg.initrd}")
        print()
        print("Reboot with the recovery key available.  Then test an edited boot")
        print("entry (`rd.break=pre-mount`): the TPM must refuse to unseal.")
    return 0


def _initrd_spec(initrd: Path, boot_mount: Path) -> str:
    """Best-effort boot-partition-relative spec for an initrd path."""
    try:
        rel = initrd.resolve().relative_to(boot_mount.resolve())
        return "/" + str(rel)
    except (OSError, ValueError):
        return str(initrd)


def _resolve_update_inputs(
    args: argparse.Namespace, cfg: Config
) -> tuple[Path, Path, list[Path]]:
    """Return (initrd, cmdline_file, temporary_paths)."""
    temporary: list[Path] = []
    boot = BootPartition(
        mount=Path(cfg.boot_mount),
        uuid=cfg.boot_uuid,
        fstype=cfg.boot_fstype,
    )
    entry: Optional[BootEntry] = None

    if args.kernel:
        entry = find_entry_for_kernel(boot, args.kernel)
    elif args.initrd is None:
        try:
            entry = find_default_entry(boot)
        except LuksuryError:
            entry = None

    initrd: Optional[Path] = None
    if entry is not None and entry.initrds:
        try:
            initrd, temporary_flag = make_combined_initrd(
                entry.initrds, dry_run=args.dry_run
            )
            if temporary_flag:
                temporary.append(initrd)
        except LuksuryError:
            # The final initrd may not have been installed yet; the staging
            # area still has the same image.
            if args.initrd is not None:
                initrd = args.initrd
            else:
                raise

    if initrd is None and args.initrd is not None:
        initrd = args.initrd

    if initrd is None and args.kernel:
        version = args.kernel
        for cand in (
            Path(f"/boot/initrd.img-{version}"),
            Path(f"/boot/initramfs-{version}.img"),
            Path(f"/boot/initramfs-{version}"),
        ):
            if cand.exists():
                initrd = cand
                break

    if initrd is None and cfg.initrd and not args.kernel:
        initrd = Path(cfg.initrd)
    if initrd is None and not args.kernel:
        cand = Path("/boot") / f"initrd.img-{os.uname().release}"
        if cand.exists():
            initrd = cand
    if initrd is None or not initrd.exists():
        die(
            "cannot determine the initrd"
            + (f" for kernel {args.kernel}" if args.kernel else "")
            + "; pass --initrd or --kernel"
        )

    running_cmdline_text = read_running_cmdline()
    include_initrd = cmdline_has_initrd(running_cmdline_text)

    cmdline_text = ""
    cmdline_arg = args.cmdline
    if (
        cmdline_arg is not None
        and entry is not None
        and cmdline_arg.resolve() == Path("/proc/cmdline").resolve()
    ):
        # The running cmdline contains the *old* initrd path on kernel updates.
        # Reconstruct it from the new entry instead.
        cmdline_arg = None

    if cmdline_arg is not None:
        if not cmdline_arg.exists():
            die(f"cmdline file not found: {cmdline_arg}")
        text = cmdline_arg.read_text(encoding="utf-8", errors="replace").strip()
        if not text and entry is not None:
            cmdline_text = build_kernel_cmdline(entry, include_initrd=include_initrd)
        elif re.search(r"(^|\s)initrd=", text):
            # Already a full /proc/cmdline-style string.
            cmdline_text = text
        elif entry is not None:
            cmdline_text = build_kernel_cmdline(
                entry, options=text, include_initrd=include_initrd
            )
        else:
            spec = _initrd_spec(initrd, boot.mount)
            cmdline_text = (
                f"initrd={uefi_path(spec)} {text}".strip() if include_initrd else text
            )
    else:
        if entry is not None:
            cmdline_text = build_kernel_cmdline(entry, include_initrd=include_initrd)
        else:
            for cand in (Path("/etc/kernel/cmdline"), Path("/proc/cmdline")):
                if cand.exists():
                    text = cand.read_text(encoding="utf-8", errors="replace").strip()
                    if text:
                        if re.search(r"(^|\s)initrd=", text):
                            cmdline_text = text
                        else:
                            spec = _initrd_spec(initrd, boot.mount)
                            cmdline_text = (
                                f"initrd={uefi_path(spec)} {text}".strip()
                                if include_initrd
                                else text
                            )
                        break
    if not cmdline_text:
        die("cannot determine the kernel command line; pass --cmdline")

    cmdline_file = write_temp_text(cmdline_text)
    temporary.append(cmdline_file)
    return Path(initrd), cmdline_file, temporary


def cmd_update(args: argparse.Namespace) -> int:
    require_root()
    cfg = load_config(required=True)
    assert cfg is not None
    initrd, cmdline, temporary = _resolve_update_inputs(args, cfg)

    boot = BootPartition(
        mount=Path(cfg.boot_mount),
        uuid=cfg.boot_uuid,
        fstype=cfg.boot_fstype,
    )
    running_initrd, running_temp = find_running_initrd(boot)
    if running_temp and running_initrd is not None:
        temporary.append(running_initrd)
    running_cmdline_text = read_running_cmdline()
    running_cmdline: Optional[Path] = None
    if running_cmdline_text:
        running_cmdline = write_temp_text(running_cmdline_text)
        temporary.append(running_cmdline)
    if running_initrd is None:
        log.warning(
            "Cannot locate the running kernel's initrd (%s); the update can only "
            "succeed if a previously stored pcrlock variant still matches this boot.",
            os.uname().release,
        )

    try:
        log.info("Refreshing luksury policy for initrd=%s cmdline=%s", initrd, cmdline)

        if cfg.mode == "pcrlock":
            keep_initrd, keep_cmdline, keep_bootloader, can_prune = run_pcrlock_locks(
                initrd,
                cmdline,
                cfg,
                running_initrd=running_initrd,
                running_cmdline=running_cmdline,
                dry_run=args.dry_run,
            )
            verify_pcrlock_prediction(cfg, dry_run=args.dry_run)
            old_policy: Optional[str] = None
            try:
                old_policy = PCRLOCK_JSON.read_text(encoding="utf-8")
            except OSError:
                pass
            run_pcrlock_make_policy(cfg, args.dry_run)
            if not args.dry_run:
                try:
                    policy_changed = PCRLOCK_JSON.read_text(encoding="utf-8") != old_policy
                except OSError:
                    policy_changed = True
                verify_pcrlock_policy(cfg)
                verify_boot_credential(cfg, verify_content=policy_changed)
                refresh_legacy_boot_policy(cfg)
            prune_variants_after_success(
                keep_initrd,
                keep_cmdline,
                keep_bootloader,
                can_prune,
                dry_run=args.dry_run,
            )
            install_runtime_policy(args.dry_run)
            log.info("pcrlock policy refreshed; no LUKS re-enrollment needed")
        elif cfg.mode == "literal":
            log.warning(
                "literal PCR mode: the initrd/cmdline changed, so the current TPM seal "
                "will not match on the next boot. Boot with the LUKS passphrase or "
                f"recovery key, then run `{PROG} setup --mode=literal` to re-enroll."
            )
        else:
            die(f"unknown configured mode: {cfg.mode}")
    finally:
        for path in temporary:
            path.unlink(missing_ok=True)
    if cfg.mode == "pcrlock":
        refresh_boot_update_dropin(args.dry_run)
    save_config(cfg, args.dry_run)
    return 0


def cmd_refresh_bootloader(args: argparse.Namespace) -> int:
    """Refresh the PCR 4 prediction and policy after a boot loader update.

    Called by the systemd-boot-update.service drop-in.  The initrd/cmdline
    components from the last setup/update are still valid, but the PCR 4
    component is rebuilt from the current event log so a policy created
    without PCR 4 is repaired as well.
    """
    require_root()
    cfg = load_config(required=True)
    assert cfg is not None
    if cfg.mode != "pcrlock":
        return 0

    keep_bootloader: set[Path] = set()
    new_variant = False
    for pe in find_bootloader_pe_paths(cfg):
        if not pe_variant_path(pe).exists():
            new_variant = True
        keep_bootloader.add(_write_pe_variant(pe, args.dry_run))

    # When PCR 4 is configured, always rebuild the event-log-derived component
    # and policy, even if no new PE was installed.  This repairs policies created
    # by an older luksury that skipped PCR 4, and keeps the candidate set for the
    # next boot loader update current.
    if not new_variant and 4 not in cfg.pcrs and not args.dry_run:
        log.info("boot loader PCR 4 variants are up to date")
        return 0

    old_policy: Optional[str] = None
    try:
        old_policy = PCRLOCK_JSON.read_text(encoding="utf-8")
    except OSError:
        pass

    verify_pcrlock_prediction(cfg, dry_run=args.dry_run)
    run_pcrlock_make_policy(cfg, args.dry_run)
    if not args.dry_run:
        try:
            policy_changed = PCRLOCK_JSON.read_text(encoding="utf-8") != old_policy
        except OSError:
            policy_changed = True
        verify_pcrlock_policy(cfg)
        verify_boot_credential(cfg, verify_content=policy_changed)
        prune_bootloader_variants(keep_bootloader)
        install_runtime_policy(args.dry_run)
        log.info("boot loader PCR 4 policy refreshed")
    refresh_boot_update_dropin(args.dry_run)
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    cfg = load_config(required=False)
    print(f"{PROG} {VERSION}")
    print()

    dev: Optional[Path] = None
    try:
        dev, name = find_root_luks()
    except LuksuryError as exc:
        name = ""
        print(f"Root LUKS device: unknown ({exc})")
        if cfg and cfg.luks_device:
            dev = Path(cfg.luks_device)
            name = cfg.luks_name
    if dev is not None:
        print(f"Root LUKS device: {dev} ({name})")
        try:
            check_luks2(dev)
            print("LUKS version:     2")
        except LuksuryError:
            print("LUKS version:     unknown (run as root to inspect the header)")

    if cfg is None:
        print("Configuration:    not configured (run `luksury setup`)")
    else:
        print(f"Configuration:    {CONFIG_FILE}")
        print(f"Mode:             {cfg.mode}")
        print(f"Configured PCRs:  {', '.join(map(str, cfg.pcrs))}")
        print(f"Boot partition:   {cfg.boot_mount} (UUID={cfg.boot_uuid or '?'}, {cfg.boot_fstype or '?'})")
        print(
            f"Credential part.: {cfg.credential_mount or cfg.boot_mount} "
            f"(UUID={cfg.credential_uuid or cfg.boot_uuid or '?'})"
        )
        print(f"Kernel version:   {cfg.kernel_version or '?'}")
        print(f"Initrd:           {cfg.initrd or '?'}")
        print(f"Cmdline:          {cfg.cmdline or '?'}")
        print(f"pcrlock location: {cfg.pcrlock_location}")

    if dev is not None:
        print(f"TPM2 token:       {'yes' if luks_has_token(dev, 'systemd-tpm2') else 'no'}")
        print(f"Recovery token:   {'yes' if luks_has_token(dev, 'systemd-recovery') else 'no'}")

    pcrs = pcrlock_policy_pcrs()
    if PCRLOCK_JSON.exists():
        pcrs_text = "unparseable" if pcrs is None else (", ".join(map(str, pcrs)) or "none")
        print(f"pcrlock policy:   {PCRLOCK_JSON} (PCRs: {pcrs_text})")
    else:
        print(f"pcrlock policy:   {PCRLOCK_JSON} (missing)")

    if cfg and cfg.mode == "pcrlock" and 4 in cfg.pcrs:
        state = "present" if PCRLOCK_PRIVATE_COMPONENTS.is_dir() else "missing"
        print(f"PCR 4 components: {PCRLOCK_PRIVATE_COMPONENTS} ({state})")

    if PCRLOCK_RUNTIME.exists():
        if PCRLOCK_JSON.exists():
            match = "match" if sha256_file(PCRLOCK_RUNTIME) == sha256_file(PCRLOCK_JSON) else "MISMATCH"
        else:
            match = "unknown"
        print(f"Runtime policy:   {PCRLOCK_RUNTIME} ({match})")
    else:
        print(f"Runtime policy:   {PCRLOCK_RUNTIME} (missing; installed for the self-test)")

    if cfg and (cfg.credential_mount or cfg.boot_mount):
        credentials = boot_credential_paths(cfg)
        if credentials:
            for credential in credentials:
                print(f"Boot credential:  {credential}")
        else:
            print(
                "Boot credential:  missing "
                "(expected $BOOT/loader/credentials/pcrlock.*.cred from systemd-pcrlock)"
            )

    hooks = {
        "kernel-install": KERNEL_INSTALL_HOOK,
        "initramfs": INITRAMFS_HOOK,
        "pacman": PACMAN_HOOK,
        "dracut module": DRACUT_MODULE_DIR / "module-setup.sh",
        "dracut conf": DRACUT_CONF,
        "boot update": BOOT_UPDATE_DROPIN,
    }
    print("Hooks:")
    for label, path in hooks.items():
        print(f"  {label:15s} {'yes' if path.exists() else 'no'}  {path}")

    bc = bootctl_bin()
    if bc:
        cp = run([bc, "status"], capture=True, check=False)
        for line in cp.stdout.splitlines():
            if "Secure Boot:" in line or "TPM:" in line:
                print(line.strip())
    return 0


def cmd_remove(args: argparse.Namespace) -> int:
    require_root()
    cfg = load_config(required=False)
    dev: Optional[Path] = None
    try:
        dev, name = find_root_luks()
    except LuksuryError:
        name = ""
    if dev is None and cfg and cfg.luks_device:
        dev = Path(cfg.luks_device)
        name = cfg.luks_name
    if dev is None:
        die("cannot determine the root LUKS device")

    if not confirm(
        "Remove the TPM2 auto-unlock token and luksury hooks? "
        "The LUKS passphrase and recovery key will remain.",
        args.yes,
    ):
        die("aborted")

    if luks_has_token(dev, "systemd-tpm2"):
        run([cryptenroll_bin(), "--wipe-slot=tpm2", str(dev)], dry_run=args.dry_run)
        log.info("Removed the systemd-tpm2 token from %s", dev)

    if args.remove_pcrlock:
        binary = pcrlock_bin()
        if binary:
            cp = run([binary, "remove-policy"], check=False, dry_run=args.dry_run)
            if cp.returncode == 0:
                log.info("Removed the systemd-pcrlock policy")
            else:
                log.warning(
                    "Could not remove the systemd-pcrlock policy: %s",
                    (cp.stderr or cp.stdout or "").strip(),
                )
        else:
            log.warning("systemd-pcrlock was not found; policy not removed")
    elif PCRLOCK_JSON.exists():
        log.warning("Leaving the systemd-pcrlock policy in place (use --remove-pcrlock to remove it)")

    if cfg is None:
        cfg = Config(luks_device=str(dev), luks_name=name)
    set_crypttab_tpm(dev, cfg, remove=True, dry_run=args.dry_run)

    remove_file(KERNEL_INSTALL_HOOK, args.dry_run)
    remove_file(INITRAMFS_HOOK, args.dry_run)
    remove_file(PACMAN_HOOK, args.dry_run)
    remove_tree(DRACUT_MODULE_DIR, args.dry_run)
    remove_file(DRACUT_CONF, args.dry_run)
    remove_file(Path("/usr/lib/dracut/dracut.conf.d/80-luksury.conf"), args.dry_run)
    remove_file(PCRLOCK_RUNTIME, args.dry_run)
    remove_tree(PCRLOCK_PRIVATE_COMPONENTS, args.dry_run)
    remove_file(BOOT_UPDATE_DROPIN, args.dry_run)
    if not args.dry_run and BOOT_UPDATE_DROPIN.parent.exists():
        try:
            BOOT_UPDATE_DROPIN.parent.rmdir()
        except OSError:
            pass
    daemon_reload(args.dry_run)

    if cfg.boot_mount:
        # luksury <= 2.0 wrote its own policy copy here.  Remove it on upgrade
        # or uninstall; 2.1 uses systemd-pcrlock's loader/credentials instead.
        legacy = (
            Path(cfg.boot_mount)
            / LEGACY_BOOT_POLICY_SUBDIR
            / LEGACY_BOOT_POLICY_NAME
        )
        remove_file(legacy, args.dry_run)
        # Remove the directory only if it is empty.
        if not args.dry_run and legacy.parent.exists():
            try:
                legacy.parent.rmdir()
            except OSError:
                pass

    remove_file(STATE_FILE, args.dry_run)
    if not args.dry_run and STATE_DIR.exists() and not any(STATE_DIR.iterdir()):
        try:
            STATE_DIR.rmdir()
        except OSError:
            pass
    remove_file(CONFIG_FILE, args.dry_run)
    if not args.dry_run and CONFIG_DIR.exists() and not any(CONFIG_DIR.iterdir()):
        try:
            CONFIG_DIR.rmdir()
        except OSError:
            pass

    if not args.keep_binary:
        src = Path(sys.argv[0])
        try:
            src = src.resolve()
        except OSError:
            src = Path("")
        if src != INSTALLED_BIN:
            remove_file(INSTALLED_BIN, args.dry_run)

    if args.rebuild_initramfs:
        regenerate_initramfs(
            Path(cfg.initrd) if cfg.initrd else None,
            cfg.kernel_version or os.uname().release,
            args.dry_run,
        )
    else:
        log.info(
            "Leaving the current initrd unchanged. It still contains the luksury hook "
            "until the next kernel/initrd rebuild; the hook is harmless because the "
            "TPM token is gone. Rebuild explicitly with --rebuild-initramfs if desired."
        )

    print(
        "luksury integration removed.  The LUKS passphrase/recovery key remain.\n"
        "If you migrated from the old luksury, separately remove its keyfile keyslot "
        "and TPM persistent object."
    )
    return 0


