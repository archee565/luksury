def pcrlock_supported() -> bool:
    binary = pcrlock_bin()
    if not binary:
        return False
    cp = run([binary, "is-supported"], capture=True, check=False)
    if cp.returncode != 0:
        log.info("systemd-pcrlock is not supported: %s", (cp.stdout or cp.stderr).strip())
        return False
    return cp.stdout.strip().lower() in ("yes", "true", "1")


def pcrlock_component_dir(component: str) -> Path:
    return PCRLOCK_COMPONENT_DIR / f"{component}.pcrlock.d"


_VARIANT_FILE_RE = re.compile(r"^(?:initrd|cmdline)-[0-9a-f]{16}\.pcrlock$")


def _write_pcrlock_variant(component: str, source: Path, dry_run: bool) -> Path:
    """Generate one pcrlock component variant and install it atomically."""
    binary = pcrlock_bin()
    if not binary:
        die("systemd-pcrlock was not found (install systemd >= 256)")

    prefix = "initrd" if component == PCRLOCK_INITRD_COMPONENT else "cmdline"
    verb = "lock-kernel-initrd" if prefix == "initrd" else "lock-kernel-cmdline"
    if not source.exists():
        die(f"{prefix} input not found: {source}")

    if prefix == "initrd":
        digest = sha256_file(source)
    else:
        text = source.read_text(encoding="utf-8", errors="replace").rstrip("\n")
        digest = hashlib.sha256(text.encode()).hexdigest()

    dest = pcrlock_component_dir(component) / f"{prefix}-{digest[:16]}.pcrlock"
    if dry_run:
        log.info("[dry-run] would write pcrlock %s variant %s from %s", prefix, dest, source)
        return dest
    if dest.exists():
        return dest

    d = dest.parent
    d.mkdir(parents=True, exist_ok=True)
    fd, tmpname = tempfile.mkstemp(prefix=f".{dest.name}.", dir=str(d))
    os.close(fd)
    tmp = Path(tmpname)
    try:
        run([binary, verb, f"--pcrlock={tmp}", str(source)])
        os.chmod(tmp, 0o644)
        os.replace(tmp, dest)
        os.sync()
    finally:
        tmp.unlink(missing_ok=True)

    log.info("Wrote pcrlock %s variant %s", prefix, dest)
    return dest


