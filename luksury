SECURE_BOOT_VAR_GUID = "8be4df61-93ca-11d2-aa0d-00e098032b8c"
LOADER_ENTRY_VAR_GUID = "4a67b082-0a4c-41cf-b6c7-440b29bb8c4f"


def _read_efi_variable_text(name: str) -> Optional[str]:
    """Read a UTF-16 UEFI variable from efivarfs, or return None."""
    path = Path(f"/sys/firmware/efi/efivars/{name}-{LOADER_ENTRY_VAR_GUID}")
    try:
        data = path.read_bytes()
    except OSError:
        return None
    if len(data) <= 4:
        return None
    payload = data[4:]
    try:
        text = payload.decode("utf-16-le")
    except UnicodeDecodeError:
        text = payload.decode("utf-8", errors="replace")
    return text.rstrip("\x00").strip().lstrip("\ufeff")


def loader_entry_from_efi(name: str) -> Optional[str]:
    """Return the entry ID stored in a systemd-boot LoaderEntry* variable."""
    value = _read_efi_variable_text(name)
    if not value or "/" in value or "\\" in value or value in (".", ".."):
        return None
    if value.endswith(".conf"):
        value = value[: -len(".conf")]
    return value or None


def _efi_variable_byte(name: str) -> Optional[int]:
    """Return the payload byte of a 1-byte UEFI variable, or None."""
    path = Path(f"/sys/firmware/efi/efivars/{name}-{SECURE_BOOT_VAR_GUID}")
    try:
        data = path.read_bytes()
    except OSError:
        return None
    # UEFI variables in efivarfs are 4 bytes of attributes followed by the data.
    if len(data) < 5:
        return None
    return data[4]


def secure_boot_state() -> tuple[Optional[bool], bool]:
    """Return (Secure Boot enabled, Setup Mode).

    ``None`` means the state could not be determined.  This is only used for
    warnings: luksury never refuses to run just because Secure Boot is off.
    """
    secure = _efi_variable_byte("SecureBoot")
    setup = _efi_variable_byte("SetupMode")
    if secure is not None:
        return bool(secure), bool(setup)

    # Fall back to bootctl for systems where efivarfs is not readable.
    bc = bootctl_bin()
    if bc:
        cp = run([bc, "status"], capture=True, check=False)
        for line in cp.stdout.splitlines():
            stripped = line.strip()
            if not stripped.startswith("Secure Boot:"):
                continue
            value = stripped.split(":", 1)[1].strip().lower()
            if value.startswith("enabled"):
                return True, False
            if value.startswith("disabled"):
                return False, "setup" in value
    return None, bool(setup)


def warn_if_secure_boot_disabled() -> None:
    enabled, setup_mode = secure_boot_state()
    if enabled is True:
        return
    if enabled is False:
        detail = " (Setup Mode)" if setup_mode else ""
        log.warning(
            "Secure Boot is disabled%s. Measured boot cannot anchor trust without "
            "Secure Boot: an attacker who controls the firmware or boot chain can "
            "forge PCR measurements, and the TPM policy only detects changes to the "
            "measurements it is given. Enable Secure Boot and sign the boot loader/"
            "kernel with keys you trust.",
            detail,
        )
    else:
        log.warning(
            "Cannot determine the Secure Boot state. Measured boot is only as strong "
            "as the boot chain; verify that Secure Boot is enabled if you rely on the "
            "TPM policy to resist a physical attacker."
        )


