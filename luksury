DRACUT_MODULE_DIR = Path("/usr/lib/dracut/modules.d/89luksury")
DRACUT_CONF = Path("/etc/dracut.conf.d/99-luksury.conf")
KERNEL_INSTALL_HOOK = Path("/etc/kernel/install.d/99-luksury.install")
INITRAMFS_HOOK = Path("/etc/initramfs/post-update.d/zzz-luksury")
PACMAN_HOOK = Path("/etc/pacman.d/hooks/99-luksury.hook")

PCRLOCK_JSON = Path("/var/lib/systemd/pcrlock.json")
PCRLOCK_RUNTIME = Path("/run/systemd/pcrlock.json")
PCRLOCK_COMPONENT_DIR = Path("/var/lib/pcrlock.d")
PCRLOCK_CMDLINE_COMPONENT = "710-kernel-cmdline"
PCRLOCK_INITRD_COMPONENT = "720-kernel-initrd"
BOOT_POLICY_SUBDIR = "luksury"
BOOT_POLICY_NAME = "pcrlock.json"

# Stop pcrlock's component list after 720-kernel-initrd.  Components from
# 750- onwards (750-enter-initrd, 750-os-separator, 770-nvpcr-separator, ...)
# are only measured on measured-OS/UKI boots.  luksury targets classic
# systemd-boot, where systemd-pcrosseparator.service and friends have
# ConditionSecurity=measured-os and never run.  Including those components
# makes pcrlock drop PCR 9 because it cannot find them in the event log.
# The value must sort after 720 and before 750.
DEFAULT_PCRLOCK_LOCATION = "740"

DEFAULT_PCRLOCK_PCRS = [7, 9]
DEFAULT_LITERAL_PCRS = [7, 9, 12]

log = logging.getLogger(PROG)


# ---------------------------------------------------------------------------
# Errors and small utilities
