class LuksuryError(Exception):
    """A user-visible error."""


class CommandError(LuksuryError):
    def __init__(self, cmd: Sequence[str], rc: int, stdout: str = "", stderr: str = ""):
        self.cmd = list(cmd)
        self.rc = rc
        self.stdout = stdout
        self.stderr = stderr
        detail = (stderr or stdout or "").strip()
        msg = f"command failed ({rc}): {shlex.join(self.cmd)}"
        if detail:
            msg += f"\n{detail}"
        super().__init__(msg)


def eprint(*args: Any, **kwargs: Any) -> None:
    print(*args, file=sys.stderr, **kwargs)


def die(msg: str, rc: int = 1) -> "None":
    raise LuksuryError(msg)


def which(*names: str, fallbacks: Iterable[str] = ()) -> Optional[str]:
    for name in names:
        found = shutil.which(name)
        if found:
            return found
    for path in fallbacks:
        if Path(path).is_file():
            return path
    return None


def pcrlock_bin() -> Optional[str]:
    return which(
        "systemd-pcrlock",
        fallbacks=("/usr/lib/systemd/systemd-pcrlock", "/lib/systemd/systemd-pcrlock"),
    )


def cryptenroll_bin() -> str:
    found = which("systemd-cryptenroll", fallbacks=("/usr/bin/systemd-cryptenroll",))
    if not found:
        die("systemd-cryptenroll was not found (install systemd >= 248)")
    return found


def cryptsetup_bin() -> str:
    found = which("cryptsetup", fallbacks=("/usr/sbin/cryptsetup", "/sbin/cryptsetup"))
    if not found:
        die("cryptsetup was not found")
    return found


def cryptsetup_setup_bin() -> str:
    found = which(
        "systemd-cryptsetup",
        fallbacks=("/usr/bin/systemd-cryptsetup", "/usr/lib/systemd/systemd-cryptsetup"),
    )
    if not found:
        die("systemd-cryptsetup was not found (install systemd)")
    return found


def bootctl_bin() -> Optional[str]:
    return which("bootctl", fallbacks=("/usr/bin/bootctl",))


def systemd_boot_active() -> bool:
    bc = bootctl_bin()
    if not bc:
        return False
    cp = run([bc, "status"], capture=True, check=False)
    return cp.returncode == 0 and "Product: systemd-boot" in cp.stdout


def kernel_install_bin() -> Optional[str]:
    return which("kernel-install", fallbacks=("/usr/bin/kernel-install", "/usr/lib/systemd/kernel-install"))


def dracut_bin() -> Optional[str]:
    return which("dracut", fallbacks=("/usr/bin/dracut", "/usr/sbin/dracut"))


def update_initramfs_bin() -> Optional[str]:
    return which("update-initramfs", fallbacks=("/usr/sbin/update-initramfs",))


def mkinitcpio_bin() -> Optional[str]:
    return which("mkinitcpio", fallbacks=("/usr/bin/mkinitcpio",))


def require_root() -> None:
    if os.geteuid() != 0:
        die("this operation must be run as root")


def confirm(question: str, yes: bool = False) -> bool:
    if yes:
        return True
    if not sys.stdin.isatty():
        return False
    while True:
        answer = input(f"{question} [y/N] ").strip().lower()
        if answer in ("y", "yes"):
            return True
        if answer in ("", "n", "no"):
            return False


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def atomic_write(path: Path, data: str | bytes, mode: int = 0o644, dry_run: bool = False) -> None:
    if dry_run:
        log.info("[dry-run] would write %s", path)
        return
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    raw = data.encode() if isinstance(data, str) else data
    fd, tmpname = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    tmp = Path(tmpname)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(raw)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
        os.sync()
    finally:
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass


def backup_file(path: Path, dry_run: bool = False) -> Optional[Path]:
    path = Path(path)
    if not path.exists():
        return None
    stamp = _dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    backup = path.with_name(f"{path.name}.luksury-bak.{stamp}")
    if dry_run:
        log.info("[dry-run] would back up %s to %s", path, backup)
        return backup
    shutil.copy2(path, backup)
    log.info("Backed up %s to %s", path, backup)
    return backup


def remove_file(path: Path, dry_run: bool = False) -> None:
    path = Path(path)
    if not path.exists():
        return
    if dry_run:
        log.info("[dry-run] would remove %s", path)
        return
    path.unlink()
    log.info("Removed %s", path)


def remove_tree(path: Path, dry_run: bool = False) -> None:
    path = Path(path)
    if not path.exists():
        return
    if dry_run:
        log.info("[dry-run] would remove directory %s", path)
        return
    shutil.rmtree(path)
    log.info("Removed directory %s", path)


def run(
    cmd: Sequence[str],
    *,
    capture: bool = False,
    check: bool = True,
    dry_run: bool = False,
    input_text: Optional[str] = None,
    timeout: Optional[float] = None,
    stdin_devnull: bool = False,
    env: Optional[dict[str, str]] = None,
) -> subprocess.CompletedProcess[str]:
    cmd = [str(c) for c in cmd]
    if dry_run:
        log.info("[dry-run] %s", shlex.join(cmd))
        return subprocess.CompletedProcess(cmd, 0, "", "")

    log.debug("Running: %s", shlex.join(cmd))
    kwargs: dict[str, Any] = {
        "text": True,
        "capture_output": capture,
        "input": input_text,
        "timeout": timeout,
        "env": env,
    }
    if stdin_devnull:
        kwargs["stdin"] = subprocess.DEVNULL
    try:
        cp = subprocess.run(cmd, check=False, **kwargs)  # noqa: S603 - argv list, no shell
    except subprocess.TimeoutExpired as exc:
        stdout = exc.stdout or ""
        stderr = exc.stderr or ""
        if isinstance(stdout, bytes):
            stdout = stdout.decode(errors="replace")
        if isinstance(stderr, bytes):
            stderr = stderr.decode(errors="replace")
        timeout_msg = f"command timed out after {timeout}s"
        detail = "\n".join(part for part in (timeout_msg, stderr.strip()) if part)
        cp = subprocess.CompletedProcess(cmd, 124, stdout, detail)
    if check and cp.returncode != 0:
        raise CommandError(cmd, cp.returncode, cp.stdout or "", cp.stderr or "")
    return cp


def run_capture(cmd: Sequence[str], *, check: bool = True, dry_run: bool = False) -> str:
    return run(cmd, capture=True, check=check, dry_run=dry_run).stdout.strip()


