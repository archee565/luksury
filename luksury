# Ingestion of trusted boot artifacts
# ---------------------------------------------------------------------------


def _lock_record(
    verb: str,
    source: Path,
    *,
    pcr: int,
    extra: Sequence[str] = (),
) -> dict[str, Any]:
    """Run a systemd-pcrlock lock-* verb and return its digest record."""
    binary = pcrlock_bin()
    if not binary:
        die("systemd-pcrlock was not found (install systemd >= 256)")
    if not Path(source).exists():
        die(f"cannot lock {source}: file not found")

    fd, name = tempfile.mkstemp(prefix="luksury-lock-", suffix=".pcrlock")
    os.close(fd)
    tmp = Path(name)
    try:
        run([binary, verb, *extra, f"--pcrlock={tmp}", str(source)])
        try:
            data = json.loads(tmp.read_text(encoding="utf-8"))
        except (OSError, ValueError) as exc:
            die(f"cannot parse the pcrlock output for {source}: {exc}")
        records = data.get("records")
        if not isinstance(records, list) or not records:
            die(f"systemd-pcrlock {verb} returned no records for {source}")
        for record in records:
            if not isinstance(record, dict):
                continue
            if record.get("pcr") == pcr:
                return _slim_record(record)
        die(f"systemd-pcrlock {verb} did not produce a PCR {pcr} record for {source}")
    finally:
        tmp.unlink(missing_ok=True)


def lock_pe_record(pe: Path) -> dict[str, Any]:
    return _lock_record("lock-pe", pe, pcr=4, extra=["--pcr=4"])


def lock_initrd_record(image: Path) -> dict[str, Any]:
    return _lock_record("lock-kernel-initrd", image, pcr=9)


def lock_cmdline_record(path: Path) -> dict[str, Any]:
    return _lock_record("lock-kernel-cmdline", path, pcr=9)


def _md5_file(path: Path) -> str:
    digest = hashlib.md5()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _dpkg_md5_for_kernel(version: str) -> Optional[str]:
    """Find the dpkg-recorded MD5 of the kernel image for *version*."""
    names = {f"boot/vmlinuz-{version}", f"boot/vmlinux-{version}", f"boot/Image-{version}"}
    info_dir = Path("/var/lib/dpkg/info")
    if not info_dir.is_dir():
        return None
    for path in sorted(info_dir.glob("linux-image-*.md5sums")):
        try:
            lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
        except OSError:
            continue
        for line in lines:
            match = re.match(r"^([0-9a-fA-F]{32})\s+(?:\./)?(\S+)$", line)
            if not match:
                continue
            if match.group(2) in names:
                return match.group(1).lower()
    return None


def resolve_kernel_source(
    version: str,
    cfg: Optional[Config] = None,
    hint: Optional[Path] = None,
) -> Path:
    """Return a kernel image whose bytes are trusted enough to hash once.

    Root-filesystem module directories are accepted directly.  A kernel in
    /boot is accepted only when it matches the MD5 recorded by dpkg.  The ESP
    is never accepted.
    """
    candidates: list[Path] = []
    if hint is not None:
        candidates.append(Path(hint))
    candidates.extend(
        [
            Path(f"/usr/lib/modules/{version}/vmlinuz"),
            Path(f"/usr/lib/modules/{version}/vmlinux"),
            Path(f"/usr/lib/modules/{version}/Image"),
            Path(f"/lib/modules/{version}/vmlinuz"),
            Path(f"/lib/modules/{version}/vmlinux"),
            Path(f"/lib/modules/{version}/Image"),
            Path(f"/boot/vmlinuz-{version}"),
            Path(f"/boot/vmlinux-{version}"),
        ]
    )

    expected_md5 = _dpkg_md5_for_kernel(version)
    seen: set[Path] = set()
    for candidate in candidates:
        try:
            resolved = candidate.resolve()
        except OSError:
            resolved = candidate
        if resolved in seen:
            continue
        seen.add(resolved)
        if not resolved.is_file():
            continue
        if cfg is not None:
            assert_not_boot_partition(resolved, cfg, "kernel image")
        if str(resolved).startswith(("/usr/lib/modules/", "/lib/modules/")):
            return resolved
        if expected_md5 is None:
            log.warning(
                "kernel %s has no dpkg MD5 record; not trusting it for PCR prediction",
                resolved,
            )
            continue
        try:
            actual = _md5_file(resolved)
        except OSError as exc:
            log.warning("cannot read kernel image %s: %s", resolved, exc)
            continue
        if actual != expected_md5:
            log.warning(
                "kernel %s does not match its dpkg MD5 (expected %s, got %s)",
                resolved,
                expected_md5,
                actual,
            )
            continue
        log.info("Verified kernel %s against its dpkg MD5", resolved)
        return resolved

    detail = f" (expected dpkg MD5 {expected_md5})" if expected_md5 else " (no dpkg MD5 record)"
    die(
        f"cannot find a verifiable kernel image for version {version}{detail}. "
        "Install the matching linux-image package or provide a root-filesystem "
        "kernel under /usr/lib/modules."
    )


def kernel_entry_token() -> str:
    token_file = Path("/etc/kernel/entry-token")
    for source in (token_file, Path("/etc/machine-id")):
        try:
            value = source.read_text(encoding="utf-8", errors="replace").strip()
        except OSError:
            continue
        if value and "/" not in value and value not in (".", ".."):
            return value
    die("cannot determine the kernel entry token (/etc/kernel/entry-token or /etc/machine-id)")


def target_initrd_basename(version: str) -> str:
    return f"initrd.img-{version}"


def target_initrd_path(boot: BootPartition, version: str) -> Path:
    return boot.mount / kernel_entry_token() / version / target_initrd_basename(version)


def target_initrd_source_path(version: str) -> Path:
    return Path("/boot") / target_initrd_basename(version)


def generate_initrd_temp(version: str, dry_run: bool = False) -> Path:
    """Generate a fresh initrd on the encrypted root, for one-time ingestion."""
    dracut = dracut_bin()
    if not dracut:
        die("dracut is required to generate the initrd for PCR prediction")
    if dry_run:
        log.info("[dry-run] would generate an initrd for %s with %s", version, dracut)
        return Path(f"/var/lib/luksury/.dry-run-initrd-{version}")
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=f".initrd-{version}.", suffix=".img", dir=str(STATE_DIR))
    os.close(fd)
    tmp = Path(name)
    try:
        run([dracut, "-f", str(tmp), version])
        if not tmp.is_file() or tmp.stat().st_size == 0:
            die(f"dracut did not produce an initrd for {version}")
        return tmp
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def _copy_file_atomic(source: Path, destination: Path, mode: int = 0o600) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=f".{destination.name}.", dir=str(destination.parent))
    tmp = Path(name)
    try:
        with os.fdopen(fd, "wb") as out, source.open("rb") as src:
            shutil.copyfileobj(src, out, length=1024 * 1024)
            out.flush()
            os.fsync(out.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, destination)
        os.sync()
    finally:
        tmp.unlink(missing_ok=True)


def install_initrd(temp: Path, version: str, boot: BootPartition, dry_run: bool = False) -> None:
    """Install the generated initrd to /boot and to the boot-entry path.

    This is an installation step only.  Prediction uses the digest record that
    was produced from ``temp`` before it is copied.
    """
    targets = [target_initrd_source_path(version), target_initrd_path(boot, version)]
    for target in targets:
        if dry_run:
            log.info("[dry-run] would install initrd %s to %s", temp, target)
            continue
        _copy_file_atomic(temp, target, 0o600)
        if sha256_file(target) != sha256_file(temp):
            die(f"initrd copy verification failed for {target}")
    if not dry_run:
        log.info("Installed initrd for %s to %s", version, ", ".join(str(t) for t in targets))


def trusted_cmdline(
    args: argparse.Namespace,
    cfg: Config,
    version: str,
) -> tuple[str, str]:
    """Return (full measured cmdline, options without initrd=)."""
    source: Optional[Path] = None
    if getattr(args, "cmdline", None) is not None:
        source = Path(args.cmdline)
        assert_not_boot_partition(source, cfg, "cmdline")
    elif Path("/etc/kernel/cmdline").is_file():
        source = Path("/etc/kernel/cmdline")
    else:
        source = Path("/proc/cmdline")

    try:
        text = source.read_text(encoding="utf-8", errors="replace").strip()
    except OSError as exc:
        die(f"cannot read the kernel command line from {source}: {exc}")
    text = " ".join(
        line.strip()
        for line in text.splitlines()
        if line.strip() and not line.lstrip().startswith("#")
    )
    if not text:
        die(f"the kernel command line source {source} is empty")

    options = " ".join(
        token
        for token in text.split()
        if not token.startswith(("initrd=", "BOOT_IMAGE="))
    )

    # kernel-install appends systemd.machine_id= when the entry token is the
    # machine ID.  A cmdline config file usually does not contain it.
    if source != Path("/proc/cmdline"):
        token = kernel_entry_token()
        try:
            machine_id = Path("/etc/machine-id").read_text(encoding="utf-8").strip()
        except OSError:
            machine_id = ""
        if token and token == machine_id and not any(
            item.startswith("systemd.machine_id=") for item in options.split()
        ):
            options = f"{options} systemd.machine_id={token}".strip()

    full = options
    if cmdline_has_initrd(read_running_cmdline()):
        uefi = uefi_path(
            f"/{kernel_entry_token()}/{version}/{target_initrd_basename(version)}"
        )
        full = f"initrd={uefi} {options}".strip()
    return filter_cmdline(full), options


def _entry_path_within_boot(path: Path, boot: BootPartition) -> Path:
    """Resolve a boot-entry path and reject anything outside the boot mount."""
    try:
        resolved = path.resolve()
    except OSError as exc:
        die(f"cannot resolve boot entry path {path}: {exc}")
    try:
        resolved.relative_to(boot.mount.resolve())
    except ValueError:
        die(
            f"boot entry path {path} resolves outside the boot partition "
            f"({boot.mount}); refusing to trust it"
        )
    return resolved


def _verify_boot_entry(
    entry: BootEntry,
    boot: BootPartition,
    *,
    expected_spec: str,
    expected_basename: str,
    expected_options: str,
    store: Optional[dict[str, Any]],
    kernel_cache: dict[Path, Optional[str]],
) -> None:
    if entry.kernel is None:
        die(f"the boot entry {entry.path} has no linux line; refusing to continue")
    kernel = _entry_path_within_boot(entry.kernel, boot)
    if not kernel.is_file():
        die(f"the boot entry {entry.path} points to a missing kernel {kernel}")
    if store is not None:
        if kernel not in kernel_cache:
            try:
                record = lock_pe_record(kernel)
            except LuksuryError as exc:
                die(
                    f"cannot verify the kernel {kernel} referenced by {entry.path}: {exc}"
                )
            kernel_cache[kernel] = store_match(store, "kernel", record)
        if kernel_cache[kernel] is None:
            die(
                f"the kernel {kernel} referenced by {entry.path} is not a trusted "
                "kernel in the hash store; refusing to predict an ESP-controlled "
                "kernel"
            )

    specs = [
        spec if spec.startswith("/") else "/" + spec for spec in entry.initrd_specs
    ]
    if specs != [expected_spec]:
        die(
            f"the installed entry {entry.path} uses initrd files {specs}, but luksury "
            f"installed {expected_spec!r}. Refusing to continue: the predicted "
            "initrd would not be the one the boot loader measures."
        )
    if Path(expected_spec).name != expected_basename:
        die(
            f"internal error: expected initrd basename {expected_basename!r} does not "
            f"match the installed path {expected_spec!r}"
        )
    actual_options = cmdline_options(entry.options)
    if actual_options != cmdline_options(expected_options):
        die(
            f"the installed entry {entry.path} has options {entry.options!r}, but the "
            f"trusted command line is {expected_options!r}. Refusing to predict an "
            "ESP-controlled command line."
        )


def verify_installed_entry(
    cfg: Config,
    boot: BootPartition,
    version: str,
    expected_basename: str,
    expected_options: str,
    store: Optional[dict[str, Any]] = None,
    dry_run: bool = False,
) -> None:
    """Check the installed ESP entries against trusted expectations.

    The actual default entry is resolved (including @saved/@current through the
    systemd-boot EFI variables), every entry for the target kernel is checked,
    and the kernel named by each entry must be present in the trusted hash
    store.  The entry is only used for verification; it is never used to build
    the predicted command line or to locate the files that are hashed.
    """
    if dry_run:
        log.info("[dry-run] would verify the installed boot entry for %s", version)
        return
    default_entry = find_default_entry(boot, strict_default=True)
    target_entries = find_entries_for_kernel(boot, version)
    if not target_entries:
        die(
            f"no installed boot entry found for kernel {version}; refusing to "
            "predict an entry that the boot loader will not use"
        )
    default_path = default_entry.path.resolve()
    if default_path not in {entry.path.resolve() for entry in target_entries}:
        die(
            f"the default boot entry {default_entry.path} is not for kernel "
            f"{version}; the next boot would not use the policy target. Set the "
            "default entry to the installed kernel entry and retry."
        )

    expected_path = target_initrd_path(boot, version)
    try:
        expected_spec = "/" + str(expected_path.relative_to(boot.mount))
    except ValueError:
        expected_spec = str(expected_path)

    kernel_cache: dict[Path, Optional[str]] = {}
    for entry in target_entries:
        _verify_boot_entry(
            entry,
            boot,
            expected_spec=expected_spec,
            expected_basename=expected_basename,
            expected_options=expected_options,
            store=store,
            kernel_cache=kernel_cache,
        )


def ingest_running_kernel(store: dict[str, Any], cfg: Config, dry_run: bool = False) -> Optional[str]:
    """Best-effort ingestion of the running kernel from a verified source."""
    version = os.uname().release
    try:
        source = resolve_kernel_source(version, cfg)
    except LuksuryError as exc:
        log.debug("cannot ingest the running kernel: %s", exc)
        return None
    if dry_run:
        log.info("[dry-run] would ingest running kernel %s", source)
        return None
    record = lock_pe_record(source)
    key = store_add(store, "kernel", record, "dpkg-md5+lock-pe")
    log.info("Ingested running kernel %s (PCR 4 %s)", source, key[:16])
    return key


def bootloader_source_paths(cfg: Config) -> list[Path]:
    """Trusted root-filesystem boot loader PEs, never the installed ESP copies."""
    arch = _efi_architecture()
    candidates = [
        Path(f"/usr/lib/systemd/boot/efi/systemd-boot{arch}.efi"),
        Path(f"/usr/lib/systemd/boot/efi/systemd-boot-fallback{arch}.efi"),
        Path(f"/usr/lib/shim/shim{arch}.efi.signed"),
        Path(f"/usr/lib/shim/shim{arch}.efi"),
    ]
    for raw in cfg.bootloader_pes:
        candidate = Path(raw)
        assert_not_boot_partition(candidate, cfg, "boot loader PE")
        candidates.append(candidate)

    result: list[Path] = []
    seen: set[Path] = set()
    for candidate in candidates:
        try:
            resolved = candidate.resolve()
        except OSError:
            resolved = candidate
        if resolved in seen or not resolved.is_file():
            continue
        seen.add(resolved)
        result.append(resolved)
    return result


def ingest_bootloaders(store: dict[str, Any], cfg: Config, dry_run: bool = False) -> list[tuple[Path, dict[str, Any]]]:
    result: list[tuple[Path, dict[str, Any]]] = []
    for source in bootloader_source_paths(cfg):
        if dry_run:
            log.info("[dry-run] would ingest boot loader PE %s", source)
            continue
        try:
            record = lock_pe_record(source)
        except LuksuryError as exc:
            log.warning("cannot lock boot loader PE %s: %s", source, exc)
            continue
        key = store_add(store, "bootloader", record, str(source))
        log.info("Ingested boot loader PE %s (PCR 4 %s)", source, key[:16])
        result.append((source, record))
    if not result and not dry_run:
        die("no trusted boot loader PE could be ingested; refusing to predict PCR 4")
    return result


def installed_bootloader_record(
    cfg: Config,
    boot: BootPartition,
    ingested: Sequence[tuple[Path, dict[str, Any]]],
) -> dict[str, Any]:
    """Pick the trusted PE record matching the installed systemd-boot binary."""
    arch = _efi_architecture()
    installed: Optional[Path] = None
    bc = bootctl_bin()
    if bc:
        cp = run([bc, "--print-loader-path"], capture=True, check=False)
        if cp.returncode == 0 and cp.stdout.strip():
            candidate = Path(cp.stdout.strip())
            if candidate.is_file():
                installed = candidate
    if installed is None:
        installed = boot.mount / "EFI" / "systemd" / f"systemd-boot{arch}.efi"
    if not installed.is_file():
        die(
            f"cannot find the installed systemd-boot binary at {installed}; refusing "
            "to guess which boot loader PE will be measured"
        )
    installed_hash = sha256_file(installed)
    for source, record in ingested:
        if sha256_file(source) == installed_hash:
            return record
    die(
        f"the installed boot loader {installed} does not match any trusted "
        "root-filesystem PE; refusing to lock an ESP-controlled boot loader"
    )


def _record_strings(record: dict[str, Any]) -> list[str]:
    result: list[str] = []

    def walk(value: Any) -> None:
        if isinstance(value, str):
            result.append(value)
        elif isinstance(value, dict):
            for item in value.values():
                walk(item)
        elif isinstance(value, list):
            for item in value:
                walk(item)

    walk(record.get("content"))
    return result


def pcr9_running_records(cel: Sequence[dict[str, Any]]) -> tuple[dict[str, Any], dict[str, Any]]:
    """Return (cmdline record, initrd record) from the running event log."""
    records = [record for record in cel if record.get("pcr") == 9]
    cmdline: Optional[dict[str, Any]] = None
    initrd: Optional[dict[str, Any]] = None
    for record in records:
        description = " ".join(_record_strings(record)).lower()
        if "cmdline" in description or "command line" in description:
            cmdline = record
        elif "initrd" in description:
            initrd = record
    if cmdline is None or initrd is None:
        if len(records) == 2:
            # The kernel measures the command line first, then the initrd.
            cmdline, initrd = records
            log.warning(
                "could not identify the PCR 9 records by description; using event order"
            )
        else:
            die(
                "cannot identify the running kernel command line and initrd "
                f"in PCR 9 (found {len(records)} records); refusing to predict PCR 9"
            )
    return _slim_record(cmdline), _slim_record(initrd)


def _bsa_records(records: Sequence[dict[str, Any]]) -> list[tuple[int, dict[str, Any]]]:
    result: list[tuple[int, dict[str, Any]]] = []
    for index, record in enumerate(records):
        if record.get("content_type") != "pcclient_std":
            continue
        content = record.get("content")
        if not isinstance(content, dict):
            continue
        event_type = content.get("event_type")
        if isinstance(event_type, str) and event_type.upper() == "EV_EFI_BOOT_SERVICES_APPLICATION":
            result.append((index, record))
    return result


def _match_store_records(
    records: Sequence[dict[str, Any]],
    store: dict[str, Any],
    kind: str,
) -> list[tuple[int, str]]:
    result: list[tuple[int, str]] = []
    for index, record in _bsa_records(records):
        key = store_match(store, kind, record)
        if key is not None:
            result.append((index, key))
    return result


def _pcr4_variants(
    records: list[dict[str, Any]],
    store: dict[str, Any],
    target_kernel_record: dict[str, Any],
    target_bootloader_records: Sequence[dict[str, Any]] = (),
) -> list[tuple[str, list[dict[str, Any]]]]:
    """Build the running variant and the target-boot variants.

    The kernel must be measured.  Its boot-services record is identified by
    looking up the measured digest in the trusted hash store, not by reading a
    path from the ESP or the event log.
    """
    slim = _slim_pcr4_records(records)
    kernel_hits = _match_store_records(records, store, "kernel")
    bootloader_hits = _match_store_records(records, store, "bootloader")

    if len(kernel_hits) != 1:
        measured = ", ".join(
            _digest_map(record).get("sha256", "?")[:16] for _, record in _bsa_records(records)
        ) or "none"
        die(
            "the running kernel is not measured in the TPM event log, or its "
            "measurement does not match the trusted hash store "
            f"(boot-services records: {measured}). Refusing to build a policy "
            "that does not bind the kernel."
        )
    kernel_index, _ = kernel_hits[0]

    if len(bootloader_hits) != 1:
        measured = ", ".join(
            _digest_map(record).get("sha256", "?")[:16] for _, record in _bsa_records(records)
        ) or "none"
        die(
            "the running boot loader is not measured in the TPM event log, or its "
            "measurement does not match exactly one trusted boot loader PE in the "
            f"hash store (boot-services records: {measured}). Refusing to lock an "
            "ESP-controlled boot loader."
        )
    bootloader_index = bootloader_hits[0][0]

    variants: list[tuple[str, list[dict[str, Any]]]] = [("running", slim)]
    kernel_sha = _digest_map(target_kernel_record).get("sha256", "unknown")[:8]

    targets: list[tuple[str, Optional[dict[str, Any]]]] = [("", None)]
    if target_bootloader_records:
        targets = [
            (_digest_map(record).get("sha256", "unknown")[:8], record)
            for record in target_bootloader_records
        ]

    for boot_sha, bootloader_record in targets:
        target = [
            {"pcr": record["pcr"], "digests": [dict(item) for item in record["digests"]]}
            for record in slim
        ]
        target[kernel_index]["digests"] = [
            dict(item) for item in target_kernel_record["digests"]
        ]
        if bootloader_record is not None and bootloader_index is not None:
            target[bootloader_index]["digests"] = [
                dict(item) for item in bootloader_record["digests"]
            ]
        name = f"target-kernel-{kernel_sha}"
        if bootloader_record is not None:
            name += f"-pe-{boot_sha}"
        variants.append((name, target))

    # Drop variants that are identical to an earlier one.
    deduped: list[tuple[str, list[dict[str, Any]]]] = []
    seen: set[str] = set()
    for variant_name, variant_records in variants:
        key = json.dumps(variant_records, sort_keys=True)
        if key in seen:
            continue
        seen.add(key)
        deduped.append((variant_name, variant_records))
    return deduped


def _write_component_record(root: Path, component: str, name: str, record: dict[str, Any]) -> Path:
    directory = root / f"{component}.pcrlock.d"
    directory.mkdir(parents=True, exist_ok=True)
    destination = directory / f"{name}.pcrlock"
    destination.write_text(
        json.dumps({"records": [record]}, indent=2) + "\n", encoding="utf-8"
    )
    os.chmod(destination, 0o644)
    return destination


def _component_name(prefix: str, record: dict[str, Any]) -> str:
    digest = _digest_map(record).get("sha256")
    if not digest:
        die(f"cannot name a {prefix} component without a SHA-256 digest")
    return f"{prefix}-{digest[:16]}"


_BOOTLOADER_VARIANT_RE = re.compile(r"^pe-[0-9a-f]{16}\.pcrlock$")


def _efi_architecture() -> str:
    bc = bootctl_bin()
    if bc:
        cp = run([bc, "--print-efi-architecture"], capture=True, check=False)
        if cp.returncode == 0 and cp.stdout.strip():
            return cp.stdout.strip()
    return "x64"


def _current_efi_boot_pe(boot: BootPartition) -> Optional[Path]:
    """Best-effort path of the PE binary firmware loaded for this boot."""
    eb = efibootmgr_bin()
    if not eb:
        return None
    cp = run([eb, "-v"], capture=True, check=False)
    if cp.returncode != 0:
        return None

    current: Optional[str] = None
    entries: dict[str, str] = {}
    for line in cp.stdout.splitlines():
        match = re.match(r"^BootCurrent:\s*([0-9A-Fa-f]{4})", line)
        if match:
            current = match.group(1).upper()
            continue
        match = re.match(r"^Boot([0-9A-Fa-f]{4})\*?\s+(.*)$", line)
        if match:
            entries[match.group(1).upper()] = match.group(2)
    if not current or current not in entries:
        return None

    match = re.search(r"(/\\[^\s]+?\.efi)", entries[current], re.IGNORECASE)
    if not match:
        return None
    rel = match.group(1).replace("\\", "/").lstrip("/")
    candidate = boot.mount / rel
    return candidate if candidate.is_file() else None


def find_bootloader_pe_paths(cfg: Config) -> list[Path]:
    """Return the PE binaries whose measurements PCR 4 should cover."""
    boot = BootPartition(
        mount=Path(cfg.boot_mount),
        uuid=cfg.boot_uuid,
        fstype=cfg.boot_fstype,
        device=cfg.boot_device,
    )
    candidates: list[Path] = []

    bc = bootctl_bin()
    if bc:
        cp = run([bc, "--print-loader-path"], capture=True, check=False)
        if cp.returncode == 0 and cp.stdout.strip():
            candidates.append(Path(cp.stdout.strip()))

    current = _current_efi_boot_pe(boot)
    if current is not None:
        candidates.append(current)

    arch = _efi_architecture()
    for rel in (
        f"EFI/systemd/systemd-boot{arch}.efi",
        f"EFI/systemd/systemd-boot-fallback{arch}.efi",
        f"EFI/BOOT/BOOT{arch.upper()}.EFI",
    ):
        candidate = boot.mount / rel
        if candidate.is_file():
            candidates.append(candidate)

    for raw in cfg.bootloader_pes:
        candidate = Path(raw)
        if candidate.is_file():
            candidates.append(candidate)
        else:
            log.warning("configured boot loader PE not found: %s", candidate)

    result: list[Path] = []
    seen_hashes: set[str] = set()
    for candidate in candidates:
        try:
            resolved = candidate.resolve()
        except OSError:
            resolved = candidate
        if not resolved.is_file():
            continue
        try:
            digest = sha256_file(resolved)
        except OSError as exc:
            log.warning("cannot read boot loader PE %s: %s", resolved, exc)
            continue
        if digest in seen_hashes:
            continue
        seen_hashes.add(digest)
        result.append(resolved)

    if not result:
        log.warning(
            "no boot loader PE files found; PCR 4 will not be included in the policy"
        )
    return result


def pe_variant_path(pe: Path) -> Path:
    digest = sha256_file(pe)
    return pcrlock_component_dir(PCRLOCK_BOOTLOADER_COMPONENT) / f"pe-{digest[:16]}.pcrlock"


def _write_pe_variant(pe: Path, dry_run: bool) -> Path:
    """Generate one PCR 4 boot loader variant and install it atomically."""
    binary = pcrlock_bin()
    if not binary:
        die("systemd-pcrlock was not found (install systemd >= 256)")
    if not pe.is_file():
        die(f"boot loader PE not found: {pe}")

    dest = pe_variant_path(pe)
    if dry_run:
        log.info("[dry-run] would write pcrlock boot loader variant %s from %s", dest, pe)
        return dest
    if dest.exists():
        return dest

    d = dest.parent
    d.mkdir(parents=True, exist_ok=True)
    fd, tmpname = tempfile.mkstemp(prefix=f".{dest.name}.", dir=str(d))
    os.close(fd)
    tmp = Path(tmpname)
    try:
        run([binary, "lock-pe", "--pcr=4", f"--pcrlock={tmp}", str(pe)])
        os.chmod(tmp, 0o644)
        os.replace(tmp, dest)
        os.sync()
    finally:
        tmp.unlink(missing_ok=True)

    log.info("Wrote pcrlock boot loader variant %s", dest)
    return dest


def _pcrlock_digest_map(record: dict[str, Any]) -> dict[str, str]:
    """Return {hash algorithm: lower-case hex digest} for a CEL/.pcrlock record."""
    digests: dict[str, str] = {}
    for item in record.get("digests", []):
        if not isinstance(item, dict):
            continue
        alg = item.get("hashAlg")
        digest = item.get("digest")
        if isinstance(alg, str) and isinstance(digest, str):
            digests[alg.lower()] = digest.lower()
    return digests


def _pcrlock_record_list(path: Path) -> Optional[list[dict[str, Any]]]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    records = data.get("records")
    if not isinstance(records, list):
        return None
    return [r for r in records if isinstance(r, dict)]


def _pcrlock_cel_records(binary: str) -> Optional[list[dict[str, Any]]]:
    """Read the combined TPM event log as TCG CEL-JSON.

    `systemd-pcrlock cel` reads the firmware event log and the userspace log
    without requiring a valid component set, which is exactly what we need to
    build components for PCR 4.
    """
    cp = run([binary, "cel", "--json=short"], capture=True, check=False)
    if cp.returncode != 0:
        detail = (cp.stderr or cp.stdout or "").strip()
        log.warning("systemd-pcrlock cel failed: %s", detail or f"exit status {cp.returncode}")
        return None
    try:
        data = json.loads(cp.stdout)
    except ValueError as exc:
        log.warning("cannot parse systemd-pcrlock cel output: %s", exc)
        return None
    if not isinstance(data, list):
        log.warning("systemd-pcrlock cel did not return a JSON array")
        return None
    return [r for r in data if isinstance(r, dict)]


def _tpm_pcr_value(pcr: int, algorithm: str = "sha256") -> Optional[str]:
    for path in (
        Path(f"/sys/class/tpm/tpm0/pcr-{algorithm}/{pcr}"),
        Path(f"/sys/class/tpm/tpm0/pcr-{algorithm.upper()}/{pcr}"),
    ):
        try:
            value = path.read_text(encoding="ascii").strip().lower()
        except OSError:
            continue
        if re.fullmatch(r"[0-9a-f]+", value):
            return value
    return None


def _extend_records(
    records: list[dict[str, Any]], algorithm: str = "sha256"
) -> Optional[str]:
    """Replay measurement records exactly as the TPM would, returning hex."""
    try:
        size = hashlib.new(algorithm).digest_size
    except ValueError:
        return None
    value = b"\0" * size
    for record in records:
        digest = _pcrlock_digest_map(record).get(algorithm)
        if digest is None:
            return None
        try:
            raw = bytes.fromhex(digest)
        except ValueError:
            return None
        if len(raw) != size:
            return None
        value = hashlib.new(algorithm, value + raw).digest()
    return value.hex()


def _pcr4_extend(records: list[dict[str, Any]], algorithm: str = "sha256") -> Optional[str]:
    return _extend_records(records, algorithm)


def _pcr4_records(cel: list[dict[str, Any]]) -> list[dict[str, Any]]:
    return [record for record in cel if record.get("pcr") == 4]


def _slim_pcr4_records(records: list[dict[str, Any]]) -> list[dict[str, Any]]:
    """Keep only the fields that pcrlock component files actually use."""
    return [
        {
            "pcr": 4,
            "digests": [
                {"hashAlg": item["hashAlg"], "digest": item["digest"]}
                for item in record.get("digests", [])
                if isinstance(item, dict)
                and isinstance(item.get("hashAlg"), str)
                and isinstance(item.get("digest"), str)
            ],
        }
        for record in records
    ]


def _filter_pcr4_records(records: list[dict[str, Any]]) -> list[dict[str, Any]]:
    return [record for record in records if record.get("pcr") != 4]


def _generate_system_components(cfg: Config, dry_run: bool = False) -> None:
    """Generate pcrlock components for PCR 7 and the GPT (PCR 5).

    These components live in systemd-pcrlock's normal component directory and
    are copied into luksury's private tree by _copy_prediction_components().
    Generate them every time so a stale or missing component cannot silently
    drop PCR 7/5 from the policy.
    """
    if 7 not in cfg.pcrs and not cfg.lock_gpt:
        return
    binary = pcrlock_bin()
    if not binary:
        die("systemd-pcrlock was not found (install systemd >= 256)")

    if 7 in cfg.pcrs:
        for verb in ("lock-secureboot-policy", "lock-secureboot-authority"):
            cp = run([binary, verb], capture=True, check=False, dry_run=dry_run)
            if cp.returncode != 0:
                log.warning(
                    "systemd-pcrlock %s failed; PCR 7 may be omitted from the policy: %s",
                    verb,
                    (cp.stderr or cp.stdout or "").strip(),
                )
    if cfg.lock_gpt:
        cp = run([binary, "lock-gpt"], capture=True, check=False, dry_run=dry_run)
        if cp.returncode != 0:
            log.warning(
                "systemd-pcrlock lock-gpt failed; PCR 5 may be omitted from the policy: %s",
                (cp.stderr or cp.stdout or "").strip(),
            )


def _copy_prediction_components(
    dest_root: Path, exclude: Iterable[str] = ()
) -> None:
    """Copy all non-PCR4 components into the private component tree.

    Components that touch PCR 4 are replaced by the event-log-derived
    component.  Components that touch PCR 4 *and* other PCRs (for example the
    separator) are kept with their PCR 4 records removed.

    Components listed in *exclude* (710-kernel-cmdline, 720-kernel-initrd) are
    regenerated from the trusted hash store instead of copied.
    """
    excluded = {f"{name}.pcrlock.d" for name in exclude}
    for base in reversed(PCRLOCK_COMPONENT_SEARCH_DIRS):
        root = Path(base)
        if not root.is_dir():
            continue
        for source in sorted(root.rglob("*.pcrlock")):
            if not source.is_file():
                continue
            relative = source.relative_to(root)
            if relative.parts and relative.parts[0] in excluded:
                continue
            records = _pcrlock_record_list(source)
            if records is None:
                continue
            filtered = _filter_pcr4_records(records)
            if not filtered:
                continue
            destination = dest_root / relative
            destination.parent.mkdir(parents=True, exist_ok=True)
            destination.write_text(
                json.dumps({"records": filtered}, separators=(",", ":")) + "\n",
                encoding="utf-8",
            )
            os.chmod(destination, 0o644)


def _install_prediction_components(staging: Path) -> Path:
    final = PCRLOCK_PRIVATE_COMPONENTS
    previous = STATE_DIR / "pcrlock.d.old"
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if previous.exists():
        shutil.rmtree(previous)
    if final.exists():
        os.replace(final, previous)
    try:
        os.replace(staging, final)
    except OSError:
        if previous.exists() and not final.exists():
            os.replace(previous, final)
        raise
    if previous.exists():
        shutil.rmtree(previous)
    os.chmod(final, 0o755)
    return final


def _copy_preserved_pcr9_components(dest_root: Path) -> None:
    """Copy the cmdline/initrd components locked by the last setup/update.

    ``refresh-bootloader`` must not re-lock the currently running cmdline and
    initrd: both are influenced by the unauthenticated boot partition.  Keep
    the records that were verified by the last setup/update instead.
    """
    copied = 0
    for component in (PCRLOCK_CMDLINE_COMPONENT, PCRLOCK_INITRD_COMPONENT):
        source = PCRLOCK_PRIVATE_COMPONENTS / f"{component}.pcrlock.d"
        if not source.is_dir():
            die(
                f"cannot refresh the policy: {source} is missing. Run `{PROG} "
                "setup` or `update` first; refusing to re-lock the running "
                "cmdline/initrd."
            )
        files = [
            path
            for path in sorted(source.glob("*.pcrlock"))
            if not path.is_symlink() and path.is_file()
        ]
        if not files:
            die(
                f"cannot refresh the policy: {source} contains no locked records. "
                f"Run `{PROG} setup` or `update` first; refusing to re-lock the "
                "running cmdline/initrd."
            )
        destination = dest_root / f"{component}.pcrlock.d"
        destination.mkdir(parents=True, exist_ok=True)
        for path in files:
            records = _pcrlock_record_list(path)
            if not records or any(record.get("pcr") != 9 for record in records):
                die(
                    f"cannot refresh the policy: {path} is not a valid PCR 9 "
                    "pcrlock component"
                )
            shutil.copy2(path, destination / path.name)
            os.chmod(destination / path.name, 0o644)
            copied += 1
    if not copied:
        die("cannot refresh the policy: no locked cmdline/initrd records found")


def prepare_pcrlock_components(
    cfg: Config,
    store: dict[str, Any],
    *,
    target_kernel_record: dict[str, Any],
    target_bootloader_records: Sequence[dict[str, Any]] = (),
    running_cmdline_record: Optional[dict[str, Any]] = None,
    running_initrd_record: Optional[dict[str, Any]] = None,
    target_cmdline_record: Optional[dict[str, Any]] = None,
    target_initrd_record: Optional[dict[str, Any]] = None,
    preserve_pcr9: bool = False,
    dry_run: bool = False,
) -> list[tuple[str, list[dict[str, Any]]]]:
    """Build the private component set from trusted hashes and the event log.

    The ESP and /boot are not read here.  PCR 9 records come either from the
    current event log (running boot) or from the hash store (next boot); PCR 4
    comes from the event log with the kernel and boot loader records replaced
    by their stored digest records.

    When *preserve_pcr9* is true, the existing cmdline/initrd components in
    :data:`PCRLOCK_PRIVATE_COMPONENTS` are kept unchanged.  This is used by
    ``refresh-bootloader``, which must not promote the currently running
    cmdline/initrd (they are controlled by the unauthenticated boot partition).
    """
    if 4 not in cfg.pcrs:
        die(
            "PCR 4 must be in the policy: the kernel is measured there and luksury "
            "refuses to create a policy that does not bind the kernel"
        )
    if dry_run:
        log.info("[dry-run] would build prediction components from the trusted hash store")
        return []
    if cfg.lock_gpt and 5 not in cfg.pcrs:
        cfg.pcrs.append(5)

    binary = pcrlock_bin()
    if not binary:
        die("systemd-pcrlock was not found (install systemd >= 256)")

    cel = _pcrlock_cel_records(binary)
    if cel is None:
        die(
            "cannot read the TPM event log, so the measured kernel and boot loader "
            "cannot be predicted. Refusing to update the policy. Check that "
            "/sys/kernel/security/tpm0/binary_bios_measurements is readable and see "
            "`systemd-pcrlock log`."
        )

    records = _pcr4_records(cel)
    if not records:
        die(
            "the TPM event log contains no PCR 4 measurements, so the kernel is not "
            "measured. Refusing to update the policy."
        )

    calculated = _pcr4_extend(records)
    if calculated is None:
        die(
            "the PCR 4 event log contains a record without a usable SHA-256 digest; "
            "refusing to build a policy from an incomplete prediction"
        )
    current = _tpm_pcr_value(4)
    if current is None:
        log.warning("cannot read the current PCR 4 value from the TPM; relying on systemd-pcrlock validation")
    elif calculated != current:
        die(
            "the PCR 4 event log does not match the current TPM value "
            f"(event log {calculated}, TPM {current}); refusing to build a policy. "
            "See `systemd-pcrlock log`."
        )

    if not preserve_pcr9:
        if running_cmdline_record is None or running_initrd_record is None:
            running_cmdline_record, running_initrd_record = pcr9_running_records(cel)
        if target_cmdline_record is None:
            target_cmdline_record = running_cmdline_record
        if target_initrd_record is None:
            target_initrd_record = running_initrd_record

    variants = _pcr4_variants(records, store, target_kernel_record, target_bootloader_records)

    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        staging = Path(tempfile.mkdtemp(prefix=".pcrlock.d.", dir=str(STATE_DIR)))
    except OSError as exc:
        die(f"cannot create the prediction component directory: {exc}")

    try:
        _generate_system_components(cfg)
        _copy_prediction_components(
            staging,
            exclude=(PCRLOCK_CMDLINE_COMPONENT, PCRLOCK_INITRD_COMPONENT),
        )

        component_dir = staging / f"{PCRLOCK_PCR4_COMPONENT}.pcrlock.d"
        component_dir.mkdir(parents=True, exist_ok=True)
        seen: set[str] = set()
        written = 0
        for name, variant_records in variants:
            key = json.dumps(variant_records, sort_keys=True)
            if key in seen:
                continue
            seen.add(key)
            destination = component_dir / f"{name}.pcrlock"
            destination.write_text(
                json.dumps({"records": variant_records}, indent=2) + "\n",
                encoding="utf-8",
            )
            os.chmod(destination, 0o644)
            written += 1
        if written == 0:
            die("could not build any PCR 4 prediction variant")

        if preserve_pcr9:
            _copy_preserved_pcr9_components(staging)
        else:
            if (
                running_cmdline_record is None
                or running_initrd_record is None
                or target_cmdline_record is None
                or target_initrd_record is None
            ):
                die("internal error: missing PCR 9 records for the prediction components")
            for record in (running_cmdline_record, target_cmdline_record):
                _write_component_record(
                    staging,
                    PCRLOCK_CMDLINE_COMPONENT,
                    _component_name("cmdline", record),
                    record,
                )
            for record in (running_initrd_record, target_initrd_record):
                _write_component_record(
                    staging,
                    PCRLOCK_INITRD_COMPONENT,
                    _component_name("initrd", record),
                    record,
                )

        _install_prediction_components(staging)
    except OSError as exc:
        shutil.rmtree(staging, ignore_errors=True)
        die(f"cannot build the prediction components: {exc}")
    except BaseException:
        shutil.rmtree(staging, ignore_errors=True)
        raise

    log.info(
        "Prepared %d PCR 4 prediction variant(s) and %s PCR 9 components in %s",
        written,
        "preserved" if preserve_pcr9 else "trusted",
        PCRLOCK_PRIVATE_COMPONENTS,
    )
    return variants


def pcrlock_components_args(cfg: Config, *, dry_run: bool = False) -> list[str]:
    if 4 not in cfg.pcrs:
        return []
    if not PCRLOCK_PRIVATE_COMPONENTS.is_dir():
        if dry_run:
            return [f"--components={PCRLOCK_PRIVATE_COMPONENTS}"]
        die(
            "internal error: PCR 4 prediction components are missing. "
            f"Expected {PCRLOCK_PRIVATE_COMPONENTS}; run `{PROG} update` again."
        )
    return [f"--components={PCRLOCK_PRIVATE_COMPONENTS}"]


def prune_bootloader_variants(
    keep: set[Path], max_old: int = 3, dry_run: bool = False
) -> None:
    """Keep current PE variants plus a few old ones for the running boot.

    A systemd-boot update replaces the PE on the ESP before the next boot.  The
    running (old) boot's event log still refers to the previous measurement, so
    dropping all old variants would make pcrlock drop PCR 4.  Keeping a few
    recent variants covers the transition without retaining every boot loader
    ever installed.
    """
    d = pcrlock_component_dir(PCRLOCK_BOOTLOADER_COMPONENT)
    if not d.is_dir():
        return
    keep_resolved = {p.resolve() for p in keep}
    old: list[Path] = []
    for path in d.glob("*.pcrlock"):
        if not _BOOTLOADER_VARIANT_RE.fullmatch(path.name):
            continue
        try:
            if path.resolve() in keep_resolved:
                continue
        except OSError:
            pass
        old.append(path)
    def mtime(path: Path) -> float:
        try:
            return path.stat().st_mtime
        except OSError:
            return 0.0

    old.sort(key=mtime, reverse=True)
    for path in old[max_old:]:
        remove_file(path, dry_run)


def prune_pcrlock_variants(component: str, keep: set[Path], dry_run: bool = False) -> None:
    """Remove variants luksury created previously, retaining the given ones."""
    d = pcrlock_component_dir(component)
    if not d.is_dir():
        return
    keep_resolved = {p.resolve() for p in keep}
    for path in sorted(d.glob("*.pcrlock")):
        try:
            resolved = path.resolve()
        except OSError:
            resolved = path
        if resolved in keep_resolved:
            continue
        if path.name == "generated.pcrlock" or _VARIANT_FILE_RE.fullmatch(path.name):
            remove_file(path, dry_run)


def pcrlock_predict_values(
    cfg: Config, dry_run: bool = False
) -> Optional[dict[int, list[str]]]:
    """Run `systemd-pcrlock predict` and return predicted values per PCR."""
    binary = pcrlock_bin()
    if not binary:
        die("systemd-pcrlock was not found")
    if dry_run:
        log.info("[dry-run] would run systemd-pcrlock predict")
        return None

    cmd = [binary, "predict"]
    for pcr in cfg.pcrs:
        cmd.append(f"--pcr={pcr}")
    if cfg.pcrlock_location:
        cmd.append(f"--location={cfg.pcrlock_location}")
    cmd.extend(pcrlock_components_args(cfg))

    cp = run(cmd + ["--json=short"], capture=True, check=False)
    if cp.returncode == 0:
        try:
            data = json.loads(cp.stdout)
        except ValueError:
            data = None
        if isinstance(data, dict):
            # The policy uses the SHA-256 bank.  Prefer it over any other bank
            # the TPM may expose, so values of different lengths are not mixed.
            sha256_bank = data.get("sha256")
            if isinstance(sha256_bank, list):
                banks = [sha256_bank]
            else:
                banks = [bank for bank in data.values() if isinstance(bank, list)]
            values: dict[int, list[str]] = {}
            for bank in banks:
                for item in bank:
                    if not isinstance(item, dict) or not isinstance(item.get("pcr"), int):
                        continue
                    pcr = item["pcr"]
                    raw_values = item.get("values")
                    if not isinstance(raw_values, list):
                        continue
                    bucket = values.setdefault(pcr, [])
                    for value in raw_values:
                        if isinstance(value, str):
                            bucket.append(value.lower())
            return values

    # Older systemd versions may not support --json; fall back to text output.
    cp = run(cmd, capture=True, check=False)
    if cp.returncode != 0:
        detail = (cp.stderr or cp.stdout or "").strip()
        die(f"systemd-pcrlock predict failed: {detail or f'exit status {cp.returncode}'}")
    values = {}
    current: Optional[int] = None
    for line in cp.stdout.splitlines():
        match = re.search(r"Results for PCR (\d+)", line)
        if match:
            current = int(match.group(1))
            values.setdefault(current, [])
            continue
        match = re.search(r"sha256:\s*([0-9a-fA-F]{16,})", line)
        if match and current is not None:
            values[current].append(match.group(1).lower())
    return values


def _verify_current_pcr_values(
    cfg: Config, values_by_pcr: dict[int, list[str]], source: str
) -> None:
    """Ensure the current TPM values are among the predicted/policy values."""
    for pcr in cfg.pcrs:
        candidates = values_by_pcr.get(pcr)
        if not candidates:
            continue
        current = _tpm_pcr_value(pcr)
        if current is None:
            continue
        if current not in candidates:
            die(
                f"{source} for PCR {pcr} does not contain the current TPM value "
                f"({current}). Refusing to install a policy that cannot unlock this boot. "
                "See `systemd-pcrlock log`."
            )


def _verify_requested_pcrs(
    cfg: Config, values_by_pcr: dict[int, list[str]], source: str
) -> None:
    """Fail (or warn loudly) if an explicitly requested PCR was dropped.

    PCR 4 and 9 already have dedicated messages.  PCR 7 may legitimately be
    unavailable when Secure Boot is disabled; in that case warn.  If Secure
    Boot is enabled, or for an explicitly requested PCR 5/other, fail closed.
    """
    for pcr in sorted(set(cfg.pcrs)):
        if pcr in (4, 9):
            continue
        if values_by_pcr.get(pcr):
            continue
        if pcr == 7:
            enabled, _setup_mode = secure_boot_state()
            if enabled is True:
                die(
                    f"{source} does not cover PCR 7 even though Secure Boot is "
                    "enabled; refusing to install a policy that does not bind the "
                    "Secure Boot state. See `systemd-pcrlock log`."
                )
            log.warning(
                "PCR 7 was requested but cannot be covered (Secure Boot disabled "
                "or policy changed); the policy will bind the other covered PCRs "
                "only"
            )
            continue
        if pcr == 5:
            die(
                f"{source} does not cover PCR 5 (GPT), which was requested with "
                "--lock-gpt; refusing to install a policy that does not bind the "
                "partition table. See `systemd-pcrlock log`."
            )
        die(
            f"{source} does not cover requested PCR {pcr}; refusing to install a "
            "policy that does not bind every PCR you asked for. See "
            "`systemd-pcrlock log`."
        )


def _verify_target_variant(
    values_by_pcr: dict[int, list[str]],
    variants: Sequence[tuple[str, list[dict[str, Any]]]],
    source: str,
) -> None:
    """Require the target PCR 4 variant to be covered by the prediction/policy."""
    candidates = set(values_by_pcr.get(4, []))
    for name, records in variants:
        if name == "running":
            continue
        expected = _pcr4_extend(records)
        if expected is None:
            die(f"cannot replay the target PCR 4 variant {name!r}")
        if expected not in candidates:
            die(
                f"{source} does not contain the predicted PCR 4 value for the "
                f"target boot ({expected}); the target kernel or boot loader would "
                "not unlock. Refusing to install an incomplete policy."
            )


def _verify_target_pcr9(
    values_by_pcr: dict[int, list[str]],
    target_cmdline_record: Optional[dict[str, Any]],
    target_initrd_record: Optional[dict[str, Any]],
    source: str,
) -> None:
    """Require the target initrd/cmdline PCR 9 value to be covered."""
    if target_cmdline_record is None or target_initrd_record is None:
        return
    expected = _extend_records([target_cmdline_record, target_initrd_record])
    if expected is None:
        die("cannot replay the target PCR 9 initrd/cmdline records")
    if expected not in set(values_by_pcr.get(9, [])):
        die(
            f"{source} does not contain the predicted PCR 9 value for the target "
            f"initrd/cmdline ({expected}); the next boot would not unlock. Refusing "
            "to install an incomplete policy."
        )


def verify_pcrlock_prediction(
    cfg: Config,
    variants: Sequence[tuple[str, list[dict[str, Any]]]],
    *,
    target_cmdline_record: Optional[dict[str, Any]] = None,
    target_initrd_record: Optional[dict[str, Any]] = None,
    dry_run: bool = False,
) -> None:
    """Check the prediction BEFORE make-policy touches the NV index.

    PCR 9 (initrd/cmdline) and PCR 4 (kernel and boot loader) are mandatory.
    """
    if dry_run:
        log.info("[dry-run] would verify the pcrlock prediction covers PCR 4 and PCR 9")
        return
    values = pcrlock_predict_values(cfg)
    if values is None:
        return
    pcrs = set(values)
    log.info("pcrlock prediction covers PCRs: %s", ", ".join(map(str, sorted(pcrs))))
    if 9 not in pcrs:
        die(
            "the pcrlock prediction does not cover PCR 9 (initrd/kernel cmdline). "
            "Refusing to update the TPM policy and enroll. This usually means the "
            "initrd/cmdline you are locking is not the one in the current boot's event "
            "log (reboot with the recovery key/passphrase and re-run), or that "
            f"--pcrlock-location={cfg.pcrlock_location} includes components that are "
            "only measured on measured-OS/UKI boots (use 740 for classic boot). "
            "See `systemd-pcrlock log`."
        )
    if 4 not in pcrs:
        die(
            "the pcrlock prediction does not cover PCR 4 (kernel/boot loader). "
            "Refusing to update a policy that does not bind the measured kernel. "
            f"See `systemd-pcrlock log` and {PCRLOCK_PRIVATE_COMPONENTS}."
        )
    _verify_current_pcr_values(
        cfg,
        values,
        "the pcrlock prediction",
    )
    _verify_requested_pcrs(cfg, values, "the pcrlock prediction")
    _verify_target_variant(values, variants, "the pcrlock prediction")
    if cfg.pcrlock_location <= DEFAULT_PCRLOCK_LOCATION:
        _verify_target_pcr9(
            values,
            target_cmdline_record,
            target_initrd_record,
            "the pcrlock prediction",
        )


def run_pcrlock_make_policy(
    cfg: Config, dry_run: bool = False, *, force: bool = False
) -> None:
    binary = pcrlock_bin()
    if not binary:
        die("systemd-pcrlock was not found")
    if 12 in cfg.pcrs:
        die(
            "PCR 12 cannot be used with pcrlock: the pcrlock policy itself is measured "
            "into PCR 12, which would create a circular policy. Use PCR 9 for the "
            "kernel cmdline, or use a signed PCR policy with UKIs."
        )
    cmd = [binary, "make-policy"]
    for pcr in cfg.pcrs:
        cmd.append(f"--pcr={pcr}")
    if cfg.pcrlock_location:
        cmd.append(f"--location={cfg.pcrlock_location}")
    cmd.extend(pcrlock_components_args(cfg, dry_run=dry_run))
    if force:
        cmd.append("--force")
    run(cmd, dry_run=dry_run)
    if not dry_run and not PCRLOCK_JSON.exists():
        die(f"{PCRLOCK_JSON} was not created by systemd-pcrlock")
    if not dry_run:
        secure_pcrlock_permissions([PCRLOCK_JSON])


def pcrlock_policy_values() -> Optional[dict[int, list[str]]]:
    try:
        data = json.loads(PCRLOCK_JSON.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    values = data.get("pcrValues")
    if not isinstance(values, list):
        return None
    result: dict[int, list[str]] = {}
    for item in values:
        if not isinstance(item, dict) or not isinstance(item.get("pcr"), int):
            continue
        raw_values = item.get("values")
        if not isinstance(raw_values, list):
            continue
        bucket = result.setdefault(item["pcr"], [])
        for value in raw_values:
            if isinstance(value, str):
                bucket.append(value.lower())
    return result


def pcrlock_policy_pcrs() -> Optional[list[int]]:
    values = pcrlock_policy_values()
    if values is None:
        return None
    return sorted(values)


def verify_pcrlock_policy(
    cfg: Config,
    variants: Sequence[tuple[str, list[dict[str, Any]]]],
    *,
    target_cmdline_record: Optional[dict[str, Any]] = None,
    target_initrd_record: Optional[dict[str, Any]] = None,
) -> None:
    values_by_pcr = pcrlock_policy_values()
    if values_by_pcr is None:
        die(f"cannot parse {PCRLOCK_JSON}; refusing to enroll an unverifiable policy")
    pcrs = set(values_by_pcr)
    log.info("pcrlock policy covers PCRs: %s", ", ".join(map(str, sorted(pcrs))))
    if 9 not in pcrs:
        die(
            "the generated pcrlock policy does not cover PCR 9 (initrd/kernel cmdline). "
            "Refusing to enroll: automatic unlock would not be bound to the initrd. "
            "Check `systemd-pcrlock log`, the running/target initrd variants, and "
            f"whether --pcrlock-location={cfg.pcrlock_location} includes components "
            "only measured on measured-OS/UKI boots (use 740 for classic boot)."
        )
    if 4 not in pcrs:
        die(
            "the generated pcrlock policy does not cover PCR 4 (kernel/boot loader). "
            "Refusing to enroll an unbound kernel. See `systemd-pcrlock log` and "
            f"{PCRLOCK_PRIVATE_COMPONENTS}."
        )
    _verify_current_pcr_values(
        cfg,
        values_by_pcr,
        "the generated pcrlock policy",
    )
    _verify_requested_pcrs(cfg, values_by_pcr, "the generated pcrlock policy")
    _verify_target_variant(values_by_pcr, variants, "the generated pcrlock policy")
    if cfg.pcrlock_location <= DEFAULT_PCRLOCK_LOCATION:
        _verify_target_pcr9(
            values_by_pcr,
            target_cmdline_record,
            target_initrd_record,
            "the generated pcrlock policy",
        )


def verify_boot_credential(
    cfg: Config, dry_run: bool = False, *, verify_content: bool = True
) -> None:
    """Make sure the initrd can find systemd-pcrlock's boot credential.

    Classic systemd-boot does not pass /loader/credentials to the initrd, so the
    initrd hook copies it into /run/credentials/@encrypted itself.  The
    credential must exist and contain the policy we just generated.
    """
    if dry_run:
        log.info("[dry-run] would verify systemd-pcrlock's loader/credentials/pcrlock.*.cred")
        return

    paths = boot_credential_paths(cfg)
    if not paths:
        log.warning(
            "systemd-pcrlock did not write a boot credential; retrying make-policy with --force"
        )
        run_pcrlock_make_policy(cfg, force=True)
        paths = boot_credential_paths(cfg)
        verify_content = True
    if not paths:
        die(
            "systemd-pcrlock did not write loader/credentials/pcrlock.*.cred. "
            "Classic systemd-boot needs this credential to unlock root. "
            "systemd >= 256 is required; upgrade systemd and re-run."
        )

    if not verify_content:
        log.info(
            "Pcrlock boot credential present: %s (policy unchanged; content not re-checked)",
            ", ".join(str(p) for p in paths),
        )
        _harden_boot_credentials(paths)
        return

    sc = systemd_creds_bin()
    if not sc:
        log.info(
            "Pcrlock boot credential present: %s (systemd-creds not found; not content-checked)",
            ", ".join(str(p) for p in paths),
        )
        secure_pcrlock_permissions(paths)
        return

    for attempt in (0, 1):
        expected = _policy_without_pin(PCRLOCK_JSON.read_text(encoding="utf-8"))
        verified: Optional[Path] = None
        for path in paths:
            name = path.name[: -len(".cred")] if path.name.endswith(".cred") else path.name
            cp = run(
                [sc, "decrypt", "--allow-null", f"--name={name}", str(path), "-"],
                capture=True,
                check=False,
            )
            if cp.returncode == 0 and _policy_without_pin(cp.stdout) == expected:
                verified = path
                break
        if verified is not None:
            log.info("Verified pcrlock boot credential %s", verified)
            _harden_boot_credentials(paths)
            return
        if attempt == 0:
            log.warning(
                "the pcrlock boot credential does not match the current policy; "
                "retrying make-policy with --force"
            )
            run_pcrlock_make_policy(cfg, force=True)
            paths = boot_credential_paths(cfg)
            if not paths:
                break

    die(
        "the pcrlock boot credential does not contain the current policy "
        f"({', '.join(str(p) for p in paths)}); refusing to leave the next boot "
        "with an unusable credential"
    )


def legacy_boot_policy_path(cfg: Config) -> Optional[Path]:
    if not cfg.boot_mount:
        return None
    return Path(cfg.boot_mount) / LEGACY_BOOT_POLICY_SUBDIR / LEGACY_BOOT_POLICY_NAME


def refresh_legacy_boot_policy(cfg: Config, dry_run: bool = False) -> None:
    """Keep a 2.0-style ESP copy fresh until setup migrates the initrd.

    A 2.0 initrd reads /boot/<...>/luksury/pcrlock.json.  If the tool was
    upgraded and `update` runs before `setup` has rebuilt the initrd, leaving
    that file stale would break the next boot.
    """
    dest = legacy_boot_policy_path(cfg)
    if dest is None or not dest.exists():
        return
    if dry_run:
        log.info("[dry-run] would refresh legacy ESP policy copy %s", dest)
        return
    if not PCRLOCK_JSON.exists():
        die(f"{PCRLOCK_JSON} does not exist")
    dest.parent.mkdir(parents=True, exist_ok=True)
    fd, tmpname = tempfile.mkstemp(prefix=f".{dest.name}.", dir=str(dest.parent))
    tmp = Path(tmpname)
    try:
        with os.fdopen(fd, "wb") as out, PCRLOCK_JSON.open("rb") as src:
            shutil.copyfileobj(src, out)
        os.chmod(tmp, 0o600)
        os.replace(tmp, dest)
        os.sync()
    finally:
        tmp.unlink(missing_ok=True)
    secure_pcrlock_permissions([dest])
    if sha256_file(dest) != sha256_file(PCRLOCK_JSON):
        die(f"copy verification failed for {dest}")
    log.warning(
        "refreshed legacy ESP policy copy %s; run `%s setup` to migrate the "
        "initrd to systemd-pcrlock's credential",
        dest,
        PROG,
    )


def remove_legacy_boot_policy(cfg: Config, dry_run: bool = False) -> None:
    dest = legacy_boot_policy_path(cfg)
    if dest is None or not dest.exists():
        return
    remove_file(dest, dry_run)
    if not dry_run and dest.parent.exists():
        try:
            dest.parent.rmdir()
        except OSError:
            pass


def install_runtime_policy(dry_run: bool = False) -> None:
    """Install the policy where the running system's self-test looks for it.

    The initrd obtains the same data from systemd-pcrlock's boot credential via
    /run/credentials/@encrypted, which is not available on the running host.
    """
    if not PCRLOCK_JSON.exists():
        die(f"{PCRLOCK_JSON} does not exist")
    if dry_run:
        log.info("[dry-run] would copy %s to %s", PCRLOCK_JSON, PCRLOCK_RUNTIME)
        return
    atomic_write(PCRLOCK_RUNTIME, PCRLOCK_JSON.read_bytes(), 0o600)
    log.info("Installed runtime pcrlock policy at %s", PCRLOCK_RUNTIME)


def enroll_tpm(
    dev: Path,
    cfg: Config,
    *,
    unlock_key_file: Optional[Path],
    unlock_tpm2_device: Optional[str],
    wipe: bool,
    dry_run: bool,
) -> None:
    sce = cryptenroll_bin()
    cmd = [sce, "--tpm2-device=auto"]

    if cfg.mode == "pcrlock":
        cmd.append(f"--tpm2-pcrlock={PCRLOCK_JSON}")
    elif cfg.mode == "literal":
        cmd.append("--tpm2-pcrs=" + "+".join(str(p) for p in cfg.pcrs))
    else:
        die(f"unknown mode: {cfg.mode}")

    if unlock_key_file:
        cmd.append(f"--unlock-key-file={unlock_key_file}")
    if unlock_tpm2_device:
        cmd.append(f"--unlock-tpm2-device={unlock_tpm2_device}")
    if wipe:
        cmd.append("--wipe-slot=tpm2")
    cmd.append(str(dev))

    run(cmd, dry_run=dry_run)


