@dataclasses.dataclass
class BootPartition:
    mount: Path
    uuid: str
    fstype: str
    device: str = ""


@dataclasses.dataclass
class BootEntry:
    path: Path
    title: str
    kernel: Optional[Path]
    initrds: list[Path]
    options: str
    version: str = ""
    sort_key: str = ""
    # Raw initrd values as written in the boot entry (relative to the boot
    # partition).  Needed to reconstruct the kernel's "initrd=" cmdline prefix.
    initrd_specs: list[str] = dataclasses.field(default_factory=list)
    is_uki: bool = False


def is_block_device(path: Path) -> bool:
    try:
        return stat.S_ISBLK(path.stat().st_mode)
    except OSError:
        return False


def _dev_path(name: str) -> Path:
    """Resolve a kernel block-device name to a /dev path."""
    for cand in (Path("/dev") / name, Path("/dev/mapper") / name):
        if is_block_device(cand):
            return cand
    return Path("/dev") / name


def find_root_luks() -> tuple[Path, str]:
    """Return (LUKS container device, mapper name) backing /.

    The mapper (e.g. /dev/mapper/luks-...) is the *decrypted* device; the LUKS
    header lives on its parent partition.  systemd-cryptenroll and
    cryptsetup luksDump need the parent, not the mapper.
    """
    src = run_capture(["findmnt", "-n", "-o", "SOURCE", "/"])
    if not src:
        die("cannot determine the root filesystem source")
    src = src.split("[", 1)[0]
    src_path = Path(src)

    # Walk the device stack upwards (root -> LVM -> LUKS -> partition).
    cp = run(
        ["lsblk", "-s", "-n", "-o", "NAME,TYPE,PKNAME", src],
        capture=True,
        check=False,
    )
    if cp.returncode == 0:
        lines = [line.split() for line in cp.stdout.splitlines() if line.strip()]
        for idx, fields in enumerate(lines):
            if len(fields) < 2 or fields[1] != "crypt":
                continue
            mapper = fields[0]

            # Prefer sysfs: the slaves of a dm-crypt device are its backing
            # devices, independent of the confusing PKNAME column in reverse
            # lsblk output.
            kname = run_capture(["lsblk", "-no", "KNAME", f"/dev/mapper/{mapper}"], check=False)
            slaves_dir = Path("/sys/class/block") / (kname or mapper) / "slaves"
            candidates: list[str] = []
            if slaves_dir.is_dir():
                candidates.extend(sorted(p.name for p in slaves_dir.iterdir()))

            # Reverse lsblk prints the immediate parent on the next line.
            if idx + 1 < len(lines):
                candidates.append(lines[idx + 1][0])
            if len(fields) >= 3 and fields[2]:
                candidates.append(fields[2])

            for parent in candidates:
                dev = _dev_path(parent)
                if is_block_device(dev) and is_luks(dev):
                    return dev, mapper

    # Root itself may be the LUKS container (unusual, but handle it).
    for cand in (src_path, Path("/dev/mapper") / src_path.name, Path("/dev") / src_path.name):
        if is_block_device(cand) and is_luks(cand):
            return cand, src_path.name

    die("the root filesystem does not appear to be on a LUKS device")


def is_luks(dev: Path) -> bool:
    cs = cryptsetup_bin()
    cp = run([cs, "isLuks", str(dev)], capture=True, check=False)
    return cp.returncode == 0


def check_luks2(dev: Path) -> None:
    cs = cryptsetup_bin()
    out = run([cs, "luksDump", str(dev)], capture=True).stdout
    version = None
    for line in out.splitlines():
        m = re.match(r"\s*Version:\s*(\S+)", line)
        if m:
            version = m.group(1)
            break
    if version is None:
        die(f"cannot determine the LUKS version of {dev}")
    if version != "2":
        die(
            f"{dev} is LUKS{version}; systemd-cryptenroll requires LUKS2. "
            "Convert it first with: cryptsetup convert --type luks2 <device>"
        )


def luks_uuid(dev: Path) -> str:
    return run_capture([cryptsetup_bin(), "luksUUID", str(dev)])


def luks_has_token(dev: Path, token_type: str) -> bool:
    cs = cryptsetup_bin()
    cp = run([cs, "luksDump", "--dump-json-metadata", str(dev)], capture=True, check=False)
    if cp.returncode == 0:
        try:
            data = json.loads(cp.stdout)
        except ValueError:
            data = {}
        tokens = data.get("tokens") or {}
        for token in tokens.values():
            if isinstance(token, dict) and token.get("type") == token_type:
                return True
        return False
    # Older cryptsetup: fall back to text.
    text = run([cs, "luksDump", str(dev)], capture=True, check=False).stdout
    return token_type in text


def find_boot_partition() -> BootPartition:
    candidates: list[Path] = []

    bc = bootctl_bin()
    if bc:
        for arg in ("--print-boot-path", "--print-esp-path"):
            cp = run([bc, arg], capture=True, check=False)
            if cp.returncode == 0 and cp.stdout.strip():
                candidates.append(Path(cp.stdout.strip()))

    candidates.extend([Path("/boot"), Path("/boot/efi"), Path("/efi"), Path("/esp")])

    seen: set[Path] = set()
    for cand in candidates:
        try:
            cand = cand.resolve()
        except OSError:
            continue
        if cand in seen:
            continue
        seen.add(cand)
        if not (cand / "loader" / "loader.conf").exists():
            continue

        cp = run(
            ["findmnt", "-n", "-o", "UUID,FSTYPE,SOURCE,TARGET", "--target", str(cand)],
            capture=True,
            check=False,
        )
        if cp.returncode == 0 and cp.stdout.strip():
            fields = cp.stdout.split()
            if len(fields) >= 4 and fields[3] != "/":
                fs_mount = Path(fields[3])
                if cand != fs_mount:
                    die(
                        f"loader.conf is at {cand}, but its filesystem is mounted at "
                        f"{fs_mount}. This layout is not supported; the pcrlock policy "
                        "must be at the root of the boot partition."
                    )
                return BootPartition(
                    mount=cand,
                    uuid=fields[0],
                    fstype=fields[1],
                    device=fields[2],
                )
            # If the loader directory is on the root filesystem, the initramfs
            # cannot read it before unlocking.  Keep looking for an ESP.
            log.debug("%s has loader.conf but is on the root filesystem", cand)

    die(
        "cannot find the systemd-boot partition (no loader/loader.conf on a "
        "separate unencrypted partition). The classic-boot design needs the "
        "pcrlock policy to be readable from the boot partition before unlocking."
    )


def _read_kv_file(path: Path) -> list[tuple[str, str]]:
    result: list[tuple[str, str]] = []
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return result
    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        match = re.match(r"^(\S+)\s+(.*)$", line)
        if not match:
            continue
        result.append((match.group(1), match.group(2).strip()))
    return result


def find_default_entry(boot: BootPartition) -> BootEntry:
    loader_dir = boot.mount / "loader"
    entries_dir = loader_dir / "entries"

    default = ""
    for key, value in _read_kv_file(loader_dir / "loader.conf"):
        if key == "default":
            default = value
            break

    explicit = bool(default and default not in ("@saved", "@current"))
    if default in ("@saved", "@current"):
        log.warning(
            "loader.conf uses default %s; approximating the boot entry with the newest one",
            default,
        )
    entry_files: list[Path] = []
    if explicit:
        if not default.endswith(".conf"):
            default += ".conf"
        if any(ch in default for ch in "*?["):
            entry_files = sorted(p for p in entries_dir.glob("*") if fnmatch.fnmatch(p.name, default))
        else:
            entry_files = [entries_dir / default]
    if not entry_files:
        entry_files = sorted(entries_dir.glob("*.conf"))
    entry_files = [p for p in entry_files if p.is_file()]
    if not entry_files:
        die(f"no boot entries found in {entries_dir}")

    candidates: list[BootEntry] = []
    for path in entry_files:
        try:
            entry = parse_boot_entry(path, boot)
        except LuksuryError:
            if explicit and len(entry_files) == 1:
                raise
            continue
        if entry.is_uki:
            if explicit and len(entry_files) == 1:
                die(
                    f"the default boot entry {path} is a UKI; this tool supports "
                    "only classic linux+initrd entries"
                )
            continue
        candidates.append(entry)
    if not candidates:
        die(f"no classic linux+initrd boot entries found in {entries_dir}")

    # A wildcard default selects among multiple kernels.  Approximate
    # systemd-boot's ordering (sort-key, then version) with a natural sort.
    def natural_key(value: str) -> list[Any]:
        return [int(part) if part.isdigit() else part for part in re.split(r"(\d+)", value)]

    candidates.sort(
        key=lambda e: (natural_key(e.sort_key), natural_key(e.version), e.path.name),
        reverse=True,
    )
    entry = candidates[0]
    log.info("Using default boot entry: %s", entry.path)
    return entry


def find_entry_for_kernel(boot: BootPartition, version: str) -> Optional[BootEntry]:
    """Find the classic boot entry matching a kernel version."""
    if not version:
        return None
    entries_dir = boot.mount / "loader" / "entries"
    for path in sorted(entries_dir.glob("*.conf")):
        try:
            entry = parse_boot_entry(path, boot)
        except LuksuryError:
            continue
        if entry.is_uki:
            continue
        if entry.version == version or version in path.name:
            return entry
    return None


def parse_boot_entry(path: Path, boot: BootPartition) -> BootEntry:
    title = path.stem
    version = ""
    sort_key = ""
    kernel: Optional[Path] = None
    initrds: list[Path] = []
    initrd_specs: list[str] = []
    options = ""
    is_uki = False

    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError as exc:
        die(f"cannot read boot entry {path}: {exc}")

    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        match = re.match(r"^(\S+)\s+(.*)$", line)
        if not match:
            continue
        key = match.group(1)
        value = match.group(2).strip()
        if key == "title":
            title = value
        elif key == "version":
            version = value
        elif key == "sort-key":
            sort_key = value
        elif key == "linux":
            kernel = _boot_path(boot.mount, value)
        elif key == "initrd":
            initrd_specs.append(value)
            initrds.append(_boot_path(boot.mount, value))
        elif key == "options":
            options = value
        elif key in ("efi", "uki"):
            is_uki = True

    if kernel is None and is_uki:
        die(
            f"{path} is a UKI entry; this tool supports only classic "
            "'linux'+'initrd' systemd-boot entries"
        )
    if kernel is None:
        die(f"{path} has no 'linux' line")
    if not initrds:
        # Fall back to the conventional Debian/Ubuntu path.
        candidate = Path("/boot") / f"initrd.img-{os.uname().release}"
        if candidate.exists():
            initrds = [candidate]

    return BootEntry(
        path=path,
        title=title,
        kernel=kernel,
        initrds=[p for p in initrds if p],
        options=options,
        version=version,
        sort_key=sort_key,
        initrd_specs=initrd_specs,
        is_uki=is_uki,
    )


def _boot_path(mount: Path, value: str) -> Path:
    # Boot loader spec paths are relative to the boot partition.  A leading
    # slash refers to that partition's root, not to the host's "/".
    value = value.strip().lstrip("/")
    return mount / value


def uefi_path(value: str) -> str:
    """Convert a boot-entry path to the UEFI/DOS form used in /proc/cmdline."""
    value = value.strip()
    if value.startswith("/"):
        value = value[1:]
    value = value.replace("/", "\\")
    return "\\" + value if not value.startswith("\\") else value


def cmdline_has_initrd(cmdline: str) -> bool:
    """Return whether the boot loader passed an initrd= token to the kernel."""
    return any(token.startswith("initrd=") for token in cmdline.split())


def read_running_cmdline() -> str:
    try:
        return Path("/proc/cmdline").read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return ""


def build_kernel_cmdline(
    entry: BootEntry,
    options: Optional[str] = None,
    *,
    include_initrd: bool = True,
) -> str:
    """Reconstruct the kernel cmdline.

    systemd-boot passes `initrd=<UEFI path>` before the configured options for
    kernels that do not use the LoadFile2 initrd protocol (and the kernel
    measures this full string into PCR 9).  Whether that prefix is present is
    decided by the running boot: if /proc/cmdline has no initrd= token, the
    loader is using LoadFile2 and the next boot will not have one either.
    """
    opts = entry.options if options is None else options
    parts: list[str] = []
    if include_initrd:
        for spec in entry.initrd_specs:
            parts.append(f"initrd={uefi_path(spec)}")
    if opts.strip():
        parts.append(opts.strip())
    return " ".join(parts)


def make_combined_initrd(paths: Sequence[Path], dry_run: bool = False) -> tuple[Path, bool]:
    """Return (path, temporary).  Multiple initrds are concatenated like systemd-boot."""
    paths = [Path(p) for p in paths]
    if not paths:
        die("no initrd found")
    for p in paths:
        if not p.exists():
            die(f"initrd not found: {p}")
    if len(paths) == 1:
        return paths[0], False

    fd, name = tempfile.mkstemp(prefix="luksury-initrd-", suffix=".img")
    tmp = Path(name)
    try:
        with os.fdopen(fd, "wb") as out:
            for p in paths:
                with p.open("rb") as src:
                    shutil.copyfileobj(src, out, length=1024 * 1024)
                pad = (-p.stat().st_size) % 4
                if pad:
                    out.write(b"\0" * pad)
        return tmp, True
    except Exception:
        tmp.unlink(missing_ok=True)
        raise


def write_temp_text(text: str, prefix: str = "luksury-cmdline-") -> Path:
    fd, name = tempfile.mkstemp(prefix=prefix)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
        if not text.endswith("\n"):
            f.write("\n")
    return Path(name)


def find_running_initrd(boot: BootPartition) -> tuple[Optional[Path], bool]:
    """Return (path, temporary) for the initrd used by the running kernel.

    This is deliberately looked up separately from the target boot entry: on
    updates the running kernel and the kernel being installed are usually not
    the same.  The returned image is combined in the same way systemd-boot
    combines multiple initrd= lines.
    """
    release = os.uname().release
    entry = find_entry_for_kernel(boot, release)
    if entry is not None and entry.initrds:
        try:
            return make_combined_initrd(entry.initrds)
        except LuksuryError as exc:
            log.debug("Cannot read the running boot entry's initrd: %s", exc)

    for candidate in (
        Path(f"/boot/initrd.img-{release}"),
        Path(f"/boot/initramfs-{release}.img"),
        Path(f"/boot/initramfs-{release}"),
    ):
        if candidate.exists():
            return candidate, False
    return None, False


def snapshot_file(path: Path, prefix: str = "luksury-running-initrd-") -> Path:
    """Copy a file that is about to be overwritten, so its measurement can be locked."""
    fd, name = tempfile.mkstemp(prefix=prefix, suffix=".img")
    tmp = Path(name)
    try:
        with os.fdopen(fd, "wb") as out, path.open("rb") as src:
            shutil.copyfileobj(src, out, length=1024 * 1024)
        return tmp
    except Exception:
        tmp.unlink(missing_ok=True)
        raise


def initrd_has_luksury_hook(image: Path) -> Optional[bool]:
    """Return whether an initrd contains the luksury hook, or None if unknown."""
    lsinitrd = which("lsinitrd", fallbacks=("/usr/bin/lsinitrd", "/usr/sbin/lsinitrd"))
    if not lsinitrd:
        return None
    if not image.exists():
        return False
    cp = run([lsinitrd, str(image)], capture=True, check=False, timeout=180)
    if cp.returncode != 0:
        return False
    if "luksury_pcrlock.sh" not in cp.stdout or "99-luksury.conf" not in cp.stdout:
        return False
    dropin = "usr/lib/systemd/system/systemd-cryptsetup@.service.d/99-luksury.conf"
    content = run([lsinitrd, "-f", dropin, str(image)], capture=True, check=False, timeout=60)
    if content.returncode != 0:
        return False
    return "ExecStartPre=" in content.stdout and "luksury_pcrlock.sh" in content.stdout


def parse_crypttab_line(line: str) -> tuple[list[str], str]:
    """Return (fields, trailing_comment).  Handles comments and quotes."""
    trailing = ""
    body = line
    if "#" in line:
        # Keep an inline comment only if it is not inside quotes; crypttab
        # does not really support inline comments, so this is best effort.
        body, _, comment = line.partition("#")
        trailing = "#" + comment
    try:
        fields = shlex.split(body, comments=False)
    except ValueError as exc:
        die(f"cannot parse /etc/crypttab line {line!r}: {exc}")
    return fields, trailing


def crypttab_matches(fields: Sequence[str], cfg: Config, dev: Path) -> bool:
    if len(fields) < 2:
        return False
    name, source = fields[0], fields[1]
    if cfg.luks_name and name == cfg.luks_name:
        return True
    if cfg.luks_uuid:
        if source in (
            f"UUID={cfg.luks_uuid}",
            f"/dev/disk/by-uuid/{cfg.luks_uuid}",
            f"/dev/disk/by-id/dm-uuid-CRYPT-LUKS2-{cfg.luks_uuid}",
        ):
            return True
    try:
        if Path(source).resolve() == dev.resolve():
            return True
    except OSError:
        pass
    return False


def set_crypttab_tpm(
    dev: Path,
    cfg: Config,
    *,
    remove: bool = False,
    path: Path = Path("/etc/crypttab"),
    dry_run: bool = False,
) -> None:
    path = Path(path)
    if not path.exists():
        die(f"{path} does not exist")
    backup_file(path, dry_run=dry_run)
    lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    out: list[str] = []
    found = False

    for raw in lines:
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            out.append(raw)
            continue
        fields, comment = parse_crypttab_line(raw)
        if not crypttab_matches(fields, cfg, dev):
            out.append(raw)
            continue

        found = True
        name, source = fields[0], fields[1]
        options = fields[3].split(",") if len(fields) >= 4 and fields[3] else []
        cleaned: list[str] = []
        for opt in options:
            key = opt.split("=", 1)[0]
            if key in ("keyscript", "keyfile-timeout", "tpm2-device", "tpm2-pcrs", "tpm2-pcrlock", "tpm2-signature"):
                continue
            if opt:
                cleaned.append(opt)
        if not remove:
            cleaned.append("tpm2-device=auto")
        # Deduplicate while preserving order.
        seen: set[str] = set()
        final_opts = [o for o in cleaned if not (o in seen or seen.add(o))]
        newline = f"{name} {source} none"
        if final_opts:
            newline += " " + ",".join(final_opts)
        if comment:
            newline += " " + comment
        out.append(newline)

    if not found:
        die(
            f"no /etc/crypttab entry matching {dev} ({cfg.luks_name or 'unknown mapper'}); "
            "refusing to guess"
        )

    text = "\n".join(out) + "\n"
    atomic_write(path, text, 0o644, dry_run)
    log.info(
        "%s %s for %s (%s)",
        "Would update" if dry_run else "Updated",
        path,
        dev,
        "removed TPM2 options" if remove else "tpm2-device=auto",
    )


