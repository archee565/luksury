@dataclasses.dataclass
class PolicySnapshot:
    """State that must be restored if a policy update fails verification."""

    policy_text: Optional[str]
    pcrlock_location: str
    pcrs: list[int]
    lock_gpt: bool
    mode: str
    components_backup: Optional[Path]
    initrd_backups: list[tuple[Path, Path]]
    credential_backups: dict[Path, bytes]
    legacy_path: Optional[Path]
    legacy_data: Optional[bytes]
    runtime_data: Optional[bytes]
    boot_mount: str
    credential_mount: str

    @classmethod
    def capture(cls, cfg: Config, boot: BootPartition, version: str) -> "PolicySnapshot":
        policy_text: Optional[str] = None
        if PCRLOCK_JSON.exists():
            try:
                policy_text = PCRLOCK_JSON.read_text(encoding="utf-8")
            except OSError as exc:
                log.warning("cannot back up %s: %s", PCRLOCK_JSON, exc)

        components_backup: Optional[Path] = None
        if PCRLOCK_PRIVATE_COMPONENTS.is_dir():
            try:
                STATE_DIR.mkdir(parents=True, exist_ok=True)
                components_backup = Path(
                    tempfile.mkdtemp(prefix=".pcrlock-backup.", dir=str(STATE_DIR))
                )
                shutil.copytree(
                    PCRLOCK_PRIVATE_COMPONENTS,
                    components_backup,
                    dirs_exist_ok=True,
                )
            except OSError as exc:
                log.warning("cannot back up pcrlock components: %s", exc)
                components_backup = None

        initrd_backups: list[tuple[Path, Path]] = []
        seen: set[Path] = set()
        for target in (
            target_initrd_source_path(version),
            target_initrd_path(boot, version),
        ):
            try:
                resolved = target.resolve()
            except OSError:
                resolved = target
            if resolved in seen:
                continue
            seen.add(resolved)
            if not target.exists():
                continue
            try:
                initrd_backups.append(
                    (target, snapshot_file(target, prefix="luksury-old-initrd-"))
                )
            except OSError as exc:
                log.warning("cannot back up initrd %s: %s", target, exc)

        credential_backups: dict[Path, bytes] = {}
        for path in boot_credential_paths(cfg):
            try:
                credential_backups[path] = path.read_bytes()
            except OSError as exc:
                log.warning("cannot back up boot credential %s: %s", path, exc)

        legacy = legacy_boot_policy_path(cfg)
        legacy_data: Optional[bytes] = None
        if legacy is not None and legacy.exists():
            try:
                legacy_data = legacy.read_bytes()
            except OSError as exc:
                log.warning("cannot back up legacy policy %s: %s", legacy, exc)

        runtime_data: Optional[bytes] = None
        if PCRLOCK_RUNTIME.exists():
            try:
                runtime_data = PCRLOCK_RUNTIME.read_bytes()
            except OSError as exc:
                log.warning("cannot back up runtime policy %s: %s", PCRLOCK_RUNTIME, exc)

        return cls(
            policy_text=policy_text,
            pcrlock_location=cfg.pcrlock_location,
            pcrs=list(cfg.pcrs),
            lock_gpt=cfg.lock_gpt,
            mode=cfg.mode,
            components_backup=components_backup,
            initrd_backups=initrd_backups,
            credential_backups=credential_backups,
            legacy_path=legacy,
            legacy_data=legacy_data,
            runtime_data=runtime_data,
            boot_mount=cfg.boot_mount,
            credential_mount=cfg.credential_mount,
        )

    def commit(self) -> None:
        """Discard backups after a successful policy update."""
        if self.components_backup is not None:
            shutil.rmtree(self.components_backup, ignore_errors=True)
            self.components_backup = None
        for _target, backup in self.initrd_backups:
            backup.unlink(missing_ok=True)
        self.initrd_backups = []

    def restore(self) -> None:
        """Restore the previous policy, components, initrd and credentials."""
        try:
            # Components first: make-policy needs the old tree to replay the old
            # prediction.
            if self.components_backup is not None and self.components_backup.is_dir():
                if PCRLOCK_PRIVATE_COMPONENTS.exists():
                    shutil.rmtree(PCRLOCK_PRIVATE_COMPONENTS)
                shutil.copytree(
                    self.components_backup, PCRLOCK_PRIVATE_COMPONENTS
                )
                os.chmod(PCRLOCK_PRIVATE_COMPONENTS, 0o755)
            else:
                shutil.rmtree(PCRLOCK_PRIVATE_COMPONENTS, ignore_errors=True)

            if self.policy_text is not None:
                atomic_write(PCRLOCK_JSON, self.policy_text, 0o600)
                secure_pcrlock_permissions([PCRLOCK_JSON])
                old_cfg = dataclasses.replace(
                    Config(),
                    mode=self.mode,
                    pcrs=list(self.pcrs),
                    pcrlock_location=self.pcrlock_location,
                    lock_gpt=self.lock_gpt,
                )
                try:
                    run_pcrlock_make_policy(old_cfg)
                except LuksuryError as exc:
                    log.error(
                        "could not restore the previous pcrlock NV policy: %s. "
                        "Use the LUKS recovery key/passphrase.",
                        exc,
                    )
            else:
                if PCRLOCK_JSON.exists():
                    binary = pcrlock_bin()
                    if binary:
                        run(
                            [binary, "remove-policy"],
                            capture=True,
                            check=False,
                        )
                remove_file(PCRLOCK_JSON)

            for target, backup in self.initrd_backups:
                try:
                    _copy_file_atomic(backup, target, 0o600)
                except OSError as exc:
                    log.error("could not restore initrd %s: %s", target, exc)

            for path, data in self.credential_backups.items():
                try:
                    atomic_write(path, data, 0o600)
                except OSError as exc:
                    log.error("could not restore boot credential %s: %s", path, exc)
            if not self.credential_backups:
                if self.policy_text is None:
                    path_cfg = Config(
                        boot_mount=self.boot_mount,
                        credential_mount=self.credential_mount,
                    )
                    for path in boot_credential_paths(path_cfg):
                        remove_file(path)
                else:
                    # make-policy restored the old policy and may have written
                    # a credential even though there was no old copy to back up.
                    path_cfg = Config(
                        boot_mount=self.boot_mount,
                        credential_mount=self.credential_mount,
                    )
                    _harden_boot_credentials(boot_credential_paths(path_cfg))

            if self.legacy_path is not None:
                if self.legacy_data is not None:
                    atomic_write(self.legacy_path, self.legacy_data, 0o600)
                else:
                    remove_file(self.legacy_path)

            if self.runtime_data is not None:
                atomic_write(PCRLOCK_RUNTIME, self.runtime_data, 0o600)
            else:
                remove_file(PCRLOCK_RUNTIME)

            secure_pcrlock_permissions(
                [PCRLOCK_JSON, PCRLOCK_RUNTIME]
                + list(self.credential_backups)
                + ([self.legacy_path] if self.legacy_path is not None else [])
            )
            log.warning("Restored the previous luksury policy after a failed update")
        except Exception as exc:  # noqa: BLE001 - best-effort rollback
            log.error(
                "failed to restore the previous luksury policy: %s. Use the LUKS "
                "recovery key/passphrase.",
                exc,
            )
        finally:
            if self.components_backup is not None:
                shutil.rmtree(self.components_backup, ignore_errors=True)
            for _target, backup in self.initrd_backups:
                backup.unlink(missing_ok=True)


def cmd_setup(args: argparse.Namespace) -> int:
    require_root()
    if not dracut_bin():
        die(
            "dracut is required: the boot-time pcrlock hook is a dracut module. "
            "Install dracut (Ubuntu 25.10+ uses it by default) and retry."
        )
    if not systemd_boot_active():
        die(
            "systemd-boot is not the current boot loader. This tool relies on "
            "systemd-boot's classic linux+initrd handling and cannot configure GRUB."
        )
    warn_if_secure_boot_disabled()
    warn_if_tpm_device_world_accessible()
    install_self(args.dry_run)

    old_cfg = load_config(required=False)
    previous_cmdline = old_cfg.cmdline if old_cfg is not None else ""
    cfg = old_cfg if old_cfg is not None else Config()
    cfg.created_by = VERSION
    cfg.mode = (
        args.mode
        if args.mode is not None
        else (old_cfg.mode if old_cfg is not None else "auto")
    )
    cfg.pcrlock_location = (
        args.pcrlock_location
        if args.pcrlock_location is not None
        else (
            old_cfg.pcrlock_location
            if old_cfg is not None
            else DEFAULT_PCRLOCK_LOCATION
        )
    )
    cfg.lock_gpt = (
        args.lock_gpt
        if args.lock_gpt is not None
        else (old_cfg.lock_gpt if old_cfg is not None else False)
    )

    old_pes = list(old_cfg.bootloader_pes) if old_cfg is not None else []
    new_pes: list[str] = []
    for raw in getattr(args, "bootloader_pe", None) or []:
        path = Path(raw)
        if not path.is_file():
            die(f"boot loader PE not found: {path}")
        new_pes.append(str(path.resolve()))
    cfg.bootloader_pes = list(dict.fromkeys(old_pes + new_pes))

    if (
        cfg.mode in ("auto", "pcrlock")
        and not ("720-kernel-initrd" < cfg.pcrlock_location < "750")
    ):
        log.warning(
            "pcrlock location %s may include components that are only measured on "
            "measured-OS/UKI boots; 740 is recommended for classic systemd-boot",
            cfg.pcrlock_location,
        )

    if cfg.mode == "auto":
        cfg.mode = "pcrlock" if pcrlock_supported() else "literal"
        log.info("Selected mode: %s", cfg.mode)
    elif cfg.mode == "pcrlock" and not pcrlock_supported():
        die("systemd-pcrlock is not supported on this system/TPM; use --mode=literal")
    elif cfg.mode == "literal":
        log.warning(
            "literal PCR mode does not survive initrd/kernel updates. "
            "You will have to re-enroll after each update."
        )

    if args.pcrs:
        cfg.pcrs = parse_pcr_list(args.pcrs)
    elif old_cfg is not None and old_cfg.pcrs:
        cfg.pcrs = list(old_cfg.pcrs)
    else:
        cfg.pcrs = list(DEFAULT_PCRLOCK_PCRS if cfg.mode == "pcrlock" else DEFAULT_LITERAL_PCRS)

    if cfg.lock_gpt and 5 not in cfg.pcrs:
        cfg.pcrs.append(5)

    if cfg.mode == "pcrlock" and 12 in cfg.pcrs:
        die(
            "PCR 12 is not usable with pcrlock (circular policy measurement). "
            "PCR 9 covers the kernel cmdline/initrd; remove 12."
        )
    if cfg.mode == "pcrlock" and 4 not in cfg.pcrs:
        die(
            "PCR 4 is mandatory with pcrlock: the kernel is measured there. "
            "Refusing to create a policy that does not bind the kernel."
        )

    if (
        cfg.mode == "pcrlock"
        and 4 in cfg.pcrs
        and cfg.pcrlock_location < PCRLOCK_PCR4_COMPONENT
    ):
        log.warning(
            "pcrlock location %s excludes %s; PCR 4 will not be covered",
            cfg.pcrlock_location,
            PCRLOCK_PCR4_COMPONENT,
        )

    dev, name = find_root_luks()
    check_luks2(dev)
    cfg.luks_device = str(dev)
    cfg.luks_name = name
    cfg.luks_uuid = luks_uuid(dev)
    log.info("Root LUKS2 device: %s (%s)", dev, name)

    boot = find_boot_partition()
    if not boot.uuid:
        die(
            f"cannot determine the UUID of the boot partition ({boot.mount}); "
            "the initramfs would not be able to read the pcrlock policy"
        )
    cfg.boot_mount = str(boot.mount)
    cfg.boot_uuid = boot.uuid
    cfg.boot_fstype = boot.fstype
    cfg.boot_device = boot.device
    log.info(
        "Boot partition: %s (UUID=%s, fstype=%s, device=%s)",
        boot.mount,
        boot.uuid,
        boot.fstype or "?",
        boot.device or "?",
    )

    credential = find_credential_partition()
    if credential is None or not credential.uuid:
        log.warning(
            "cannot determine the $BOOT credential partition UUID; falling back to the "
            "boot-entry partition %s",
            boot.mount,
        )
        credential = boot
    cfg.credential_mount = str(credential.mount)
    cfg.credential_uuid = credential.uuid
    cfg.credential_fstype = credential.fstype
    cfg.credential_device = credential.device
    cfg.credential_partuuid = partition_partuuid(credential.device)
    log.info(
        "Credential partition: %s (UUID=%s, PARTUUID=%s, device=%s)",
        credential.mount,
        credential.uuid,
        cfg.credential_partuuid or "?",
        credential.device or "?",
    )

    running_release = os.uname().release
    entry = find_entry_for_kernel(boot, running_release)
    if entry is None:
        try:
            default_entry = find_default_entry(boot)
        except LuksuryError:
            default_entry = None
        if default_entry is not None and default_entry.is_uki:
            die(
                "the installed boot entry is a UKI; this tool supports only classic "
                "linux+initrd systemd-boot entries"
            )
        log.warning("No installed boot entry found for the running kernel %s", running_release)
    cfg.kernel_version = running_release
    # cfg.initrd is retained only for status/backward compatibility.  PCR
    # prediction uses the hash store, never this path.
    cfg.initrd = ""

    running_cmdline_text = read_running_cmdline()
    if not running_cmdline_text:
        die("cannot read /proc/cmdline; refusing to predict the running boot")
    filter_cmdline(running_cmdline_text)
    target_cmdline_text, target_options = trusted_cmdline(args, cfg, running_release)
    if not target_cmdline_text:
        die("cannot determine the trusted kernel command line")
    verify_running_cmdline(
        running_cmdline_text,
        previous=previous_cmdline,
        target=target_cmdline_text,
    )
    cfg.cmdline = target_cmdline_text
    log.info("Kernel version: %s", running_release)
    log.info("Trusted cmdline: %s", target_cmdline_text)

    if luks_has_token(dev, "systemd-tpm2"):
        if not args.dry_run and not confirm(
            "Replace the existing TPM2 enrollment on this device?", args.yes
        ):
            die("aborted before replacing the existing TPM2 enrollment")
        wipe = True
    else:
        wipe = False

    if not args.dry_run:
        backup = Path(f"/root/luks-header-{_dt.datetime.now():%Y%m%d-%H%M%S}.img")
        run([cryptsetup_bin(), "luksHeaderBackup", str(dev), "--header-backup-file", str(backup)])
        os.chmod(backup, 0o600)
        log.info("LUKS header backup: %s", backup)

    if not luks_has_token(dev, "systemd-recovery"):
        log.info("No recovery key token found; adding one now. Store it offline!")
        enroll_cmd = [cryptenroll_bin(), "--recovery-key"]
        if args.unlock_key_file:
            enroll_cmd.append(f"--unlock-key-file={args.unlock_key_file}")
        if args.unlock_tpm2_device:
            enroll_cmd.append(f"--unlock-tpm2-device={args.unlock_tpm2_device}")
        enroll_cmd.append(str(dev))
        if args.dry_run:
            log.info("[dry-run] %s", shlex.join(enroll_cmd))
        else:
            cp = run(enroll_cmd, capture=True)
            output = (cp.stdout or "") + (cp.stderr or "")
            if output.strip():
                print(output.rstrip())
            key_path = Path(
                f"/root/luksury-recovery-key-{_dt.datetime.now():%Y%m%d-%H%M%S}.txt"
            )
            atomic_write(key_path, output, 0o600)
            log.warning(
                "Recovery key enrolled and written to %s (mode 0600). Move it "
                "offline now; do not leave it on this system.",
                key_path,
            )
    else:
        log.info("A recovery key token already exists; leaving it untouched")

    store = load_hash_store()
    temp_initrd: Optional[Path] = None
    cmdline_file: Optional[Path] = None
    running_cmdline_file: Optional[Path] = None
    variants: list[tuple[str, list[dict[str, Any]]]] = []
    snapshot = (
        PolicySnapshot.capture(cfg, boot, running_release)
        if not args.dry_run
        else None
    )

    try:
        if cfg.mode == "pcrlock":
            # The dracut module must be installed and the initrd rebuilt BEFORE
            # the policy is generated, otherwise the policy locks an image that
            # is about to be replaced.
            install_dracut_module(cfg, args.dry_run)
            if args.dry_run:
                log.info(
                    "[dry-run] would generate, hash and install an initrd for %s",
                    running_release,
                )
            else:
                temp_initrd = generate_initrd_temp(running_release)
                if initrd_has_luksury_hook(temp_initrd) is False:
                    die(
                        f"the regenerated initrd {temp_initrd} does not contain the "
                        "luksury hook; check the dracut module installation and "
                        "dracut configuration"
                    )
                initrd_record = lock_initrd_record(temp_initrd)
                store_add(store, "initrd", initrd_record, "luksury-dracut")
                # Install the image before the policy/boot-loader checks.  If a
                # check below fails, the new kernel entry still has a valid
                # initrd and can be unlocked with the passphrase.
                install_initrd(temp_initrd, running_release, boot)

                cmdline_file = write_temp_text(target_cmdline_text)
                cmdline_record = lock_cmdline_record(cmdline_file)
                store_add(store, "cmdline", cmdline_record, "trusted-cmdline")
                running_cmdline_file = write_temp_text(running_cmdline_text)
                running_cmdline_record = lock_cmdline_record(running_cmdline_file)
                store_add(store, "cmdline", running_cmdline_record, "proc-cmdline")

                kernel_key = ingest_running_kernel(store, cfg)
                if kernel_key is None:
                    die(
                        "cannot ingest the running kernel from a trusted source; "
                        "refusing to create a policy that does not bind the kernel"
                    )
                ingested = ingest_bootloaders(store, cfg)
                target_bootloader = installed_bootloader_record(cfg, boot, ingested)

                binary = pcrlock_bin()
                if not binary:
                    die("systemd-pcrlock was not found (install systemd >= 256)")
                cel = _pcrlock_cel_records(binary)
                if cel is None:
                    die(
                        "cannot read the TPM event log; refusing to predict the "
                        "measured kernel and initrd"
                    )
                running_cmdline_rec, running_initrd_rec = pcr9_running_records(cel)
                target_kernel_record = store_record_for_key(store, kernel_key)
                if target_kernel_record is None:
                    die("internal error: the ingested kernel is missing from the hash store")
                variants = prepare_pcrlock_components(
                    cfg,
                    store,
                    target_kernel_record=target_kernel_record,
                    target_bootloader_records=[target_bootloader],
                    running_cmdline_record=running_cmdline_rec,
                    running_initrd_record=running_initrd_rec,
                    target_cmdline_record=cmdline_record,
                    target_initrd_record=initrd_record,
                )
                verify_pcrlock_prediction(
                    cfg,
                    variants,
                    target_cmdline_record=cmdline_record,
                    target_initrd_record=initrd_record,
                )
                verify_installed_entry(
                    cfg,
                    boot,
                    running_release,
                    target_initrd_basename(running_release),
                    target_options,
                    store=store,
                )

            run_pcrlock_make_policy(cfg, args.dry_run)
            if not args.dry_run:
                verify_pcrlock_policy(
                    cfg,
                    variants,
                    target_cmdline_record=cmdline_record,
                    target_initrd_record=initrd_record,
                )
                verify_boot_credential(cfg)
                install_runtime_policy()
            save_hash_store(store, args.dry_run)
        elif cfg.mode == "literal":
            log.warning(
                "literal PCR mode: the TPM seal will not survive future initrd/cmdline "
                "changes. Re-run `%s setup --mode=literal` after such an update.",
                PROG,
            )

        enroll_tpm(
            dev,
            cfg,
            unlock_key_file=args.unlock_key_file,
            unlock_tpm2_device=args.unlock_tpm2_device,
            wipe=wipe,
            dry_run=args.dry_run,
        )
    except Exception:
        if snapshot is not None:
            snapshot.restore()
        raise
    finally:
        for path in (temp_initrd, cmdline_file, running_cmdline_file):
            if path is not None:
                path.unlink(missing_ok=True)
    if snapshot is not None:
        snapshot.commit()

    install_update_hooks(args.dry_run)
    set_crypttab_tpm(dev, cfg, remove=False, dry_run=args.dry_run)

    if cfg.mode == "pcrlock":
        # The rebuilt initrd consumes systemd-pcrlock's credential now, so the
        # 2.0-style ESP copy is no longer needed.
        remove_legacy_boot_policy(cfg, args.dry_run)

    save_config(cfg, args.dry_run)

    if not args.dry_run:
        if not verify_enrollment(dev, cfg=cfg):
            eprint(
                "\nAuto-unlock was configured, but the self-test failed.\n"
                "The LUKS passphrase and recovery key still work.\n"
                f"Check `{PROG} status`, `systemd-pcrlock log`, and re-run `{PROG} setup`."
            )
            return 1
        else:
            log.info(
                "The self-test validates the current boot only; reboot with the recovery "
                "key available to verify the next boot."
            )
        print()
        print(f"{PROG} setup complete.")
        print(f"  Mode:       {cfg.mode}")
        print(f"  PCRs:       {', '.join(map(str, cfg.pcrs))}")
        print(f"  LUKS:       {dev}")
        print(f"  Boot:       {boot.mount}")
        print(f"  Kernel:     {running_release}")
        print(f"  Hash store: {HASH_STORE}")
        print()
        print("Reboot with the recovery key available.  Then test an edited boot")
        print("entry (`rd.break=pre-mount`): the TPM must refuse to unseal.")
    return 0


def _initrd_spec(initrd: Path, boot_mount: Path) -> str:
    """Best-effort boot-partition-relative spec for an initrd path."""
    try:
        rel = initrd.resolve().relative_to(boot_mount.resolve())
        return "/" + str(rel)
    except (OSError, ValueError):
        return str(initrd)


def _resolve_update_inputs(
    args: argparse.Namespace, cfg: Config
) -> tuple[Path, Path, list[Path]]:
    """Return (initrd, cmdline_file, temporary_paths)."""
    temporary: list[Path] = []
    boot = BootPartition(
        mount=Path(cfg.boot_mount),
        uuid=cfg.boot_uuid,
        fstype=cfg.boot_fstype,
    )
    entry: Optional[BootEntry] = None

    if args.kernel:
        entry = find_entry_for_kernel(boot, args.kernel)
    elif args.initrd is None:
        try:
            entry = find_default_entry(boot)
        except LuksuryError:
            entry = None

    initrd: Optional[Path] = None
    if entry is not None and entry.initrds:
        try:
            initrd, temporary_flag = make_combined_initrd(
                entry.initrds, dry_run=args.dry_run
            )
            if temporary_flag:
                temporary.append(initrd)
        except LuksuryError:
            # The final initrd may not have been installed yet; the staging
            # area still has the same image.
            if args.initrd is not None:
                initrd = args.initrd
            else:
                raise

    if initrd is None and args.initrd is not None:
        initrd = args.initrd

    if initrd is None and args.kernel:
        version = args.kernel
        for cand in (
            Path(f"/boot/initrd.img-{version}"),
            Path(f"/boot/initramfs-{version}.img"),
            Path(f"/boot/initramfs-{version}"),
        ):
            if cand.exists():
                initrd = cand
                break

    if initrd is None and cfg.initrd and not args.kernel:
        initrd = Path(cfg.initrd)
    if initrd is None and not args.kernel:
        cand = Path("/boot") / f"initrd.img-{os.uname().release}"
        if cand.exists():
            initrd = cand
    if initrd is None or not initrd.exists():
        die(
            "cannot determine the initrd"
            + (f" for kernel {args.kernel}" if args.kernel else "")
            + "; pass --initrd or --kernel"
        )

    running_cmdline_text = read_running_cmdline()
    include_initrd = cmdline_has_initrd(running_cmdline_text)

    cmdline_text = ""
    cmdline_arg = args.cmdline
    if (
        cmdline_arg is not None
        and entry is not None
        and cmdline_arg.resolve() == Path("/proc/cmdline").resolve()
    ):
        # The running cmdline contains the *old* initrd path on kernel updates.
        # Reconstruct it from the new entry instead.
        cmdline_arg = None

    if cmdline_arg is not None:
        if not cmdline_arg.exists():
            die(f"cmdline file not found: {cmdline_arg}")
        text = cmdline_arg.read_text(encoding="utf-8", errors="replace").strip()
        if not text and entry is not None:
            cmdline_text = build_kernel_cmdline(entry, include_initrd=include_initrd)
        elif re.search(r"(^|\s)initrd=", text):
            # Already a full /proc/cmdline-style string.
            cmdline_text = text
        elif entry is not None:
            cmdline_text = build_kernel_cmdline(
                entry, options=text, include_initrd=include_initrd
            )
        else:
            spec = _initrd_spec(initrd, boot.mount)
            cmdline_text = (
                f"initrd={uefi_path(spec)} {text}".strip() if include_initrd else text
            )
    else:
        if entry is not None:
            cmdline_text = build_kernel_cmdline(entry, include_initrd=include_initrd)
        else:
            for cand in (Path("/etc/kernel/cmdline"), Path("/proc/cmdline")):
                if cand.exists():
                    text = cand.read_text(encoding="utf-8", errors="replace").strip()
                    if text:
                        if re.search(r"(^|\s)initrd=", text):
                            cmdline_text = text
                        else:
                            spec = _initrd_spec(initrd, boot.mount)
                            cmdline_text = (
                                f"initrd={uefi_path(spec)} {text}".strip()
                                if include_initrd
                                else text
                            )
                        break
    if not cmdline_text:
        die("cannot determine the kernel command line; pass --cmdline")

    filter_cmdline(cmdline_text)
    cmdline_file = write_temp_text(cmdline_text)
    temporary.append(cmdline_file)
    return Path(initrd), cmdline_file, temporary


def cmd_update(args: argparse.Namespace) -> int:
    require_root()
    cfg = load_config(required=True)
    assert cfg is not None

    if cfg.mode != "pcrlock":
        if cfg.mode == "literal":
            log.warning(
                "literal PCR mode: the initrd/cmdline changed, so the current TPM seal "
                "will not match on the next boot. Boot with the LUKS passphrase or "
                f"recovery key, then run `{PROG} setup --mode=literal` to re-enroll."
            )
            save_config(cfg, args.dry_run)
            return 0
        die(f"unknown configured mode: {cfg.mode}")

    if 4 not in cfg.pcrs:
        die(
            "PCR 4 is mandatory: the kernel is measured there. Refusing to update "
            "a policy that does not bind the kernel."
        )

    version = args.kernel or os.uname().release
    boot = BootPartition(
        mount=Path(cfg.boot_mount),
        uuid=cfg.boot_uuid,
        fstype=cfg.boot_fstype,
    )
    running_cmdline_text = read_running_cmdline()
    if not running_cmdline_text:
        die("cannot read /proc/cmdline; refusing to predict the running boot")
    filter_cmdline(running_cmdline_text)

    target_cmdline_text, target_options = trusted_cmdline(args, cfg, version)
    if not target_cmdline_text:
        die("cannot determine the trusted kernel command line")

    # The running cmdline is included in the policy as a variant so the
    # currently running boot remains unlockable until the next reboot.  It must
    # match the cmdline verified by the last setup/update (and must never
    # contain a dangerous option).
    previous_cmdline = cfg.cmdline
    verify_running_cmdline(
        running_cmdline_text,
        previous=previous_cmdline,
        target=target_cmdline_text,
    )

    cfg.kernel_version = version
    cfg.cmdline = target_cmdline_text
    cfg.initrd = ""
    store = load_hash_store()

    if args.dry_run:
        log.info("[dry-run] would ingest kernel %s and generate an initrd", version)
        log.info("[dry-run] trusted cmdline: %s", target_cmdline_text)
        run_pcrlock_make_policy(cfg, dry_run=True)
        save_hash_store(store, dry_run=True)
        save_config(cfg, dry_run=True)
        return 0

    temp_initrd: Optional[Path] = None
    cmdline_file: Optional[Path] = None
    running_cmdline_file: Optional[Path] = None
    snapshot = PolicySnapshot.capture(cfg, boot, version)
    try:
        log.info("Refreshing luksury policy for kernel %s", version)

        kernel_source = resolve_kernel_source(
            version, cfg, hint=getattr(args, "kernel_image", None)
        )
        kernel_record = lock_pe_record(kernel_source)
        kernel_key = store_add(store, "kernel", kernel_record, "dpkg-md5+lock-pe")
        log.info("Ingested kernel %s (PCR 4 %s)", kernel_source, kernel_key[:16])

        temp_initrd = generate_initrd_temp(version)
        if initrd_has_luksury_hook(temp_initrd) is False:
            die(
                f"the regenerated initrd {temp_initrd} does not contain the luksury "
                "hook; check the dracut module installation and dracut configuration"
            )
        initrd_record = lock_initrd_record(temp_initrd)
        store_add(store, "initrd", initrd_record, "luksury-dracut")
        # Install the image before the policy/boot-loader checks.  If a check
        # below fails, the new kernel entry still has a valid initrd and can be
        # unlocked with the passphrase.
        install_initrd(temp_initrd, version, boot)

        ingested = ingest_bootloaders(store, cfg)
        target_bootloader = installed_bootloader_record(cfg, boot, ingested)

        cmdline_file = write_temp_text(target_cmdline_text)
        cmdline_record = lock_cmdline_record(cmdline_file)
        store_add(store, "cmdline", cmdline_record, "trusted-cmdline")
        running_cmdline_file = write_temp_text(running_cmdline_text)
        running_cmdline_record = lock_cmdline_record(running_cmdline_file)
        store_add(store, "cmdline", running_cmdline_record, "proc-cmdline")

        # Ensure the running kernel is identifiable in the event log.  This is
        # best effort only if the running kernel was ingested previously.
        ingest_running_kernel(store, cfg)

        binary = pcrlock_bin()
        if not binary:
            die("systemd-pcrlock was not found (install systemd >= 256)")
        cel = _pcrlock_cel_records(binary)
        if cel is None:
            die(
                "cannot read the TPM event log; refusing to predict the measured "
                "kernel and initrd"
            )
        running_cmdline_rec, running_initrd_rec = pcr9_running_records(cel)

        variants = prepare_pcrlock_components(
            cfg,
            store,
            target_kernel_record=kernel_record,
            target_bootloader_records=[target_bootloader],
            running_cmdline_record=running_cmdline_rec,
            running_initrd_record=running_initrd_rec,
            target_cmdline_record=cmdline_record,
            target_initrd_record=initrd_record,
        )
        verify_pcrlock_prediction(
            cfg,
            variants,
            target_cmdline_record=cmdline_record,
            target_initrd_record=initrd_record,
        )
        verify_installed_entry(
            cfg,
            boot,
            version,
            target_initrd_basename(version),
            target_options,
            store=store,
        )

        old_policy: Optional[str] = None
        try:
            old_policy = PCRLOCK_JSON.read_text(encoding="utf-8")
        except OSError:
            pass
        run_pcrlock_make_policy(cfg)
        try:
            policy_changed = PCRLOCK_JSON.read_text(encoding="utf-8") != old_policy
        except OSError:
            policy_changed = True
        verify_pcrlock_policy(
            cfg,
            variants,
            target_cmdline_record=cmdline_record,
            target_initrd_record=initrd_record,
        )
        verify_boot_credential(cfg, verify_content=policy_changed)
        refresh_legacy_boot_policy(cfg)
        install_runtime_policy()
        save_hash_store(store)
        log.info("pcrlock policy refreshed; no LUKS re-enrollment needed")
    except Exception:
        snapshot.restore()
        raise
    finally:
        for path in (temp_initrd, cmdline_file, running_cmdline_file):
            if path is not None:
                path.unlink(missing_ok=True)

    snapshot.commit()
    refresh_boot_update_dropin(args.dry_run)
    save_config(cfg, args.dry_run)
    return 0


def cmd_refresh_bootloader(args: argparse.Namespace) -> int:
    """Refresh the PCR 4 prediction after a boot loader update.

    The installed systemd-boot PE is matched to a trusted root-filesystem PE;
    only that PE's stored hash is used for prediction.  The running kernel,
    initrd and cmdline records stay unchanged: the previously locked 710/720
    components are preserved and are never rebuilt from the current boot.
    """
    require_root()
    cfg = load_config(required=True)
    assert cfg is not None
    if cfg.mode != "pcrlock":
        return 0
    if 4 not in cfg.pcrs:
        die(
            "PCR 4 is mandatory: the kernel is measured there. Refusing to refresh "
            "a policy that does not bind the kernel."
        )

    boot = BootPartition(
        mount=Path(cfg.boot_mount),
        uuid=cfg.boot_uuid,
        fstype=cfg.boot_fstype,
    )
    store = load_hash_store()

    if args.dry_run:
        log.info("[dry-run] would ingest the installed boot loader PE")
        run_pcrlock_make_policy(cfg, dry_run=True)
        save_hash_store(store, dry_run=True)
        return 0

    ingested = ingest_bootloaders(store, cfg)
    target_bootloader = installed_bootloader_record(cfg, boot, ingested)
    snapshot = PolicySnapshot.capture(cfg, boot, os.uname().release)
    try:
        ingest_running_kernel(store, cfg)
        binary = pcrlock_bin()
        if not binary:
            die("systemd-pcrlock was not found (install systemd >= 256)")
        cel = _pcrlock_cel_records(binary)
        if cel is None:
            die("cannot read the TPM event log; refusing to refresh the boot loader policy")

        records = _pcr4_records(cel)
        if not records:
            die("the TPM event log contains no PCR 4 measurements")

        # The running kernel record must exist in the store; find it from the
        # measured records so the target kernel stays the running one.
        kernel_hits = _match_store_records(records, store, "kernel")
        if len(kernel_hits) != 1:
            die(
                "cannot identify the running kernel measurement in PCR 4; refusing to "
                "refresh the boot loader policy"
            )
        kernel_key = kernel_hits[0][1]
        target_kernel_record = store_record_for_key(store, kernel_key)
        if target_kernel_record is None:
            die("internal error: the running kernel is missing from the hash store")

        variants = prepare_pcrlock_components(
            cfg,
            store,
            target_kernel_record=target_kernel_record,
            target_bootloader_records=[target_bootloader],
            preserve_pcr9=True,
        )
        # The current PCR 9 must still be covered by the preserved components.
        # A boot whose cmdline/initrd is not in the last verified set (for example
        # after a manual passphrase unlock of a tampered boot) fails here instead
        # of being promoted into the TPM policy.
        verify_pcrlock_prediction(cfg, variants)

        old_policy: Optional[str] = None
        try:
            old_policy = PCRLOCK_JSON.read_text(encoding="utf-8")
        except OSError:
            pass
        run_pcrlock_make_policy(cfg)
        try:
            policy_changed = PCRLOCK_JSON.read_text(encoding="utf-8") != old_policy
        except OSError:
            policy_changed = True
        verify_pcrlock_policy(cfg, variants)
        verify_boot_credential(cfg, verify_content=policy_changed)
        install_runtime_policy()
        save_hash_store(store)
        log.info("boot loader PCR 4 policy refreshed")
    except Exception:
        snapshot.restore()
        raise
    snapshot.commit()
    refresh_boot_update_dropin(args.dry_run)
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    cfg = load_config(required=False)
    print(f"{PROG} {VERSION}")
    print()

    dev: Optional[Path] = None
    try:
        dev, name = find_root_luks()
    except LuksuryError as exc:
        name = ""
        print(f"Root LUKS device: unknown ({exc})")
        if cfg and cfg.luks_device:
            dev = Path(cfg.luks_device)
            name = cfg.luks_name
    if dev is not None:
        print(f"Root LUKS device: {dev} ({name})")
        try:
            check_luks2(dev)
            print("LUKS version:     2")
        except LuksuryError:
            print("LUKS version:     unknown (run as root to inspect the header)")

    if cfg is None:
        print("Configuration:    not configured (run `luksury setup`)")
    else:
        print(f"Configuration:    {CONFIG_FILE}")
        print(f"Mode:             {cfg.mode}")
        print(f"Configured PCRs:  {', '.join(map(str, cfg.pcrs))}")
        print(f"Boot partition:   {cfg.boot_mount} (UUID={cfg.boot_uuid or '?'}, {cfg.boot_fstype or '?'})")
        print(
            f"Credential part.: {cfg.credential_mount or cfg.boot_mount} "
            f"(UUID={cfg.credential_uuid or cfg.boot_uuid or '?'}, "
            f"PARTUUID={cfg.credential_partuuid or '?'}, "
            f"device={cfg.credential_device or '?'})"
        )
        print(f"Kernel version:   {cfg.kernel_version or '?'}")
        print(f"Hash store:       {HASH_STORE}")
        print(f"Cmdline:          {cfg.cmdline or '?'}")
        print(f"pcrlock location: {cfg.pcrlock_location}")

    try:
        store = load_hash_store()
    except LuksuryError:
        store = {"entries": {}}
    entries = store.get("entries", {}) if isinstance(store, dict) else {}
    counts: dict[str, int] = {}
    if isinstance(entries, dict):
        for entry in entries.values():
            if isinstance(entry, dict):
                kind = str(entry.get("kind", "?"))
                counts[kind] = counts.get(kind, 0) + 1
    print(
        "Trusted hashes:   "
        + ", ".join(f"{kind}={count}" for kind, count in sorted(counts.items()))
        if counts
        else "Trusted hashes:   none"
    )

    if dev is not None:
        print(f"TPM2 token:       {'yes' if luks_has_token(dev, 'systemd-tpm2') else 'no'}")
        print(f"Recovery token:   {'yes' if luks_has_token(dev, 'systemd-recovery') else 'no'}")

    pcrs = pcrlock_policy_pcrs()
    if PCRLOCK_JSON.exists():
        if pcrs is None and os.geteuid() != 0 and not os.access(PCRLOCK_JSON, os.R_OK):
            pcrs_text = "unreadable (run as root)"
        else:
            pcrs_text = "unparseable" if pcrs is None else (", ".join(map(str, pcrs)) or "none")
        print(f"pcrlock policy:   {PCRLOCK_JSON} (PCRs: {pcrs_text})")
    else:
        print(f"pcrlock policy:   {PCRLOCK_JSON} (missing)")

    if cfg and cfg.mode == "pcrlock" and 4 in cfg.pcrs:
        state = "present" if PCRLOCK_PRIVATE_COMPONENTS.is_dir() else "missing"
        print(f"PCR 4 components: {PCRLOCK_PRIVATE_COMPONENTS} ({state})")

    if PCRLOCK_RUNTIME.exists():
        try:
            if PCRLOCK_JSON.exists():
                match = "match" if sha256_file(PCRLOCK_RUNTIME) == sha256_file(PCRLOCK_JSON) else "MISMATCH"
            else:
                match = "unknown"
        except OSError:
            match = "unreadable (run as root)"
        print(f"Runtime policy:   {PCRLOCK_RUNTIME} ({match})")
    else:
        print(f"Runtime policy:   {PCRLOCK_RUNTIME} (missing; installed for the self-test)")

    if cfg and (cfg.credential_mount or cfg.boot_mount):
        credentials = boot_credential_paths(cfg)
        if credentials:
            for credential in credentials:
                print(f"Boot credential:  {credential}")
        else:
            print(
                "Boot credential:  missing "
                "(expected $BOOT/loader/credentials/pcrlock.*.cred from systemd-pcrlock)"
            )

    hooks = {
        "kernel-install": KERNEL_INSTALL_HOOK,
        "initramfs": INITRAMFS_HOOK,
        "pacman": PACMAN_HOOK,
        "dracut module": DRACUT_MODULE_DIR / "module-setup.sh",
        "dracut conf": DRACUT_CONF,
        "boot update": BOOT_UPDATE_DROPIN,
    }
    print("Hooks:")
    for label, path in hooks.items():
        print(f"  {label:15s} {'yes' if path.exists() else 'no'}  {path}")

    bc = bootctl_bin()
    if bc:
        cp = run([bc, "status"], capture=True, check=False)
        for line in cp.stdout.splitlines():
            if "Secure Boot:" in line or "TPM:" in line:
                print(line.strip())
    return 0


def cmd_remove(args: argparse.Namespace) -> int:
    require_root()
    cfg = load_config(required=False)
    dev: Optional[Path] = None
    try:
        dev, name = find_root_luks()
    except LuksuryError:
        name = ""
    if dev is None and cfg and cfg.luks_device:
        dev = Path(cfg.luks_device)
        name = cfg.luks_name
    if dev is None:
        die("cannot determine the root LUKS device")

    if not confirm(
        "Remove the TPM2 auto-unlock token and luksury hooks? "
        "The LUKS passphrase and recovery key will remain.",
        args.yes,
    ):
        die("aborted")

    if luks_has_token(dev, "systemd-tpm2"):
        run([cryptenroll_bin(), "--wipe-slot=tpm2", str(dev)], dry_run=args.dry_run)
        log.info("Removed the systemd-tpm2 token from %s", dev)

    if args.remove_pcrlock:
        binary = pcrlock_bin()
        if binary:
            cp = run([binary, "remove-policy"], check=False, dry_run=args.dry_run)
            if cp.returncode == 0:
                log.info("Removed the systemd-pcrlock policy")
            else:
                log.warning(
                    "Could not remove the systemd-pcrlock policy: %s",
                    (cp.stderr or cp.stdout or "").strip(),
                )
        else:
            log.warning("systemd-pcrlock was not found; policy not removed")
    elif PCRLOCK_JSON.exists():
        log.warning("Leaving the systemd-pcrlock policy in place (use --remove-pcrlock to remove it)")

    if cfg is None:
        cfg = Config(luks_device=str(dev), luks_name=name)
    set_crypttab_tpm(dev, cfg, remove=True, dry_run=args.dry_run)

    remove_file(KERNEL_INSTALL_HOOK, args.dry_run)
    remove_file(INITRAMFS_HOOK, args.dry_run)
    remove_file(PACMAN_HOOK, args.dry_run)
    remove_tree(DRACUT_MODULE_DIR, args.dry_run)
    remove_file(DRACUT_CONF, args.dry_run)
    remove_file(Path("/usr/lib/dracut/dracut.conf.d/80-luksury.conf"), args.dry_run)
    remove_file(PCRLOCK_RUNTIME, args.dry_run)
    remove_tree(PCRLOCK_PRIVATE_COMPONENTS, args.dry_run)
    remove_file(BOOT_UPDATE_DROPIN, args.dry_run)
    if not args.dry_run and BOOT_UPDATE_DROPIN.parent.exists():
        try:
            BOOT_UPDATE_DROPIN.parent.rmdir()
        except OSError:
            pass
    daemon_reload(args.dry_run)

    if cfg.boot_mount:
        # luksury <= 2.0 wrote its own policy copy here.  Remove it on upgrade
        # or uninstall; 2.1 uses systemd-pcrlock's loader/credentials instead.
        legacy = (
            Path(cfg.boot_mount)
            / LEGACY_BOOT_POLICY_SUBDIR
            / LEGACY_BOOT_POLICY_NAME
        )
        remove_file(legacy, args.dry_run)
        # Remove the directory only if it is empty.
        if not args.dry_run and legacy.parent.exists():
            try:
                legacy.parent.rmdir()
            except OSError:
                pass

    remove_file(HASH_STORE, args.dry_run)
    remove_file(STATE_FILE, args.dry_run)
    if not args.dry_run and STATE_DIR.exists() and not any(STATE_DIR.iterdir()):
        try:
            STATE_DIR.rmdir()
        except OSError:
            pass
    remove_file(CONFIG_FILE, args.dry_run)
    if not args.dry_run and CONFIG_DIR.exists() and not any(CONFIG_DIR.iterdir()):
        try:
            CONFIG_DIR.rmdir()
        except OSError:
            pass

    if not args.keep_binary:
        src = Path(sys.argv[0])
        try:
            src = src.resolve()
        except OSError:
            src = Path("")
        if src != INSTALLED_BIN:
            remove_file(INSTALLED_BIN, args.dry_run)

    if args.rebuild_initramfs:
        version = cfg.kernel_version or os.uname().release
        regenerate_initramfs(
            Path("/boot") / f"initrd.img-{version}",
            version,
            args.dry_run,
        )
    else:
        log.info(
            "Leaving the current initrd unchanged. It still contains the luksury hook "
            "until the next kernel/initrd rebuild; the hook is harmless because the "
            "TPM token is gone. Rebuild explicitly with --rebuild-initramfs if desired."
        )

    print(
        "luksury integration removed.  The LUKS passphrase/recovery key remain."
    )
    return 0


