        command("tpm2_evictcontrol -C o -c "+persistent_address.decode())
    
    #upload  /crypto_keyfile_bytelocker.bin to TPM with the calculated PCRs
    command("tpm2_createprimary -c " +DATADIR+ "primary.ctx -Q")
