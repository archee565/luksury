@dataclasses.dataclass
class Config:
    mode: str = "pcrlock"  # pcrlock | literal
    pcrs: list[int] = dataclasses.field(default_factory=lambda: list(DEFAULT_PCRLOCK_PCRS))
    pcrlock_location: str = DEFAULT_PCRLOCK_LOCATION
    lock_gpt: bool = False
    boot_uuid: str = ""
    boot_fstype: str = ""
    boot_mount: str = ""
    boot_device: str = ""
    # systemd-pcrlock writes its policy as a credential to $BOOT/loader/credentials.
    # $BOOT can be on XBOOTLDR while loader.conf lives on the ESP, so keep the
    # credential partition separate from the boot-entry partition.
    credential_uuid: str = ""
    credential_fstype: str = ""
    credential_mount: str = ""
    # Stable identifiers for the credential partition.  The initramfs hook
    # verifies the mounted device against these before trusting its contents.
    credential_partuuid: str = ""
    credential_device: str = ""
    bootloader_pes: list[str] = dataclasses.field(default_factory=list)
    luks_device: str = ""
    luks_name: str = ""
    luks_uuid: str = ""
    initrd: str = ""
    cmdline: str = ""
    kernel_version: str = ""
    created_by: str = VERSION

    def to_json(self) -> str:
        return json.dumps(dataclasses.asdict(self), indent=2, sort_keys=True) + "\n"

    @classmethod
    def from_dict(cls, data: dict[str, Any]) -> "Config":
        known = {f.name for f in dataclasses.fields(cls)}
        return cls(**{k: v for k, v in data.items() if k in known})


def load_config(required: bool = False) -> Optional[Config]:
    if not CONFIG_FILE.exists():
        if required:
            die(f"{CONFIG_FILE} does not exist; run `{PROG} setup` first")
        return None
    try:
        data = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
        cfg = Config.from_dict(data)
        # 770 was the old default.  On classic systemd-boot, systemd 261's
        # 750-os-separator component is never measured, and because it touches
        # PCR 9 pcrlock would drop PCR 9 entirely.  Migrate to 740.
        if cfg.mode == "pcrlock" and cfg.pcrlock_location == "770":
            log.warning(
                "migrating pcrlock location from 770 to %s for classic systemd-boot",
                DEFAULT_PCRLOCK_LOCATION,
            )
            cfg.pcrlock_location = DEFAULT_PCRLOCK_LOCATION
        # 2.0.x defaulted to PCR 7 and 9 only.  Add the boot loader (PCR 4) for
        # existing installs unless the user explicitly configured something else.
        if (
            cfg.mode == "pcrlock"
            and sorted(cfg.pcrs) == [7, 9]
            and cfg.created_by.startswith("2.0")
        ):
            log.warning(
                "migrating the default PCR set from 7,9 to 4,7,9 to include the boot loader"
            )
            cfg.pcrs = list(DEFAULT_PCRLOCK_PCRS)
            cfg.created_by = VERSION
        return cfg
    except (OSError, ValueError, TypeError) as exc:
        die(f"cannot read {CONFIG_FILE}: {exc}")


def save_config(cfg: Config, dry_run: bool = False) -> None:
    atomic_write(CONFIG_FILE, cfg.to_json(), 0o644, dry_run)
    # Keep a copy in /var/lib for status/update if /etc is reset.
    atomic_write(STATE_FILE, cfg.to_json(), 0o644, dry_run)


def parse_pcr_list(value: str) -> list[int]:
    parts = re.split(r"[,\s+]+", value.strip())
    result: list[int] = []
    for part in parts:
        if not part:
            continue
        try:
            idx = int(part)
        except ValueError:
            die(f"invalid PCR index: {part!r}")
        if not 0 <= idx <= 23:
            die(f"PCR index out of range: {idx}")
        if idx not in result:
            result.append(idx)
    if not result:
        die("empty PCR list")
    return result


# ---------------------------------------------------------------------------
# Trusted hash store
# ---------------------------------------------------------------------------
#
# The store contains digest records produced by systemd-pcrlock lock-*.  It is
# keyed by the SHA-256 digest of the artifact.  Nothing from the ESP or /boot
# is used as a prediction input: the store is populated once from a generated
# or package-verified artifact, and prediction is built from these records and
# from the current TPM event log.

HASH_STORE_VERSION = 1


def _digest_map(record: dict[str, Any]) -> dict[str, str]:
    result: dict[str, str] = {}
    for item in record.get("digests", []):
        if not isinstance(item, dict):
            continue
        alg = item.get("hashAlg")
        digest = item.get("digest")
        if isinstance(alg, str) and isinstance(digest, str):
            result[alg.lower()] = digest.lower()
    return result


def _record_key(record: dict[str, Any]) -> str:
    digests = _digest_map(record)
    key = digests.get("sha256")
    if not key:
        die("a pcrlock record without a SHA-256 digest cannot be stored")
    return key


def _slim_record(record: dict[str, Any]) -> dict[str, Any]:
    pcr = record.get("pcr")
    if not isinstance(pcr, int):
        die("a pcrlock record without a PCR index cannot be stored")
    digests = [
        {"hashAlg": item["hashAlg"], "digest": item["digest"]}
        for item in record.get("digests", [])
        if isinstance(item, dict)
        and isinstance(item.get("hashAlg"), str)
        and isinstance(item.get("digest"), str)
    ]
    if not digests:
        die("a pcrlock record without digests cannot be stored")
    return {"pcr": pcr, "digests": digests}


def load_hash_store() -> dict[str, Any]:
    if not HASH_STORE.exists():
        return {"version": HASH_STORE_VERSION, "entries": {}}
    try:
        data = json.loads(HASH_STORE.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        die(f"cannot read the trusted hash store {HASH_STORE}: {exc}")
    if not isinstance(data, dict) or not isinstance(data.get("entries"), dict):
        die(f"the trusted hash store {HASH_STORE} is malformed")
    data.setdefault("version", HASH_STORE_VERSION)
    return data


def save_hash_store(store: dict[str, Any], dry_run: bool = False) -> None:
    text = json.dumps(store, indent=2, sort_keys=True) + "\n"
    if dry_run:
        log.info("[dry-run] would write %s", HASH_STORE)
        return
    atomic_write(HASH_STORE, text, 0o600)


def store_add(
    store: dict[str, Any],
    kind: str,
    record: dict[str, Any],
    provenance: str,
) -> str:
    record = _slim_record(record)
    key = _record_key(record)
    entries = store.setdefault("entries", {})
    existing = entries.get(key)
    if isinstance(existing, dict) and existing.get("kind") == kind:
        # Refresh provenance/time but keep the record identical.
        existing["provenance"] = provenance
        existing["added"] = _dt.datetime.now().isoformat(timespec="seconds")
        return key
    entries[key] = {
        "kind": kind,
        "record": record,
        "provenance": provenance,
        "added": _dt.datetime.now().isoformat(timespec="seconds"),
    }
    return key


def store_entries(store: dict[str, Any], kind: str) -> list[tuple[str, dict[str, Any]]]:
    result: list[tuple[str, dict[str, Any]]] = []
    entries = store.get("entries")
    if not isinstance(entries, dict):
        return result
    for key, entry in entries.items():
        if not isinstance(entry, dict):
            continue
        if entry.get("kind") != kind:
            continue
        record = entry.get("record")
        if isinstance(record, dict):
            result.append((key, record))
    return result


def store_record_for_key(store: dict[str, Any], key: str) -> Optional[dict[str, Any]]:
    entry = store.get("entries", {}).get(key)
    if isinstance(entry, dict) and isinstance(entry.get("record"), dict):
        return entry["record"]
    return None


def store_match(store: dict[str, Any], kind: str, record: dict[str, Any]) -> Optional[str]:
    """Return the store key if this record is a known artifact of ``kind``."""
    digest = _digest_map(record).get("sha256")
    if digest is None:
        return None
    for key, known in store_entries(store, kind):
        if _digest_map(known).get("sha256") == digest:
            return key
    return None


def assert_not_boot_partition(path: Path, cfg: Config, what: str = "prediction input") -> None:
    """Reject a path that lives on the unencrypted boot/credential partition."""
    roots: list[Path] = []
    for raw in (cfg.boot_mount, cfg.credential_mount):
        if raw:
            try:
                roots.append(Path(raw).resolve())
            except OSError:
                roots.append(Path(raw))
    try:
        resolved = Path(path).resolve()
    except OSError:
        resolved = Path(path)
    for root in roots:
        try:
            resolved.relative_to(root)
        except ValueError:
            continue
        die(
            f"{what} {path} is on the unencrypted boot partition ({root}); "
            "refusing to use it for PCR prediction"
        )


# ---------------------------------------------------------------------------
# Device, boot layout, LUKS and crypttab helpers
# ---------------------------------------------------------------------------


@dataclasses.dataclass
class BootPartition:
    mount: Path
    uuid: str
    fstype: str
    device: str = ""


@dataclasses.dataclass
class BootEntry:
    path: Path
    title: str
    kernel: Optional[Path]
    initrds: list[Path]
    options: str
    version: str = ""
    sort_key: str = ""
    # Raw initrd values as written in the boot entry (relative to the boot
    # partition).  Needed to reconstruct the kernel's "initrd=" cmdline prefix.
    initrd_specs: list[str] = dataclasses.field(default_factory=list)
    is_uki: bool = False


def is_block_device(path: Path) -> bool:
    try:
        return stat.S_ISBLK(path.stat().st_mode)
    except OSError:
        return False


def _dev_path(name: str) -> Path:
    """Resolve a kernel block-device name to a /dev path."""
    for cand in (Path("/dev") / name, Path("/dev/mapper") / name):
        if is_block_device(cand):
            return cand
    return Path("/dev") / name


def find_root_luks() -> tuple[Path, str]:
    """Return (LUKS container device, mapper name) backing /.

    The mapper (e.g. /dev/mapper/luks-...) is the *decrypted* device; the LUKS
    header lives on its parent partition.  systemd-cryptenroll and
    cryptsetup luksDump need the parent, not the mapper.
    """
    src = run_capture(["findmnt", "-n", "-o", "SOURCE", "/"])
    if not src:
        die("cannot determine the root filesystem source")
    src = src.split("[", 1)[0]
    src_path = Path(src)

    # Walk the device stack upwards (root -> LVM -> LUKS -> partition).
    cp = run(
        ["lsblk", "-s", "-n", "-o", "NAME,TYPE,PKNAME", src],
        capture=True,
        check=False,
    )
    if cp.returncode == 0:
        lines = [line.split() for line in cp.stdout.splitlines() if line.strip()]
        for idx, fields in enumerate(lines):
            if len(fields) < 2 or fields[1] != "crypt":
                continue
            mapper = fields[0]

            # Prefer sysfs: the slaves of a dm-crypt device are its backing
            # devices, independent of the confusing PKNAME column in reverse
            # lsblk output.
            kname = run_capture(["lsblk", "-no", "KNAME", f"/dev/mapper/{mapper}"], check=False)
            slaves_dir = Path("/sys/class/block") / (kname or mapper) / "slaves"
            candidates: list[str] = []
            if slaves_dir.is_dir():
                candidates.extend(sorted(p.name for p in slaves_dir.iterdir()))

            # Reverse lsblk prints the immediate parent on the next line.
            if idx + 1 < len(lines):
                candidates.append(lines[idx + 1][0])
            if len(fields) >= 3 and fields[2]:
                candidates.append(fields[2])

            for parent in candidates:
                dev = _dev_path(parent)
                if is_block_device(dev) and is_luks(dev):
                    return dev, mapper

    # Root itself may be the LUKS container (unusual, but handle it).
    for cand in (src_path, Path("/dev/mapper") / src_path.name, Path("/dev") / src_path.name):
        if is_block_device(cand) and is_luks(cand):
            return cand, src_path.name

    die("the root filesystem does not appear to be on a LUKS device")


def is_luks(dev: Path) -> bool:
    cs = cryptsetup_bin()
    cp = run([cs, "isLuks", str(dev)], capture=True, check=False)
    return cp.returncode == 0


def check_luks2(dev: Path) -> None:
    cs = cryptsetup_bin()
    out = run([cs, "luksDump", str(dev)], capture=True).stdout
    version = None
    for line in out.splitlines():
        m = re.match(r"\s*Version:\s*(\S+)", line)
        if m:
            version = m.group(1)
            break
    if version is None:
        die(f"cannot determine the LUKS version of {dev}")
    if version != "2":
        die(
            f"{dev} is LUKS{version}; systemd-cryptenroll requires LUKS2. "
            "Convert it first with: cryptsetup convert --type luks2 <device>"
        )


def luks_uuid(dev: Path) -> str:
    return run_capture([cryptsetup_bin(), "luksUUID", str(dev)])


def luks_has_token(dev: Path, token_type: str) -> bool:
    cs = cryptsetup_bin()
    cp = run([cs, "luksDump", "--dump-json-metadata", str(dev)], capture=True, check=False)
    if cp.returncode == 0:
        try:
            data = json.loads(cp.stdout)
        except ValueError:
            data = {}
        tokens = data.get("tokens") or {}
        for token in tokens.values():
            if isinstance(token, dict) and token.get("type") == token_type:
                return True
        return False
    # Older cryptsetup: fall back to text.
    text = run([cs, "luksDump", str(dev)], capture=True, check=False).stdout
    return token_type in text


def partition_partuuid(device: str) -> str:
    """Return the GPT PARTUUID for a block device, or an empty string."""
    if not device:
        return ""
    lsblk = which("lsblk", fallbacks=("/usr/bin/lsblk", "/bin/lsblk"))
    if not lsblk:
        return ""
    cp = run([lsblk, "-no", "PARTUUID", device], capture=True, check=False)
    if cp.returncode == 0:
        value = cp.stdout.strip().splitlines()
        if value:
            return value[0].strip()
    return ""


def find_boot_partition() -> BootPartition:
    candidates: list[Path] = []

    bc = bootctl_bin()
    if bc:
        for arg in ("--print-boot-path", "--print-esp-path"):
            cp = run([bc, arg], capture=True, check=False)
            if cp.returncode == 0 and cp.stdout.strip():
                candidates.append(Path(cp.stdout.strip()))

    candidates.extend([Path("/boot"), Path("/boot/efi"), Path("/efi"), Path("/esp")])

    seen: set[Path] = set()
    for cand in candidates:
        try:
            cand = cand.resolve()
        except OSError:
            continue
        if cand in seen:
            continue
        seen.add(cand)
        if not (cand / "loader" / "loader.conf").exists():
            continue

        cp = run(
            ["findmnt", "-n", "-o", "UUID,FSTYPE,SOURCE,TARGET", "--target", str(cand)],
            capture=True,
            check=False,
        )
        if cp.returncode == 0 and cp.stdout.strip():
            fields = cp.stdout.split()
            if len(fields) >= 4 and fields[3] != "/":
                fs_mount = Path(fields[3])
                if cand != fs_mount:
                    die(
                        f"loader.conf is at {cand}, but its filesystem is mounted at "
                        f"{fs_mount}. This layout is not supported; the pcrlock policy "
                        "must be at the root of the boot partition."
                    )
                return BootPartition(
                    mount=cand,
                    uuid=fields[0],
                    fstype=fields[1],
                    device=fields[2],
                )
            # If the loader directory is on the root filesystem, the initramfs
            # cannot read it before unlocking.  Keep looking for an ESP.
            log.debug("%s has loader.conf but is on the root filesystem", cand)

    die(
        "cannot find the systemd-boot partition (no loader/loader.conf on a "
        "separate unencrypted partition). The classic-boot design needs the "
        "pcrlock credential to be readable from the boot partition before unlocking."
    )


def find_credential_partition() -> Optional[BootPartition]:
    """Return the partition systemd-pcrlock writes loader/credentials to.

    systemd-pcrlock prefers XBOOTLDR over the ESP, exactly like bootctl's
    --print-boot-path.  This can be a different partition than the one holding
    loader.conf, so the initramfs must mount the credential partition itself.
    """
    bc = bootctl_bin()
    if not bc:
        return None
    for arg in ("--print-boot-path", "--print-esp-path"):
        cp = run([bc, arg], capture=True, check=False)
        if cp.returncode != 0 or not cp.stdout.strip():
            continue
        path = Path(cp.stdout.strip())
        if not path.exists():
            continue
        cp = run(
            ["findmnt", "-n", "-o", "UUID,FSTYPE,SOURCE,TARGET", "--target", str(path)],
            capture=True,
            check=False,
        )
        if cp.returncode != 0 or not cp.stdout.strip():
            continue
        fields = cp.stdout.split()
        if len(fields) < 4 or fields[3] == "/":
            continue
        return BootPartition(
            mount=Path(fields[3]),
            uuid=fields[0],
            fstype=fields[1],
            device=fields[2],
        )
    return None


def credential_partition(cfg: Config) -> BootPartition:
    return BootPartition(
        mount=Path(cfg.credential_mount or cfg.boot_mount),
        uuid=cfg.credential_uuid or cfg.boot_uuid,
        fstype=cfg.credential_fstype or cfg.boot_fstype,
    )


def boot_credential_paths(cfg: Config) -> list[Path]:
    if not (cfg.credential_mount or cfg.boot_mount):
        return []
    part = credential_partition(cfg)
    return sorted((part.mount / "loader" / "credentials").glob("pcrlock.*.cred"))


def _policy_without_pin(text: str) -> str:
    """Return a canonical policy representation without the sealed pcrlock PIN."""
    try:
        data = json.loads(text)
    except (TypeError, ValueError):
        return text.strip()
    if isinstance(data, dict):
        data.pop("pinPrivate", None)
        return json.dumps(data, sort_keys=True, separators=(",", ":"))
    return text.strip()


def secure_pcrlock_permissions(paths: Iterable[Path], dry_run: bool = False) -> None:
    """Make policy/credential files root-only (best effort on vfat)."""
    for path in paths:
        path = Path(path)
        if not path.exists():
            continue
        if dry_run:
            log.info("[dry-run] would chmod 0600 %s", path)
            continue
        try:
            os.chmod(path, 0o600)
        except OSError as exc:
            log.warning("cannot make %s root-only: %s", path, exc)


def _strip_credential_pin(path: Path, dry_run: bool = False) -> None:
    """Replace the sealed pcrlock PIN in the boot credential with a dummy.

    systemd-cryptsetup only needs the policy fields from the credential; the
    sealed recovery PIN is used by systemd-pcrlock when updating the NV policy.
    Keeping it on the unencrypted ESP lets a local user who can read the ESP and
    access the TPM unseal the PIN and rewrite the NV policy.  Strip it from the
    boot copy while leaving /var/lib/systemd/pcrlock.json intact for root.
    """
    sc = systemd_creds_bin()
    if not sc:
        return
    path = Path(path)
    if not path.is_file():
        return
    name = path.name[: -len(".cred")] if path.name.endswith(".cred") else path.name
    cp = run(
        [sc, "decrypt", "--allow-null", f"--name={name}", str(path), "-"],
        capture=True,
        check=False,
    )
    if cp.returncode != 0:
        log.warning("cannot read pcrlock boot credential %s for PIN stripping: %s", path, (cp.stderr or cp.stdout or "").strip())
        return
    try:
        data = json.loads(cp.stdout)
    except ValueError:
        log.warning("cannot parse pcrlock boot credential %s for PIN stripping", path)
        return
    if not isinstance(data, dict) or "pinPrivate" not in data:
        return
    current = data.get("pinPrivate")
    if isinstance(current, str):
        try:
            if base64.b64decode(current, validate=False).startswith(b"luksury-stripped-pin"):
                secure_pcrlock_permissions([path], dry_run)
                return
        except Exception:
            pass
    if dry_run:
        log.info("[dry-run] would strip pinPrivate from %s", path)
        return
    data["pinPrivate"] = base64.b64encode(b"luksury-stripped-pin").decode()
    text = json.dumps(data, sort_keys=True, separators=(",", ":"))
    tmp_plain: Optional[Path] = None
    tmp_cred: Optional[Path] = None
    try:
        fd, plain_name = tempfile.mkstemp(prefix=".luksury-pcred.", suffix=".json")
        tmp_plain = Path(plain_name)
        with os.fdopen(fd, "wb") as f:
            f.write(text.encode())
        fd, cred_name = tempfile.mkstemp(
            prefix=f".{path.name}.", suffix=".tmp", dir=str(path.parent)
        )
        os.close(fd)
        tmp_cred = Path(cred_name)
        cp = run(
            [
                sc,
                "encrypt",
                "--with-key=null",
                f"--name={name}",
                str(tmp_plain),
                str(tmp_cred),
            ],
            capture=True,
            check=False,
        )
        if cp.returncode != 0:
            log.warning(
                "cannot rewrite pcrlock boot credential %s without pinPrivate: %s",
                path,
                (cp.stderr or cp.stdout or "").strip(),
            )
            return
        os.chmod(tmp_cred, 0o600)
        os.replace(tmp_cred, path)
        os.sync()
        log.info("Stripped the sealed pcrlock PIN from boot credential %s", path)
    except OSError as exc:
        log.warning("cannot strip the pcrlock PIN from %s: %s", path, exc)
    finally:
        if tmp_plain is not None:
            tmp_plain.unlink(missing_ok=True)
        if tmp_cred is not None:
            tmp_cred.unlink(missing_ok=True)
    secure_pcrlock_permissions([path], dry_run)


def _harden_boot_credentials(paths: Iterable[Path], dry_run: bool = False) -> None:
    for path in paths:
        _strip_credential_pin(path, dry_run)
    secure_pcrlock_permissions(paths, dry_run)


def warn_if_tpm_device_world_accessible() -> None:
    """Warn when the TPM is usable by non-root users (pcrlock PIN exposure)."""
    for name in ("/dev/tpmrm0", "/dev/tpm0"):
        try:
            st = os.stat(name)
        except OSError:
            continue
        mode = stat.S_IMODE(st.st_mode)
        if not (mode & 0o077):
            continue
        try:
            group = grp.getgrgid(st.st_gid).gr_name
        except KeyError:
            group = str(st.st_gid)
        members = ""
        try:
            members = ", ".join(grp.getgrnam(group).gr_mem)
        except KeyError:
            pass
        detail = f"; group members: {members}" if members else ""
        log.warning(
            "TPM device %s is accessible to group %s (mode %04o)%s. "
            "A local user with TPM access can unseal systemd-pcrlock's sealed "
            "recovery PIN and rewrite the NV policy. Restrict the device to root "
            "or ensure only trusted users are in that group.",
            name,
            group,
            mode,
            detail,
        )


def _read_kv_file(path: Path) -> list[tuple[str, str]]:
    result: list[tuple[str, str]] = []
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return result
    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        match = re.match(r"^(\S+)\s+(.*)$", line)
        if not match:
            continue
        result.append((match.group(1), match.group(2).strip()))
    return result


def find_default_entry(
    boot: BootPartition, *, strict_default: bool = False
) -> BootEntry:
    loader_dir = boot.mount / "loader"
    entries_dir = loader_dir / "entries"

    default = ""
    for key, value in _read_kv_file(loader_dir / "loader.conf"):
        if key == "default":
            default = value
            break

    explicit = False
    entry_files: list[Path] = []
    if default and default not in ("@saved", "@current"):
        explicit = True
        if not default.endswith(".conf"):
            default += ".conf"
        if any(ch in default for ch in "*?["):
            entry_files = sorted(p for p in entries_dir.glob("*") if fnmatch.fnmatch(p.name, default))
        else:
            entry_files = [entries_dir / default]
    elif default in ("@saved", "@current"):
        # @saved and @current are resolved by systemd-boot through EFI
        # variables.  Read them instead of guessing, so the entry verified here
        # is the entry the firmware will actually boot.
        variables = (
            ("LoaderEntryDefault", "LoaderEntryLastBooted", "LoaderEntrySelected")
            if default == "@saved"
            else ("LoaderEntryLastBooted", "LoaderEntrySelected", "LoaderEntryDefault")
        )
        for variable in variables:
            entry_id = loader_entry_from_efi(variable)
            if entry_id is None:
                continue
            candidate = entries_dir / f"{entry_id}.conf"
            if candidate.is_file():
                entry_files = [candidate]
                explicit = True
                log.info("Using %s=%s as the default boot entry", variable, entry_id)
                break
        if not entry_files:
            if strict_default:
                die(
                    "loader.conf uses default %s but the systemd-boot "
                    "LoaderEntry* EFI variable is not readable; refusing to "
                    "guess the default boot entry. Set an explicit default in "
                    "loader.conf or make the EFI variables readable." % default
                )
            log.warning(
                "loader.conf uses default %s but the systemd-boot LoaderEntry* "
                "EFI variable is not readable; approximating the boot entry with "
                "the newest one",
                default,
            )
    if not entry_files:
        entry_files = sorted(entries_dir.glob("*.conf"))
    entry_files = [p for p in entry_files if p.is_file()]
    if not entry_files:
        die(f"no boot entries found in {entries_dir}")

    candidates: list[BootEntry] = []
    for path in entry_files:
        try:
            entry = parse_boot_entry(path, boot)
        except LuksuryError:
            if explicit and len(entry_files) == 1:
                raise
            continue
        if entry.is_uki:
            if explicit and len(entry_files) == 1:
                die(
                    f"the default boot entry {path} is a UKI; this tool supports "
                    "only classic linux+initrd entries"
                )
            continue
        candidates.append(entry)
    if not candidates:
        die(f"no classic linux+initrd boot entries found in {entries_dir}")

    # A wildcard default selects among multiple kernels.  Approximate
    # systemd-boot's ordering (sort-key, then version) with a natural sort.
    def natural_key(value: str) -> list[Any]:
        return [int(part) if part.isdigit() else part for part in re.split(r"(\d+)", value)]

    candidates.sort(
        key=lambda e: (natural_key(e.sort_key), natural_key(e.version), e.path.name),
        reverse=True,
    )
    entry = candidates[0]
    log.info("Using default boot entry: %s", entry.path)
    return entry


def find_entries_for_kernel(boot: BootPartition, version: str) -> list[BootEntry]:
    """Return all classic boot entries matching a kernel version."""
    if not version:
        return []
    entries_dir = boot.mount / "loader" / "entries"
    result: list[BootEntry] = []
    for path in sorted(entries_dir.glob("*.conf")):
        try:
            entry = parse_boot_entry(path, boot)
        except LuksuryError:
            continue
        if entry.is_uki:
            continue
        if entry.version == version or version in path.name:
            result.append(entry)
    return result


def find_entry_for_kernel(boot: BootPartition, version: str) -> Optional[BootEntry]:
    """Find the first classic boot entry matching a kernel version."""
    entries = find_entries_for_kernel(boot, version)
    return entries[0] if entries else None


def parse_boot_entry(path: Path, boot: BootPartition) -> BootEntry:
    title = path.stem
    version = ""
    sort_key = ""
    kernel: Optional[Path] = None
    initrds: list[Path] = []
    initrd_specs: list[str] = []
    options = ""
    is_uki = False

    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError as exc:
        die(f"cannot read boot entry {path}: {exc}")

    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        match = re.match(r"^(\S+)\s+(.*)$", line)
        if not match:
            continue
        key = match.group(1)
        value = match.group(2).strip()
        if key == "title":
            title = value
        elif key == "version":
            version = value
        elif key == "sort-key":
            sort_key = value
        elif key == "linux":
            kernel = _boot_path(boot.mount, value)
        elif key == "initrd":
            initrd_specs.append(value)
            initrds.append(_boot_path(boot.mount, value))
        elif key == "options":
            options = value
        elif key in ("efi", "uki"):
            is_uki = True

    if kernel is None and is_uki:
        die(
            f"{path} is a UKI entry; this tool supports only classic "
            "'linux'+'initrd' systemd-boot entries"
        )
    if kernel is None:
        die(f"{path} has no 'linux' line")
    if not initrds:
        # Fall back to the conventional Debian/Ubuntu path.
        candidate = Path("/boot") / f"initrd.img-{os.uname().release}"
        if candidate.exists():
            initrds = [candidate]

    return BootEntry(
        path=path,
        title=title,
        kernel=kernel,
        initrds=[p for p in initrds if p],
        options=options,
        version=version,
        sort_key=sort_key,
        initrd_specs=initrd_specs,
        is_uki=is_uki,
    )


def _boot_path(mount: Path, value: str) -> Path:
    # Boot loader spec paths are relative to the boot partition.  A leading
    # slash refers to that partition's root, not to the host's "/".
    value = value.strip().lstrip("/")
    return mount / value


def uefi_path(value: str) -> str:
    """Convert a boot-entry path to the UEFI/DOS form used in /proc/cmdline."""
    value = value.strip()
    if value.startswith("/"):
        value = value[1:]
    value = value.replace("/", "\\")
    return "\\" + value if not value.startswith("\\") else value


def _split_cmdline(text: str) -> list[str]:
    """Split a kernel command line the way systemd is likely to parse it.

    The kernel itself only splits on whitespace, but systemd and dracut also
    honour quoting and C-style escapes.  Using shlex here means a quoted
    ``"systemd.debug-shell=1"`` cannot sneak past the blocklist just because
    the raw token does not start with the forbidden prefix.
    """
    try:
        return shlex.split(text, comments=False, posix=True)
    except ValueError as exc:
        die(f"cannot parse the kernel command line {text!r}: {exc}")


def _strip_rd_prefix(token: str) -> str:
    """Return the token without dracut's ``rd.`` prefix, if present."""
    return token[3:] if token.startswith("rd.") else token


def cmdline_has_initrd(cmdline: str) -> bool:
    """Return whether the boot loader passed an initrd= token to the kernel."""
    return any(token.startswith("initrd=") for token in _split_cmdline(cmdline))


def cmdline_options(cmdline: str) -> list[str]:
    """Return cmdline tokens without the initrd=/BOOT_IMAGE= prefixes."""
    return [
        token
        for token in _split_cmdline(cmdline)
        if not token.startswith(("initrd=", "BOOT_IMAGE="))
    ]


def cmdline_compare_tokens(cmdline: str) -> list[str]:
    """Return effective tokens for a full running-cmdline comparison."""
    return [
        token
        for token in _split_cmdline(cmdline)
        if not token.startswith("BOOT_IMAGE=")
    ]


# Kernel command line options that grant a root/debug shell or weaken the
# measured-boot chain.  luksury refuses to lock these into the TPM policy.
CMDLINE_DENIED_EXACT = frozenset(
    {
        "lockdown=none",
        "module.sig_enforce=0",
        "module.sig_enforce=no",
        "selinux=0",
        "apparmor=0",
        "iommu=off",
        "nokaslr",
    }
)
CMDLINE_DENIED_PREFIXES = (
    "rd.break",
    "rd.shell",
    "rd.emergency",
    "systemd.debug-shell",
    "systemd.debug_shell",
    "systemd.unit=emergency",
    "systemd.unit=rescue",
    "systemd.unit=debug-shell",
    "systemd.wants=",
    "systemd.mask=",
    "systemd.setenv=",
    "systemd.sulogin=",
    "systemd.crash_shell",
    "systemd.crash_reboot",
    "systemd.default_standard_shell",
)
CMDLINE_ALLOWED_INIT = frozenset(
    {
        "/sbin/init",
        "/lib/systemd/systemd",
        "/usr/lib/systemd/systemd",
    }
)


def _denied_cmdline_token(token: str) -> Optional[str]:
    # Dracut strips a leading "rd." before handing options to systemd.  Check
    # both spellings so rd.systemd.wants=... cannot bypass systemd.wants=....
    candidates = [token]
    stripped = _strip_rd_prefix(token)
    if stripped != token:
        candidates.append(stripped)

    for candidate in candidates:
        if candidate in CMDLINE_DENIED_EXACT:
            return candidate
        for prefix in CMDLINE_DENIED_PREFIXES:
            if candidate.startswith(prefix):
                return candidate
        if candidate.startswith("init="):
            value = candidate.split("=", 1)[1]
            if value not in CMDLINE_ALLOWED_INIT:
                return candidate
    return None


def filter_cmdline(text: str) -> str:
    """Refuse to lock cmdline tokens that can yield a root/debug shell."""
    for token in _split_cmdline(text):
        denied = _denied_cmdline_token(token)
        if denied is not None:
            die(
                f"refusing to lock a kernel command line containing {denied!r}: "
                "this option can yield a root/debug shell or weaken verified boot. "
                "Remove it from the cmdline source (usually /etc/kernel/cmdline) "
                "and try again."
            )
    return text


def verify_running_cmdline(
    running: str, *, previous: str, target: str
) -> None:
    """Validate the running cmdline before it is locked as a pcrlock variant.

    A dangerous option in the running boot must never be promoted into the TPM
    policy.  When a previous verified cmdline exists, the whole running cmdline
    must match it (apart from BOOT_IMAGE=).  On a first setup, compare the
    effective options to the trusted target; the initrd= path may legitimately
    differ because the running initrd is the old one and the target initrd is
    the newly generated image.
    """
    filter_cmdline(running)
    if previous:
        previous_tokens = cmdline_compare_tokens(previous)
        running_tokens = cmdline_compare_tokens(running)
        if previous_tokens == running_tokens:
            return
        # A freshly installed target may already be running (for example after
        # a failed update rolled the policy back).  The new target was filtered
        # by trusted_cmdline(), so it is safe to accept it as well.
        if cmdline_compare_tokens(target) == running_tokens:
            log.warning(
                "the running kernel command line matches the new trusted target "
                "but not the previous one; accepting the target"
            )
            return
        die(
            "the running kernel command line does not match the last verified "
            "cmdline or the trusted target; refusing to lock it as a running "
            "variant. Reboot into the verified boot entry and try again."
        )
    if cmdline_options(running) != cmdline_options(target):
        die(
            "the running kernel command line does not match the trusted target "
            "cmdline; refusing to lock it as a running variant. Reboot into the "
            "normal boot entry (or pass a matching --cmdline) and try again."
        )


def read_running_cmdline() -> str:
    try:
        return Path("/proc/cmdline").read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return ""


def build_kernel_cmdline(
    entry: BootEntry,
    options: Optional[str] = None,
    *,
    include_initrd: bool = True,
) -> str:
    """Reconstruct the kernel cmdline.

    systemd-boot passes `initrd=<UEFI path>` before the configured options for
    kernels that do not use the LoadFile2 initrd protocol (and the kernel
    measures this full string into PCR 9).  Whether that prefix is present is
    decided by the running boot: if /proc/cmdline has no initrd= token, the
    loader is using LoadFile2 and the next boot will not have one either.
    """
    opts = entry.options if options is None else options
    parts: list[str] = []
    if include_initrd:
        for spec in entry.initrd_specs:
            parts.append(f"initrd={uefi_path(spec)}")
    if opts.strip():
        parts.append(opts.strip())
    return filter_cmdline(" ".join(parts))


def make_combined_initrd(paths: Sequence[Path], dry_run: bool = False) -> tuple[Path, bool]:
    """Return (path, temporary).  Multiple initrds are concatenated like systemd-boot."""
    paths = [Path(p) for p in paths]
    if not paths:
        die("no initrd found")
    for p in paths:
        if not p.exists():
            die(f"initrd not found: {p}")
    if len(paths) == 1:
        return paths[0], False

    fd, name = tempfile.mkstemp(prefix="luksury-initrd-", suffix=".img")
    tmp = Path(name)
    try:
        with os.fdopen(fd, "wb") as out:
            for p in paths:
                with p.open("rb") as src:
                    shutil.copyfileobj(src, out, length=1024 * 1024)
                pad = (-p.stat().st_size) % 4
                if pad:
                    out.write(b"\0" * pad)
        return tmp, True
    except Exception:
        tmp.unlink(missing_ok=True)
        raise


def write_temp_text(text: str, prefix: str = "luksury-cmdline-") -> Path:
    fd, name = tempfile.mkstemp(prefix=prefix)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
        if not text.endswith("\n"):
            f.write("\n")
    return Path(name)


def find_running_initrd(boot: BootPartition) -> tuple[Optional[Path], bool]:
    """Return (path, temporary) for the initrd used by the running kernel.

    This is deliberately looked up separately from the target boot entry: on
    updates the running kernel and the kernel being installed are usually not
    the same.  The returned image is combined in the same way systemd-boot
    combines multiple initrd= lines.
    """
    release = os.uname().release
    entry = find_entry_for_kernel(boot, release)
    if entry is not None and entry.initrds:
        try:
            return make_combined_initrd(entry.initrds)
        except LuksuryError as exc:
            log.debug("Cannot read the running boot entry's initrd: %s", exc)

    for candidate in (
        Path(f"/boot/initrd.img-{release}"),
        Path(f"/boot/initramfs-{release}.img"),
        Path(f"/boot/initramfs-{release}"),
    ):
        if candidate.exists():
            return candidate, False
    return None, False


def snapshot_file(path: Path, prefix: str = "luksury-running-initrd-") -> Path:
    """Copy a file that is about to be overwritten, so its measurement can be locked."""
    fd, name = tempfile.mkstemp(prefix=prefix, suffix=".img")
    tmp = Path(name)
    try:
        with os.fdopen(fd, "wb") as out, path.open("rb") as src:
            shutil.copyfileobj(src, out, length=1024 * 1024)
        return tmp
    except Exception:
        tmp.unlink(missing_ok=True)
        raise


def initrd_has_luksury_hook(image: Path) -> Optional[bool]:
    """Return whether an initrd contains the luksury hook, or None if unknown."""
    lsinitrd = which("lsinitrd", fallbacks=("/usr/bin/lsinitrd", "/usr/sbin/lsinitrd"))
    if not lsinitrd:
        return None
    if not image.exists():
        return False
    cp = run([lsinitrd, str(image)], capture=True, check=False, timeout=180)
    if cp.returncode != 0:
        return False
    if "luksury_pcrlock.sh" not in cp.stdout or "99-luksury.conf" not in cp.stdout:
        return False
    dropin = "usr/lib/systemd/system/systemd-cryptsetup@.service.d/99-luksury.conf"
    content = run([lsinitrd, "-f", dropin, str(image)], capture=True, check=False, timeout=60)
    if content.returncode != 0:
        return False
    return "ExecStartPre=" in content.stdout and "luksury_pcrlock.sh" in content.stdout


def parse_crypttab_line(line: str) -> tuple[list[str], str]:
    """Return (fields, trailing_comment).  Handles comments and quotes."""
    trailing = ""
    body = line
    if "#" in line:
        # Keep an inline comment only if it is not inside quotes; crypttab
        # does not really support inline comments, so this is best effort.
        body, _, comment = line.partition("#")
        trailing = "#" + comment
    try:
        fields = shlex.split(body, comments=False)
    except ValueError as exc:
        die(f"cannot parse /etc/crypttab line {line!r}: {exc}")
    return fields, trailing


def crypttab_matches(fields: Sequence[str], cfg: Config, dev: Path) -> bool:
    if len(fields) < 2:
        return False
    name, source = fields[0], fields[1]
    if cfg.luks_name and name == cfg.luks_name:
        return True
    if cfg.luks_uuid:
        if source in (
            f"UUID={cfg.luks_uuid}",
            f"/dev/disk/by-uuid/{cfg.luks_uuid}",
            f"/dev/disk/by-id/dm-uuid-CRYPT-LUKS2-{cfg.luks_uuid}",
        ):
            return True
    try:
        if Path(source).resolve() == dev.resolve():
            return True
    except OSError:
        pass
    return False


def set_crypttab_tpm(
    dev: Path,
    cfg: Config,
    *,
    remove: bool = False,
    path: Path = Path("/etc/crypttab"),
    dry_run: bool = False,
) -> None:
    path = Path(path)
    if not path.exists():
        die(f"{path} does not exist")
    backup_file(path, dry_run=dry_run)
    lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    out: list[str] = []
    found = False

    for raw in lines:
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            out.append(raw)
            continue
        fields, comment = parse_crypttab_line(raw)
        if not crypttab_matches(fields, cfg, dev):
            out.append(raw)
            continue

        found = True
        name, source = fields[0], fields[1]
        options = fields[3].split(",") if len(fields) >= 4 and fields[3] else []
        cleaned: list[str] = []
        for opt in options:
            key = opt.split("=", 1)[0]
            if key in ("keyscript", "keyfile-timeout", "tpm2-device", "tpm2-pcrs", "tpm2-pcrlock", "tpm2-signature"):
                continue
            if opt:
                cleaned.append(opt)
        if not remove:
            cleaned.append("tpm2-device=auto")
        # Deduplicate while preserving order.
        seen: set[str] = set()
        final_opts = [o for o in cleaned if not (o in seen or seen.add(o))]
        newline = f"{name} {source} none"
        if final_opts:
            newline += " " + ",".join(final_opts)
        if comment:
            newline += " " + comment
        out.append(newline)

    if not found:
        die(
            f"no /etc/crypttab entry matching {dev} ({cfg.luks_name or 'unknown mapper'}); "
            "refusing to guess"
        )

    text = "\n".join(out) + "\n"
    atomic_write(path, text, 0o644, dry_run)
    log.info(
        "%s %s for %s (%s)",
        "Would update" if dry_run else "Updated",
        path,
        dev,
        "removed TPM2 options" if remove else "tpm2-device=auto",
    )


