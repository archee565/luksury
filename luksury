@dataclasses.dataclass
class Config:
    mode: str = "pcrlock"  # pcrlock | literal
    pcrs: list[int] = dataclasses.field(default_factory=lambda: list(DEFAULT_PCRLOCK_PCRS))
    pcrlock_location: str = DEFAULT_PCRLOCK_LOCATION
    lock_gpt: bool = False
    boot_uuid: str = ""
    boot_fstype: str = ""
    boot_mount: str = ""
    boot_device: str = ""
    luks_device: str = ""
    luks_name: str = ""
    luks_uuid: str = ""
    initrd: str = ""
    cmdline: str = ""
    kernel_version: str = ""
    created_by: str = VERSION

    def to_json(self) -> str:
        return json.dumps(dataclasses.asdict(self), indent=2, sort_keys=True) + "\n"

    @classmethod
    def from_dict(cls, data: dict[str, Any]) -> "Config":
        known = {f.name for f in dataclasses.fields(cls)}
        return cls(**{k: v for k, v in data.items() if k in known})


def load_config(required: bool = False) -> Optional[Config]:
    if not CONFIG_FILE.exists():
        if required:
            die(f"{CONFIG_FILE} does not exist; run `{PROG} setup` first")
        return None
    try:
        data = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
        cfg = Config.from_dict(data)
        # 770 was the old default.  On classic systemd-boot, systemd 261's
        # 750-os-separator component is never measured, and because it touches
        # PCR 9 pcrlock would drop PCR 9 entirely.  Migrate to 740.
        if cfg.mode == "pcrlock" and cfg.pcrlock_location == "770":
            log.warning(
                "migrating pcrlock location from 770 to %s for classic systemd-boot",
                DEFAULT_PCRLOCK_LOCATION,
            )
            cfg.pcrlock_location = DEFAULT_PCRLOCK_LOCATION
        return cfg
    except (OSError, ValueError, TypeError) as exc:
        die(f"cannot read {CONFIG_FILE}: {exc}")


def save_config(cfg: Config, dry_run: bool = False) -> None:
    atomic_write(CONFIG_FILE, cfg.to_json(), 0o644, dry_run)
    # Keep a copy in /var/lib for status/update if /etc is reset.
    atomic_write(STATE_FILE, cfg.to_json(), 0o644, dry_run)


def parse_pcr_list(value: str) -> list[int]:
    parts = re.split(r"[,\s+]+", value.strip())
    result: list[int] = []
    for part in parts:
        if not part:
            continue
        try:
            idx = int(part)
        except ValueError:
            die(f"invalid PCR index: {part!r}")
        if not 0 <= idx <= 23:
            die(f"PCR index out of range: {idx}")
        if idx not in result:
            result.append(idx)
    if not result:
        die("empty PCR list")
    return result


